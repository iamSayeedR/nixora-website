
---
const groups = [
  {
    label: "Today",
    title: "Deploy & Diagnose",
    description:
      "Go from AI-generated code to a live, running application in seconds. Diagnose why an AI-generated deployment failed and what to change.",
    icon: "terminal",
  },
  {
    label: "Next",
    title: "Agent Access & MCP",
    description:
      "Agent-native deployment target via MCP server, multi-agent access with per-agent permissions and audit trail, web dashboard, and Fargate infrastructure.",
    icon: "users",
  },
  {
    label: "Later",
    title: "Monitoring & Observability",
    description:
      "Deep application understanding, continuous monitoring, and real-time observability for agent-built software.",
    icon: "chart",
  },
  {
    label: "Later",
    title: "Scaling & Optimization",
    description:
      "Autonomous scaling, auto-sleep, auto-retirement, and resource optimization as workloads grow.",
    icon: "zap",
  },
  {
    label: "Later",
    title: "Governance & Systems",
    description:
      "Multi-agent system deployment, AI agent lifecycle management, security policies, and governance.",
    icon: "shield",
  },
  {
    label: "Later",
    title: "Platform & Ecosystem",
    description:
      "Extensible platform integrations, marketplace, REST APIs, and no-code tools.",
    icon: "box",
  },
];
---

<section id="features" class="roadmap-section">
  <div class="roadmap-glow"></div>

  <div class="roadmap-container">
    <!-- Section heading -->
    <div class="roadmap-intro" data-reveal>
      <h2 class="section-headline">
        Where Nixora is <span class="accent">going.</span>
      </h2>

      <p class="roadmap-description">
        Today, Nixora deploys AI-generated apps and diagnoses why they fail.
        Next, it becomes a deployment target your AI agents call directly
        through an MCP server. Later, we're building toward infrastructure
        that understands, monitors, and adapts as your applications grow.
      </p>
    </div>

    <!-- Roadmap cards -->
    <div class="detailed-cards-grid">
      {groups.map((item, index) => (
        <article
          class:list={[
            "hero-card",
            index === 0 && "hero-card-live",
            index === 1 && "hero-card-next",
          ]}
          data-reveal
          style={`--card-index: ${index % 3};`}
        >
          <div class="card-top">
            <span
              class:list={[
                "status-badge",
                item.label === "Later" && "status-badge-later",
              ]}
            >
              {item.label !== "Later" && <span class="pulse-dot"></span>}
              {item.label}
            </span>

            <span class="roadmap-icon" aria-hidden="true">
              {item.icon === "terminal" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 17 10 11 4 5" />
                  <line x1="12" y1="19" x2="20" y2="19" />
                </svg>
              )}

              {item.icon === "users" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="10" cy="7" r="4" />
                  <path d="M20 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              )}

              {item.icon === "chart" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                  <polyline points="16 7 22 7 22 13" />
                </svg>
              )}

              {item.icon === "zap" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
              )}

              {item.icon === "shield" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <polyline points="9 12 11 14 15 10" />
                </svg>
              )}

              {item.icon === "box" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73z" />
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                  <line x1="12" y1="22.08" x2="12" y2="12" />
                </svg>
              )}
            </span>
          </div>

          <div class="card-text">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Product architecture link -->
    <div class="roadmap-cta" data-reveal>
      <a href="/product/" class="arch-product-link">
        <span>View Full Product Architecture</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Section */
  .roadmap-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 2rem 1.25rem 4rem; 
  }

  .roadmap-glow {
    position: absolute;
    top: -40px;
    left: 50%;
    z-index: -1;
    width: 100%;
    max-width: 700px;
    height: 140px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse 55% 40% at 50% 0%,
      rgb(125 87 239 / 10%),
      transparent 70%
    );
    pointer-events: none;
  }

  .roadmap-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    width: 100%;
    max-width: 1150px;
    margin: 0 auto;
  }

  /* Heading */
  .roadmap-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .section-headline {
    margin: 0;
    color: #fff;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .section-headline .accent {
    color: var(--primary, #a78bfa);
  }

  .roadmap-description {
    max-width: 42rem;
    margin: 0 auto;
    color: rgb(255 255 255 / 65%);
    font-size: 1rem;
    line-height: 1.75;
  }

  /* Responsive grid */
  .detailed-cards-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
    gap: 1rem;
    width: 100%;
  }

  /* Cards */
  .hero-card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 1rem;
    background: #0d0d0f;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

.hero-card-live {
  border-color: rgba(167, 139, 250, 0.40);
  box-shadow: 0 0 16px rgba(125, 87, 239, 0.04);
}

.hero-card-next {
  border-color: rgba(167, 139, 250, 0.40);
}

.hero-card:hover {
  transform: translateY(-2px);
 border-color: rgba(167, 139, 250, 0.50);
  box-shadow: 0 4px 12px rgba(167, 139, 250, 0.04);
}

  /* Status */
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 26px;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgb(167 139 250 / 35%);
    border-radius: 999px;
    background: rgb(167 139 250 / 12%);
    color: var(--primary, #a78bfa);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status-badge-later {
    border-color: rgb(255 255 255 / 10%);
    background: rgb(255 255 255 / 4%);
    color: rgb(255 255 255 / 55%);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--primary, #a78bfa);
    box-shadow: 0 0 8px rgb(167 139 250 / 80%);
    animation: dotPulse 2s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  /* Icon */
  .roadmap-icon {
    display: flex;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(125 87 239 / 25%);
    border-radius: 1rem;
    background: rgb(125 87 239 / 8%);
    color: var(--primary, #a78bfa);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .hero-card-live .roadmap-icon,
  .hero-card-next .roadmap-icon {
    border-color: rgb(125 87 239 / 40%);
    background: rgb(125 87 239 / 14%);
  }

  .roadmap-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .hero-card:hover .roadmap-icon {
    border-color: rgb(125 87 239 / 50%);
    background: rgb(125 87 239 / 16%);
  }

  /* Card content */
  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .card-text h3 {
    margin: 0;
    color: #fff;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
    transition: color 0.3s ease;
  }

  .hero-card:hover .card-text h3 {
    color: var(--primary, #a78bfa);
  }

  .card-text p {
    margin: 0;
    color: rgb(255 255 255 / 65%);
    font-size: 0.9375rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  /* Architecture link */
  .roadmap-cta {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
    text-align: center;
  }

  .arch-product-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    max-width: 100%;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 4%);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  .arch-product-link:hover {
    background: rgb(125 87 239 / 10%);
    color: var(--primary, #a78bfa);
  }

  .arch-product-link svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .arch-product-link:hover svg {
    transform: translateX(3px);
  }

  /* Scroll reveal */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.65s ease,
      transform 0.65s ease;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .detailed-cards-grid [data-reveal] {
    transition-delay: calc(var(--card-index, 0) * 80ms);
  }

  /* Tablet */
  @media (min-width: 640px) {
    .roadmap-section {
      padding: 2.5rem 2rem 5rem;
    }

    .roadmap-container {
      gap: 3rem;
    }

    .section-headline {
      font-size: 2.25rem;
    }

    .roadmap-description {
      font-size: 1.0625rem;
      line-height: 2rem;
    }

    .detailed-cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .hero-card {
      padding: 1.5rem;
    }

    .status-badge {
      font-size: 0.75rem;
    }

    .roadmap-icon {
      width: 3.5rem;
      height: 3.5rem;
    }

    .roadmap-icon svg {
      width: 1.75rem;
      height: 1.75rem;
    }

    .card-text h3 {
      font-size: 1.375rem;
    }

    .card-text p {
      font-size: 1rem;
      line-height: 1.8;
    }

    .arch-product-link {
      font-size: 1rem;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .roadmap-section {
      padding: 3rem 2rem 6rem;
    }

    .roadmap-container {
      gap: 3.5rem;
    }

    .section-headline {
      font-size: 3rem;
    }

    .detailed-cards-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .hero-card {
      min-height: 260px;
      padding: 1.5rem;
    }

    .card-text h3 {
      font-size: 1.25rem;
    }

    .card-text p {
      font-size: 0.9375rem;
      line-height: 1.75;
    }
  }

  /* Large desktop */
  @media (min-width: 1280px) {
    .roadmap-section {
      padding-right: 3rem;
      padding-left: 3rem;
    }

    .hero-card {
      padding: 1.75rem;
    }

    .card-text h3 {
      font-size: 1.35rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .hero-card,
    .roadmap-icon,
    .arch-product-link,
    .arch-product-link svg {
      transition: none;
    }

    .pulse-dot {
      animation: none;
    }
  }
</style>

<script>
  const roadmapRevealElements =
    document.querySelectorAll("#features [data-reveal]");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (prefersReducedMotion || !("IntersectionObserver" in window)) {
    roadmapRevealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  } else {
    const roadmapObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
      }
    );

    roadmapRevealElements.forEach((element) => {
      roadmapObserver.observe(element);
    });
  }
</script>
