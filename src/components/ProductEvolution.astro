---
const stages = [
  {
    label: "STAGE 1",
    title: "Deployment",
    description:
      "Provide a reliable way to deploy applications and diagnose deployment failures.",
    icon: "terminal",
  },
  {
    label: "STAGE 2",
    title: "Lifecycle Management",
    description:
      "Expand into testing, monitoring, troubleshooting, releases, and ongoing operations.",
    icon: "activity",
  },
  {
    label: "STAGE 3",
    title: "Infrastructure Control Plane",
    description:
      "Coordinate applications, agents, permissions, and operational workflows across supported infrastructure.",
    icon: "network",
  },
  {
    label: "STAGE 4",
    title: "Autonomous Operations",
    description:
      "Enable AI systems to perform authorized operational tasks, verify outcomes, and manage software with less manual intervention.",
    icon: "loop",
  },
];
---

<section class="difference-section">
  <!-- Background tint -->
  <div class="difference-background" aria-hidden="true"></div>

  <div class="difference-container">

    <!-- Header -->
    <div class="difference-intro">
      <p class="eyebrow">OUR DIFFERENCE</p>

      <h2>
        From deployment to <br />
        autonomous operations.
      </h2>

      <p class="intro-description">
        Nixora's long-term ambition is to move beyond deployment and
        become an operational control layer for software created by humans
        and AI agents.
      </p>

      <p class="intro-caption">The strategy has four stages.</p>
    </div>

    <!-- Stages -->
    <div class="stages-grid">
      {stages.map((stage) => (
        <article class="stage-card">
          <!-- Subtle top accent -->
          <div class="stage-top-accent"></div>

          <!-- Icon and stage label -->
          <div class="stage-header">
            <div class="stage-icon">

              {stage.icon === "terminal" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="4 17 10 11 4 5" />
                  <line x1="12" y1="19" x2="20" y2="19" />
                </svg>
              )}

              {stage.icon === "activity" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
                </svg>
              )}

              {stage.icon === "network" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="16" y="16" width="6" height="6" rx="1" />
                  <rect x="2" y="16" width="6" height="6" rx="1" />
                  <rect x="9" y="2" width="6" height="6" rx="1" />
                  <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3" />
                  <path d="M12 12V8" />
                </svg>
              )}

              {stage.icon === "loop" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 12a8 8 0 0 1-13.66 5.66" />
                  <path d="M4 12a8 8 0 0 1 13.66-5.66" />
                  <path d="M18 3v4h-4" />
                  <path d="M6 21v-4h4" />
                  <path d="m9.5 12 2 2 3.5-4" />
                </svg>
              )}

            </div>

            <p class="stage-label">{stage.label}</p>
          </div>

          <!-- Title -->
          <h3>{stage.title}</h3>

          <!-- Description -->
          <p class="stage-description">{stage.description}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .difference-section {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 96px 0;
  }

  .difference-container {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    box-sizing: border-box;
  }

  /* Header */

  .difference-intro {
    width: 100%;
    max-width: 768px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: #a78bfa;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .difference-intro h2 {
    margin: 0;
    color: var(--foreground, #fff);
    font-size: 44px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .intro-description {
    max-width: 672px;
    margin: 20px auto 0;
    color: var(--muted-foreground, rgba(255, 255, 255, 0.55));
    font-size: 15px;
    line-height: 1.85;
  }

  .intro-caption {
    margin: 16px 0 0;
    color: var(--muted-foreground, rgba(255, 255, 255, 0.55));
    font-size: 14px;
  }

  /* Stage cards */

  .stages-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .stage-card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.025);
  }

  .stage-card:hover .stage-top-accent {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(167, 139, 250, 0.4),
      transparent
    );
  }

  .stage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 36px;
  }

  .stage-icon {
    display: flex;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
    color: rgba(255, 255, 255, 0.82);
    transition: border-color 220ms ease;
  }

  .stage-icon svg {
    display: block;
    width: 21px;
    height: 21px;
  }

  .stage-label {
    flex-shrink: 0;
    margin: 0;
    color: rgba(167, 139, 250, 0.8);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .stage-card h3 {
    margin: 0;
    min-height: 52px;
    color: var(--foreground, #fff);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .stage-description {
    flex: 1;
    margin: 12px 0 0;
    color: var(--muted-foreground, rgba(255, 255, 255, 0.55));
    font-size: 13px;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  /* Tablet */

  @media (max-width: 1024px) {
    .difference-container {
      padding: 0 32px;
    }

    .stages-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .stage-header {
      margin-bottom: 28px;
    }

    .stage-card h3 {
      min-height: auto;
    }
  }

  /* Mobile */

  @media (max-width: 600px) {
    .difference-section {
      padding: 64px 0;
    }

    .difference-container {
      padding: 0 20px;
    }

    .difference-intro {
      margin-bottom: 40px;
    }

    .eyebrow {
      margin-bottom: 12px;
      font-size: 10px;
    }

    .difference-intro h2 {
      font-size: clamp(27px, 7vw, 32px);
      line-height: 1.2;
    }

    .intro-description {
      margin-top: 16px;
      font-size: 13px;
      line-height: 1.8;
    }

    .intro-caption {
      margin-top: 12px;
      font-size: 12px;
    }

    .stages-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .stage-card {
      padding: 22px;
    }

    .stage-header {
      margin-bottom: 24px;
    }

    .stage-icon {
      width: 40px;
      height: 40px;
    }

    .stage-card h3 {
      font-size: 16px;
      line-height: 1.5;
    }

    .stage-description {
      margin-top: 10px;
      font-size: 12px;
      line-height: 1.85;
    }
  }

  @media (max-width: 380px) {
    .difference-container {
      padding: 0 16px;
    }

    .stage-card {
      padding: 20px;
    }
  }

  /* Reduced motion */

  @media (prefers-reduced-motion: reduce) {
    .stage-card,
    .stage-icon,
    .stage-top-accent {
      transition: none;
    }
  }
</style>