---
// src/components/FinalCTA.astro
// Reusable high-impact closing conversion card with scroll reveal
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tell us what you're building.",
  description = "Our team reads every signup. We work directly with developers and founders to configure runtime infrastructure for modern AI software and autonomous agent workflows.",
} = Astro.props;
---

<section class="product-final-cta">
  <div class="final-cta-container">
    <div class="final-cta-card" data-reveal>
      <!-- Ambient purple light inside the card -->
      <div class="card-glow" aria-hidden="true"></div>

      <h2 class="final-cta-title">
        {title}
      </h2>

      <p class="final-cta-description">
        {description}
      </p>

      <div class="final-cta-actions">
        <a href="/#early-access" class="shiny-cta primary-spot-btn">
          <span>Save My Spot</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>

        <a
          href="https://calendly.com/ceo-nixora/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="secondary-talk-btn"
          data-calendly
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span>Talk To Us</span>
        </a>
      </div>

      <!-- Trust & onboarding perks strip -->
      <div class="cta-perks-strip">
        <div class="perk-item">
          <span class="perk-check">✓</span>
          <span>Direct Slack with founders</span>
        </div>
        <div class="perk-item">
          <span class="perk-check">✓</span>
          <span>Free during early access</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .product-final-cta {
    position: relative;
    padding: 3rem 1.5rem 6rem;
    overflow: hidden;
  }

  .final-cta-container {
    max-width: 820px;
    margin: 0 auto;
    position: relative;
  }

  .final-cta-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3.5rem 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(20, 20, 26, 0.8) 0%, rgba(10, 10, 14, 0.95) 100%);
    backdrop-filter: blur(16px);
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .card-glow {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 480px;
    height: 240px;
    background: radial-gradient(circle, rgba(167, 139, 250, 0.22) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .final-cta-title {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #fff;
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .final-cta-description {
    position: relative;
    z-index: 1;
    max-width: 520px;
    margin: 1rem auto 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .final-cta-actions {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .primary-spot-btn {
    min-height: 48px;
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    gap: 0.5rem;
  }

  .primary-spot-btn svg {
    width: 16px;
    height: 16px;
    transition: transform 200ms ease;
  }

  .primary-spot-btn:hover svg {
    transform: translateX(3px);
  }

  .secondary-talk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.75rem 1.65rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    color: #e4e4e7;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 200ms ease;
  }

  .secondary-talk-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(167, 139, 250, 0.4);
    color: #fff;
    transform: translateY(-1px);
  }

  .secondary-talk-btn svg {
    width: 16px;
    height: 16px;
    color: #a78bfa;
  }

  .cta-perks-strip {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
    width: 100%;
  }

  .perk-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8125rem;
  }

  .perk-check {
    color: #a78bfa;
    font-weight: 700;
    font-size: 0.75rem;
  }

  /* Scroll reveal animation */
  .final-cta-card[data-reveal] {
    opacity: 0;
    transform: translate3d(0, 42px, 0);
    transition:
      opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .final-cta-card[data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* Staggered entry for card inner elements */
  .final-cta-card[data-reveal] .card-badge,
  .final-cta-card[data-reveal] .final-cta-title,
  .final-cta-card[data-reveal] .final-cta-description,
  .final-cta-card[data-reveal] .final-cta-actions,
  .final-cta-card[data-reveal] .cta-perks-strip {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .final-cta-card[data-reveal].is-visible .card-badge {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: 0ms;
  }

  .final-cta-card[data-reveal].is-visible .final-cta-title {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: 40ms;
  }

  .final-cta-card[data-reveal].is-visible .final-cta-description {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: 80ms;
  }

  .final-cta-card[data-reveal].is-visible .final-cta-actions {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: 120ms;
  }

  .final-cta-card[data-reveal].is-visible .cta-perks-strip {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: 160ms;
  }

  @media (max-width: 640px) {
    .final-cta-card {
      padding: 2.5rem 1.25rem;
    }

    .final-cta-actions {
      flex-direction: column;
      gap: 0.75rem;
    }

    .primary-spot-btn,
    .secondary-talk-btn {
      width: 100%;
    }

    .cta-perks-strip {
      flex-direction: column;
      gap: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .final-cta-card[data-reveal],
    .final-cta-card[data-reveal] .card-badge,
    .final-cta-card[data-reveal] .final-cta-title,
    .final-cta-card[data-reveal] .final-cta-description,
    .final-cta-card[data-reveal] .final-cta-actions,
    .final-cta-card[data-reveal] .cta-perks-strip {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function setupFinalCtaReveal() {
    const cards = document.querySelectorAll('.final-cta-card[data-reveal]');
    if (!cards.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      cards.forEach(c => c.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.05,
      rootMargin: '0px 0px 60px 0px'
    });

    cards.forEach(c => observer.observe(c));
  }

  setupFinalCtaReveal();
  document.addEventListener('astro:page-load', setupFinalCtaReveal);
</script>
