---
---
<footer style="padding:4rem 2rem 2.5rem;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:3rem;">

  <!-- Top row: Logo + Social + Grouped Columns -->
  <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem;align-items:start;" class="footer-grid">
    
    <!-- Left Column: Logo & Social -->
    <div style="display:flex;flex-direction:column;gap:1.25rem;">
      <a href="/" aria-label="Nixora Home" style="display:flex;align-items:center;text-decoration:none;">
        <img src="/logo.svg" alt="Nixora" style="height:26px;width:auto;" />
      </a>
      
      <div style="display:flex;align-items:center;gap:1.25rem;font-size:0.85rem;flex-wrap:wrap;">
        <a href="https://x.com/wearenixora" target="_blank" rel="noopener noreferrer"
           style="color:#a1a1aa;text-decoration:none;transition:color 0.2s;display:flex;align-items:center;gap:0.4rem;"
           onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X (Twitter) ↗
        </a>
        <a href="https://www.linkedin.com/company/nixora-hq/" target="_blank" rel="noopener noreferrer"
           style="color:#a1a1aa;text-decoration:none;transition:color 0.2s;display:flex;align-items:center;gap:0.4rem;"
           onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          LinkedIn ↗
        </a>
      </div>
    </div>

    <!-- Column 1: Company & Resources -->
    <div style="display:flex;flex-direction:column;gap:0.85rem;">
      <div style="font-size:0.75rem;color:#fff;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;">Platform & Company</div>
      <a href="/product" style="font-size:0.875rem;color:#a1a1aa;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">Product</a>
      <a href="/resources" style="font-size:0.875rem;color:#a1a1aa;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">Resources</a>
      <a href="/compare" style="font-size:0.875rem;color:#a1a1aa;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">Compare</a>
      <a href="/traction" style="font-size:0.875rem;color:#a1a1aa;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">Traction</a>
      <a href="/about" style="font-size:0.875rem;color:#a1a1aa;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">About</a>
    </div>

    <!-- Column 2: Legal -->
    <div style="display:flex;flex-direction:column;gap:0.85rem;">
      <div style="font-size:0.75rem;color:#fff;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;">Legal</div>
      <a href="/terms" style="font-size:0.875rem;color:#a1a1aa;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">Terms of Service</a>
      <a href="/privacy" style="font-size:0.875rem;color:#a1a1aa;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">Privacy Policy</a>
    </div>

  </div>

  <!-- Bottom Bar: SAFE notice & Copyright -->
  <div style="padding-top:2rem;border-top:1px solid #1f1f1f;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;font-size:0.8rem;color:#52525b;">
    <p style="margin:0;">
      Nixora is currently raising a pre-seed round via SAFE.&nbsp;
      <a href="mailto:ceo@nixora.co.in?subject=Nixora%20SAFE%20Investment%20Inquiry"
         style="color:#a1a1aa;text-decoration:underline;transition:color 0.2s;"
         onmouseover="this.style.color='#a78bfa'" onmouseout="this.style.color='#a1a1aa'">
        Get in touch
      </a> for details.
    </p>
    <p style="margin:0;color:#52525b;">© {new Date().getFullYear()} Nixora</p>
  </div>

</footer>

<style>
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
  }
</style>
