---
---
<section id="early-access" style="padding:5rem 2rem;text-align:center;">
  <div style="max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:2rem;align-items:center;">

    <div style="display:flex;flex-direction:column;gap:0.75rem;align-items:center;">
      <!-- Social Proof Waitlist Counter Badge -->
      <div style="display:inline-flex;align-items:center;gap:0.55rem;padding:0.3rem 0.85rem;border-radius:9999px;border:1px solid rgba(167,139,250,0.3);background:rgba(167,139,250,0.08);font-size:0.8125rem;color:#a78bfa;font-weight:600;font-family:'Fira Code',monospace;">
        <span style="width:7px;height:7px;border-radius:50%;background:#a78bfa;box-shadow:0 0 8px #a78bfa;"></span>
        100+ developers signed up for early access
      </div>

      <h2 class="section-headline">Get early access</h2>
      <p class="section-para">Be among the first to experience Nixora. Join the early access list and we'll reach out when your access is ready.</p>
    </div>

    <!-- Form card -->
    <div style="width:100%;border:1px solid #1f1f1f;border-radius:10px;background:#0a0a0a;padding:2rem;text-align:left;position:relative;overflow:hidden;">

      <!-- Success state -->
      <div id="form-success" style="display:none;position:absolute;inset:0;background:#0a0a0a;border-radius:10px;align-items:center;justify-content:center;flex-direction:column;gap:0.85rem;text-align:center;padding:2rem;z-index:5;">
        <div style="width:48px;height:48px;border-radius:50%;border:1px solid rgba(167,139,250,0.4);background:rgba(167,139,250,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto;box-shadow:0 0 20px rgba(139,92,246,0.2);">
          <span style="font-size:1.3rem;">🎉</span>
        </div>
        <h3 style="color:#fff;font-weight:700;font-size:1.25rem;margin:0;">You're on the list!</h3>
        <p style="color:#a1a1aa;font-size:0.9375rem;line-height:1.6;margin:0;max-width:400px;">
          Thanks for signing up for Nixora Early Access. We'll reach out personally when your spot is ready. See you inside!
        </p>
      </div>

      <!-- Lead capture form with live Formspree endpoint -->
      <form id="waitlist-form" action="https://formspree.io/f/xaewzzdw" method="POST" style="display:flex;flex-direction:column;gap:1.25rem;">
        <div style="display:flex;flex-direction:column;gap:0.4rem;">
          <label for="name" style="font-size:0.8rem;color:#71717a;font-weight:500;">Your name</label>
          <input type="text" name="name" id="name" required placeholder="Sayeed Rizwan"
            style="background:#111;border:1px solid #2a2a2a;border-radius:6px;padding:0.65rem 0.9rem;color:#fff;font-size:0.9rem;outline:none;transition:border-color 0.2s;width:100%;"
            onfocus="this.style.borderColor='rgba(167,139,250,0.5)'" onblur="this.style.borderColor='#2a2a2a'"/>
        </div>
        <div style="display:flex;flex-direction:column;gap:0.4rem;">
          <label for="email" style="font-size:0.8rem;color:#71717a;font-weight:500;">Email address</label>
          <input type="email" name="email" id="email" required placeholder="you@domain.com"
            style="background:#111;border:1px solid #2a2a2a;border-radius:6px;padding:0.65rem 0.9rem;color:#fff;font-size:0.9rem;outline:none;transition:border-color 0.2s;width:100%;"
            onfocus="this.style.borderColor='rgba(167,139,250,0.5)'" onblur="this.style.borderColor='#2a2a2a'"/>
        </div>
        <div style="display:flex;justify-content:center;width:100%;margin-top:0.4rem;">
          <button type="submit" class="shiny-cta" id="submit-btn">
            Get early access
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:14px;height:14px;">
              <path d="M15.187 11.2362L11.0895 7.13873L12.1696 6.05859L18.1111 12.0001L12.1696 17.9416L11.0895 16.8615L15.187 12.764H5.88892V11.2362H15.187Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const success = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    const istTime = new Date().toLocaleString('en-IN', {
      timeZone: 'Asia/Kolkata',
      dateStyle: 'medium',
      timeStyle: 'short'
    }) + ' IST';
    data.append('IST_time', istTime);

    if (submitBtn) submitBtn.setAttribute('disabled', 'true');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok && success) {
        success.style.display = 'flex';
      } else {
        alert('Submission error: please email ceo@nixora.co.in directly.');
        if (submitBtn) submitBtn.removeAttribute('disabled');
      }
    } catch (err) {
      alert('Network error. Please check your connection or email ceo@nixora.co.in.');
      if (submitBtn) submitBtn.removeAttribute('disabled');
    }
  });
</script>
