---
---
<hr class="separator" />
<section id="how-it-works" style="padding:5rem 2rem;position:relative;overflow:hidden;">
  <!-- Section Heading Wash Glow -->
  <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:800px;height:240px;background:radial-gradient(ellipse 70% 50% at 50% 0%,rgba(139,92,246,0.14),transparent 70%);pointer-events:none;z-index:0;"></div>

  <div style="max-width:900px;margin:0 auto;position:relative;z-index:1;">
    <div style="text-align:center;margin-bottom:3.5rem;">
      <h2 class="section-headline">From AI output to <span class="accent">live production</span> in seconds</h2>
      <p class="section-para" style="margin:1rem auto 0;">Nixora bridges raw LLM-generated code with robust cloud operations automatically.</p>
    </div>

    <!-- Workflow Step Cards Grid with Elevation -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.25rem;">
      {[
        { step:"01", title:"Install the CLI", desc:"Install the lightweight Nixora agent globally to orchestrate all your builds.", cmd:"npm install -g nixora-cli" },
        { step:"02", title:"Initialize project", desc:"Run init inside your generated code directory. Nixora auto-detects environment requirements.", cmd:"nixora init" },
        { step:"03", title:"Deploy & manage", desc:"Ship to our managed control plane. Auto-scaling, health checks, and self-healing built in.", cmd:"nixora deploy" },
      ].map(s => (
        <div class="workflow-card">
          <span style="font-size:0.75rem;color:#a78bfa;font-weight:700;letter-spacing:0.08em;">{s.step}</span>
          <h4 style="color:#fff;font-size:1.0625rem;font-weight:600;margin:0;">{s.title}</h4>
          <p style="color:#71717a;font-size:0.875rem;line-height:1.6;margin:0;flex:1;">{s.desc}</p>
          <code style="background:#0a0a0a;border:1px solid #222;border-radius:5px;padding:0.4rem 0.75rem;font-size:0.8rem;color:#a1a1aa;font-family:'Fira Code',monospace;">{s.cmd}</code>
        </div>
      ))}
    </div>

  </div>
</section>
<hr class="separator" />

<style>
  .workflow-card {
    background: #0a0a0a;
    border: 1px solid #1f1f1f;
    border-radius: 12px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 15px rgba(139, 92, 246, 0.04);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .workflow-card:hover {
    transform: translateY(-2px);
    border-color: rgba(167, 139, 250, 0.35);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(139, 92, 246, 0.1);
  }
</style>
