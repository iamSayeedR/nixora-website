---
---

<section class="product-journey">
  <div class="journey-background" aria-hidden="true"></div>

  <div class="journey-container">

    <!-- Heading -->
    <div class="journey-heading">
      <div class="journey-badge-wrapper">
        <a href="/#early-access" class="journey-badge-link">
          Skip the Dockerfile. Get early access <span aria-hidden="true">→</span>
        </a>
      </div>

      <h2>
        Building software
        <br class="desktop-break" /> is only the beginning.
      </h2>

      <p>
        AI makes creating software faster. But getting that software into
        production and keeping it running requires an operational
        foundation.
      </p>
    </div>

    <!-- Creation to operations -->
    <div class="journey-grid">

      <!-- Connecting line -->
      <div class="journey-connector" aria-hidden="true"></div>

      <!-- Software creation -->
      <div class="journey-card creation-card">
        <div class="card-gradient" aria-hidden="true"></div>

        <div class="card-content">
          <div class="card-top">
            <div class="card-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 14.5 9.5 3l1.5 7h9l-5.5 11-1.5-7z"/>
              </svg>
            </div>

            <span class="card-label">CREATE</span>
          </div>

          <p class="card-category">Software creation</p>

          <h3>AI builds the software.</h3>

          <p class="card-description">
            AI coding tools turn ideas into applications, generating code
            and working software faster than ever.
          </p>
        </div>
      </div>

      <!-- Software operations -->
      <div class="journey-card operations-card">
        <div class="card-gradient" aria-hidden="true"></div>

        <div class="card-content">
          <div class="card-top">
            <div class="card-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m12 2 9 5-9 5-9-5 9-5Z"/>
                <path d="m3 12 9 5 9-5"/>
                <path d="m3 17 9 5 9-5"/>
              </svg>
            </div>

            <span class="card-label">OPERATE</span>
          </div>

          <p class="card-category">Software operations</p>

          <h3>Nixora handles the infrastructure.</h3>

          <p class="card-description">
            Nixora provides the infrastructure layer to deploy applications,
            diagnose failures, and support their ongoing operations through
            a unified control plane.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Section */

  .product-journey {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 4rem 0;
  }

  .journey-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Heading */

  .journey-heading {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
  }

  .journey-badge-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .journey-badge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.95rem;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 9999px;
    background: rgba(167, 139, 250, 0.06);
    color: #c4b5fd;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .journey-badge-link:hover {
    background: rgba(167, 139, 250, 0.14);
    border-color: rgba(167, 139, 250, 0.45);
    color: #fff;
  }

  .journey-heading h2 {
    margin: 0;
    color: #fff;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.04em;
  }

  .journey-heading p {
    max-width: 42rem;
    margin: 1.25rem auto 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  /* Cards Grid */

  .journey-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: none;
    margin: 2.5rem auto 0;
  }

  .journey-connector {
    display: none;
  }

  /* Cards */

  .journey-card {
    position: relative;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 1rem;
    background: rgba(13, 13, 15, 0.9);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .creation-card {
    background: rgba(15, 15, 18, 0.9);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .creation-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
  }

  .operations-card {
    border-color: rgba(125, 87, 239, 0.22);
    background: linear-gradient(
      180deg,
      rgba(125, 87, 239, 0.06),
      rgba(13, 13, 15, 0.94)
    );
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .operations-card:hover {
    border-color: rgba(125, 87, 239, 0.36);
  }

  .card-gradient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom right,
      rgba(255, 255, 255, 0.03),
      transparent 72%
    );
  }

  .operations-card .card-gradient {
    background: linear-gradient(
      to bottom right,
      rgba(125, 87, 239, 0.08),
      transparent 68%
    );
  }

  .card-content {
    position: relative;
    z-index: 1;
  }

  /* Card Top */

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-icon {
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.8);
    flex-shrink: 0;
  }

  .operations-card .card-icon {
    border-color: rgba(125, 87, 239, 0.26);
    background: rgba(125, 87, 239, 0.1);
    color: #b9a2ff;
  }

  .card-label {
    color: rgba(255, 255, 255, 0.35);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .operations-card .card-label {
    color: rgba(185, 162, 255, 0.68);
  }

  /* Card Text */

  .card-category {
    margin: 1.75rem 0 0;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .operations-card .card-category {
    color: rgba(185, 162, 255, 0.78);
  }

  .card-content h3 {
    margin: 0.5rem 0 0;
    color: #fff;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .card-description {
    max-width: 24rem;
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .operations-card .card-description {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Tablet */

  @media (min-width: 640px) {
    .journey-container {
      padding: 0 2rem;
    }

    .journey-heading h2 {
      font-size: 2.25rem;
    }

    .journey-heading p {
      font-size: 1rem;
    }

    .journey-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
      margin-top: 3.5rem;
      align-items: stretch;
    }

    .journey-card {
      padding: 1.75rem;
    }

    .operations-card {
      transform: translateY(0.25rem);
    }

    .card-content h3 {
      font-size: 1.5rem;
    }

    .journey-connector {
      position: absolute;
      top: 50%;
      left: 50%;
      display: block;
      width: 1.5rem;
      height: 1px;
      transform: translate(-50%, -50%);
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0.08),
        rgba(125, 87, 239, 0.7),
        rgba(255, 255, 255, 0.08)
      );
      z-index: 2;
    }
  }

  /* Desktop */

  @media (min-width: 1024px) {
    .product-journey {
      padding: 6rem 0;
    }

    .journey-container {
      padding: 0 3rem;
    }

    .journey-heading h2 {
      font-size: 3rem;
    }

    .journey-grid {
      margin-top: 3.5rem;
      gap: 1.5rem;
    }

    .journey-card {
      padding: 2rem;
    }

    .operations-card {
      transform: translateY(0.5rem);
    }
  }

  /* Smaller Screens */

  @media (max-width: 639px) {
    .product-journey {
      padding: 4rem 0;
    }

    .journey-container {
      padding: 0 1.25rem;
    }

    .journey-grid {
      margin-top: 2.5rem;
    }

    .journey-card {
      padding: 1.5rem;
    }

    .operations-card {
      transform: none;
    }

    .card-content h3 {
      font-size: 1.25rem;
    }
  }

  /* Reduced Motion */

  @media (prefers-reduced-motion: reduce) {
    .journey-card {
      transition: none;
    }
  }
</style>