---

<section class="product-journey">
  <!-- Uniform purple-tinted background -->
  <div class="journey-background" aria-hidden="true"></div>

  <div class="journey-container">

    <!-- Heading -->
    <div class="journey-heading reveal">
      <h2>
        Building software
        <br class="desktop-break" /> is only the beginning.
      </h2>

      <p>
        AI makes creating software faster. But getting that software into
        production and keeping it running requires an operational
        foundation.
      </p>
    </div>

    <!-- Creation to operations -->
    <div class="journey-grid">

      <!-- Connecting line -->
      <div class="journey-connector" aria-hidden="true"></div>

      <!-- Software creation -->
      <div class="journey-card creation-card reveal">
        <div class="card-gradient" aria-hidden="true"></div>

        <div class="card-content">
          <div class="card-top">
            <div class="card-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 14.5 9.5 3l1.5 7h9l-5.5 11-1.5-7z"/>
              </svg>
            </div>

            <span class="card-label">CREATE</span>
          </div>

          <p class="card-category">Software creation</p>

          <h3>AI builds the software.</h3>

          <p class="card-description">
            AI coding tools turn ideas into applications, generating code
            and working software faster than ever.
          </p>
        </div>
      </div>

      <!-- Software operations -->
      <div class="journey-card operations-card reveal">
        <div class="card-gradient" aria-hidden="true"></div>

        <div class="card-content">
          <div class="card-top">
            <div class="card-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m12 2 9 5-9 5-9-5 9-5Z"/>
                <path d="m3 12 9 5 9-5"/>
                <path d="m3 17 9 5 9-5"/>
              </svg>
            </div>

            <span class="card-label">OPERATE</span>
          </div>

          <p class="card-category">Software operations</p>

          <h3>Nixora handles the infrastructure.</h3>

          <p class="card-description">
            Nixora provides the infrastructure layer to deploy applications,
            diagnose failures, and support their ongoing operations through
            a unified control plane.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Section */

  .product-journey {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 4rem 0;
  }



  .journey-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Heading */

  .journey-heading {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
  }

  .journey-heading h2 {
    margin: 0;
    color: #fff;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.04em;
  }

  .journey-heading p {
    max-width: 42rem;
    margin: 1.25rem auto 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  /* Cards Grid */

  .journey-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: none;
    margin: 2.5rem auto 0;
  }

  .journey-connector {
    display: none;
  }

  /* Cards */

  .journey-card {
    position: relative;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 1rem;
    background: rgba(13, 13, 15, 0.9);
    transition: border-color 0.3s ease;
  }

  .creation-card:hover {
    border-color: rgba(255, 255, 255, 0.16);
  }

  .operations-card {
    border-color: rgba(125, 87, 239, 0.25);
  }

  .operations-card:hover {
    border-color: rgba(125, 87, 239, 0.35);
  }

  .card-gradient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom right,
      rgba(255, 255, 255, 0.035),
      transparent 60%
    );
  }

  .operations-card .card-gradient {
    background: linear-gradient(
      to bottom right,
      rgba(125, 87, 239, 0.08),
      transparent 60%
    );
  }

  .card-content {
    position: relative;
    z-index: 1;
  }

  /* Card Top */

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-icon {
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.8);
  }

  .operations-card .card-icon {
    border-color: rgba(125, 87, 239, 0.25);
    background: rgba(125, 87, 239, 0.1);
    color: #b9a2ff;
  }

  .card-label {
    color: rgba(255, 255, 255, 0.35);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .operations-card .card-label {
    color: rgba(185, 162, 255, 0.65);
  }

  /* Card Text */

  .card-category {
    margin: 1.75rem 0 0;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .operations-card .card-category {
    color: rgba(185, 162, 255, 0.75);
  }

  .card-content h3 {
    margin: 0.5rem 0 0;
    color: #fff;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .card-description {
    max-width: 24rem;
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .operations-card .card-description {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Reveal Animation */

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .journey-grid .journey-card:nth-of-type(2) {
    transition-delay: 0.14s;
  }

  /* Tablet */

  @media (min-width: 640px) {
    .journey-container {
      padding: 0 2rem;
    }

    .journey-heading h2 {
      font-size: 2.25rem;
    }

    .journey-heading p {
      font-size: 1rem;
    }

    .journey-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      margin-top: 3.5rem;
    }

    .journey-card {
      padding: 1.75rem;
    }

    .card-content h3 {
      font-size: 1.5rem;
    }

    .journey-connector {
      position: absolute;
      top: 50%;
      left: 50%;
      display: block;
      width: 1.5rem;
      height: 1px;
      transform: translate(-50%, -50%);
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0.1),
        rgba(125, 87, 239, 0.6),
        rgba(255, 255, 255, 0.1)
      );
      z-index: 2;
    }
  }

  /* Desktop */

  @media (min-width: 1024px) {
    .product-journey {
      padding: 6rem 0;
    }

    .journey-container {
      padding: 0 3rem;
    }

    .journey-heading h2 {
      font-size: 3rem;
    }

    .journey-grid {
      margin-top: 3.5rem;
    }

    .journey-card {
      padding: 2rem;
    }
  }

  /* Reduced Motion */

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .journey-card {
      transition: none;
    }
  }
</style>

<script>
  const revealElements = document.querySelectorAll(".reveal");

  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -80px 0px",
      }
    );

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });
  } else {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  }
</script>
