
---
---

<section class="control-plane">
  <div class="control-container">
    <!-- Intro -->
    <div class="control-intro reveal-on-scroll">
      <h2 class="control-heading">
        It's not just <span>deployment.</span>
      </h2>

      <p class="control-description">
        Deployment is where Nixora starts. The broader goal is to provide one
        operational layer for the applications and AI agents built with AI.
      </p>
    </div>

    <!-- Architecture -->
    <div class="control-grid reveal-on-scroll">
      <!-- Today -->
      <div class="control-card today-card reveal-item">
        <div class="card-content">
          <p class="card-label">Today</p>

          <h3 class="card-title">
            Deploy &amp; diagnose
          </h3>

          <p class="card-description">
            Deploy applications through Nixora's CLI and diagnose deployment
            failures to understand what went wrong and what needs to change.
          </p>
        </div>
      </div>

      <!-- Nixora's direction -->
      <div class="control-card direction-card reveal-item">
        <div class="card-content">
          <p class="card-label">
            Nixora's direction
          </p>

          <h3 class="card-title direction-title">
            A control plane for applications and agents
          </h3>

          <p class="card-description">
            Extend beyond deployment to manage the software lifecycle from
            testing and releases to monitoring, troubleshooting, scaling, and
            governance. Enable AI agents to interact with infrastructure
            through MCP-based workflows and controlled permissions.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Section */
  .control-plane {
    position: relative;
    overflow: hidden;
    padding: 2rem 1.25rem 4rem;
  }

  .control-container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }

  /* Intro */
  .control-intro {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .control-heading {
    margin: 0;
    color: #fff;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .control-heading span {
    color: var(--primary, #a78bfa);
  }

  .control-description {
    max-width: 42rem;
    margin: 1.5rem auto 0;
    color: rgb(255 255 255 / 70%);
    font-size: 1rem;
    line-height: 1.75;
  }

  /* Cards */
  .control-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .control-card {
    position: relative;
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 1rem;
    background: #0d0d0f;
  }

  .direction-card {
    border-color: rgb(125 87 239 / 28%);
  }

  .card-content {
    position: relative;
  }

  /* Card text */
  .card-label {
    margin: 0;
    color: var(--primary, #a78bfa);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .direction-card .card-label {
    color: #a78bfa;
  }

  .card-title {
    margin: 1rem 0 0;
    color: #fff;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.025em;
  }

  .direction-title {
    max-width: none;
    font-size: 1.25rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .card-description {
    margin: 1rem 0 0;
    color: rgb(255 255 255 / 70%);
    font-size: 1rem;
    line-height: 1.75;
  }

  .direction-card .card-description {
    color: rgb(255 255 255 / 75%);
  }

  /* Scroll reveal */
  .reveal-on-scroll {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
    transition:
      opacity 850ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 850ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* Staggered cards */
  .reveal-item {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition:
      opacity 800ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-on-scroll.is-visible .reveal-item {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .reveal-on-scroll.is-visible .reveal-item:nth-child(2) {
    transition-delay: 160ms;
  }

  /* Mobile */
  @media (max-width: 639px) {
    .direction-title {
      white-space: normal;
    }
  }

  /* Tablet */
  @media (min-width: 640px) {
    .control-plane {
      padding: 2.5rem 2rem 5rem;
    }

    .control-heading {
      font-size: 2.25rem;
    }

    .control-description {
      font-size: 1.125rem;
      line-height: 2rem;
    }

    .control-grid {
      gap: 1.25rem;
      margin-top: 3.5rem;
    }

    .control-card {
      padding: 2rem;
    }

    .card-title {
      font-size: 1.5rem;
    }

    .direction-title {
      font-size: 1.75rem;
    }

    .card-description {
      font-size: 1.0625rem;
      line-height: 2rem;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .control-plane {
      padding: 3rem 3rem 6rem;
    }

    .control-heading {
      font-size: 3rem;
    }

    .control-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 1.25rem;
      margin-top: 4rem;
    }

    .control-card {
      padding: 2.25rem;
    }

    .direction-title {
      font-size: 1.875rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll,
    .reveal-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const revealElements = document.querySelectorAll(".reveal-on-scroll");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (prefersReducedMotion || !("IntersectionObserver" in window)) {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  } else {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -40px 0px",
      }
    );

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });
  }
</script>
