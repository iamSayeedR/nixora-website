---
import AnimatedBgSvg from './AnimatedBgSvg.astro';
---
<section id="assistant" style="padding:6rem 2rem;position:relative;overflow:hidden;text-align:center;">
  <AnimatedBgSvg />
  
  <div style="max-width:850px;margin:0 auto;position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:2rem;">
    <!-- Section Title -->
    <h2 class="section-headline">It's not just <span class="accent">deployment.</span></h2>
    
    <!-- Body Copy -->
    <p style="font-size:1.0625rem;line-height:1.75;color:#a1a1aa;max-width:640px;display:block;margin:0 auto;">
      One CLI command deploys your AI-generated app. From there, Nixora manages its entire lifecycle, updating, monitoring, securing, and scaling it automatically.
    </p>

    <!-- Flat row of six equal-weight text labels (zero visual hierarchy, pure breadth indicators) -->
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:0.75rem 1.25rem;margin-top:1rem;max-width:780px;">
      {[
        "Deploy & Run",
        "Lifecycle & Updates",
        "Insights & Cost",
        "Governance & Security",
        "Fleet & Scale",
        "Platform & Integrations"
      ].map((label, idx, arr) => (
        <div style="display:flex;align-items:center;gap:1.25rem;">
          <span style="font-size:0.875rem;color:#d4d4d8;font-weight:500;white-space:nowrap;">{label}</span>
          {idx < arr.length - 1 && <span style="color:#52525b;font-size:0.8rem;">·</span>}
        </div>
      ))}
    </div>
  </div>
</section>
