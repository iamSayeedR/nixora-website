
---
const stats = [
  {
    value: "65",
    target: "65",
    label: "CLI Installs",
    color: "#ffffff",
  },
  {
    value: "47",
    target: "47",
    label: "Real Deployments",
    color: "#a78bfa",
  },
  {
    value: "150+",
    target: "150",
    suffix: "+",
    label: "Early Access Signups",
    color: "#a78bfa",
  },

];
---

<section id="traction" class="traction-section">
  <div class="traction-tint"></div>

  <div class="traction-container">
    <p class="traction-caption">
      Building since September 2026 · CLI launched August 2026
    </p>

    <div class="traction-grid">
      {stats.map((stat) => (
        <div class="stat-card">
        {stat.label === "Early Access Signups" && (
  <div class="stat-highlight-sweep"></div>
)}
          <div class="stat-number-wrap">
            <div
              class="stat-number"
              data-target={stat.target}
              data-suffix={stat.suffix || ""}
              style={`color: ${stat.color}`}
            >
              {stat.value}
            </div>
          </div>

          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tractionSection = document.querySelector("#traction");

  if (tractionSection) {
    const counters =
      tractionSection.querySelectorAll<HTMLElement>(".stat-number[data-target]");

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    function setFinalValue(el: HTMLElement) {
      el.textContent =
        el.dataset.target + (el.dataset.suffix || "");
    }

    function animateCounter(el: HTMLElement) {
      const target = Number(el.dataset.target || 0);
      const suffix = el.dataset.suffix || "";

      if (reducedMotion) {
        setFinalValue(el);
        return;
      }

      const duration = 1400;
      const startTime = performance.now();

      function update(now: number) {
        const progress = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(eased * target);

        el.textContent = current + suffix;

        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }

      requestAnimationFrame(update);
    }

    if (
      reducedMotion ||
      typeof IntersectionObserver === "undefined"
    ) {
      counters.forEach(setFinalValue);
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 },
      );

      counters.forEach((counter) => observer.observe(counter));
    }
  }
</script>

<style>
  .traction-section {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 1.25rem;
    text-align: center;
    box-sizing: border-box;
  }

  .traction-tint {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 40% at 50% 100%,
      rgba(139, 92, 246, 0.06),
      transparent 65%
    );
    pointer-events: none;
  }

  .traction-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1150px;
    margin: 0 auto;
  }

  .traction-caption {
    margin: 0 0 3rem;
    color: #52525b;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.7;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .traction-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    width: 100%;
    overflow: hidden;
    border: 1px solid #1f1f1f;
    border-radius: 14px;
    background: #1f1f1f;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
  }

  .stat-card {
    min-width: 0;
    min-height: 190px;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: #111;
    transition: background 0.25s ease;
  }

  .stat-card:hover {
    background: #141414;
  }

  .stat-number-wrap {
    min-height: 76px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-number {
    font-size: clamp(1.75rem, 3vw, 2.2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    max-width: 180px;
    color: #71717a;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .traction-section {
      padding: 5rem 2rem;
    }

    .stat-card {
      min-height: 210px;
      padding: 2.25rem 1.25rem;
    }

    .stat-number-wrap {
      min-height: 90px;
    }
  }

  @media (max-width: 800px) {
    .traction-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-card {
      min-height: 175px;
    }

    .stat-card:nth-child(odd) {
      border-right: 1px solid #1f1f1f;
    }
  }

  @media (max-width: 420px) {
    .traction-section {
      padding: 3.5rem 1rem;
    }

    .traction-caption {
      max-width: 300px;
      margin: 0 auto 2rem;
      font-size: 0.65rem;
    }

    .stat-card {
      min-height: 155px;
      padding: 1.5rem 0.5rem;
      gap: 0.75rem;
    }

    .stat-number {
      font-size: 1.8rem;
    }

    .stat-label {
      font-size: 0.65rem;
      letter-spacing: 0.07em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-card {
      transition: none;
    }
  }

  .stat-card {
  position: relative;
  isolation: isolate;
}

.stat-highlight-sweep {
  position: absolute;
  inset: 0;
  pointer-events: none;
  border: 1px solid transparent;
  border-radius: inherit;
  background:
    linear-gradient(
      120deg,
      transparent 20%,
      rgba(167, 139, 250, 0.35),
      transparent 80%
    ) border-box;
  background-size: 200% 100%;
  background-position: 200% 0;
  animation: stat-highlight-sweep 4.5s linear infinite;
  z-index: 0;
}

.stat-card:has(.stat-highlight-sweep) {
  background-color: rgba(125, 87, 239, 0.06);
}

.stat-card > * {
  position: relative;
  z-index: 1;
}

.stat-card .stat-highlight-sweep {
  position: absolute;
  z-index: 0;
}

@keyframes stat-highlight-sweep {
  from {
    background-position: 200% 0;
  }

  to {
    background-position: -200% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .stat-highlight-sweep {
    animation: none;
    background-position: center;
  }
}
</style>
