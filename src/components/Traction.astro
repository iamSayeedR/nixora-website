<section id="traction" style="padding:4.5rem 2rem;text-align:center;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 40% at 50% 100%,rgba(139,92,246,0.06),transparent 65%);pointer-events:none;"></div>
  <div style="max-width:900px;margin:0 auto;position:relative;z-index:1;">
    <p style="font-size:0.72rem;color:#3f3f46;text-transform:uppercase;letter-spacing:0.14em;font-weight:700;margin:0 0 3rem;">
      Building since July 2026 · CLI launched August 2026
    </p>

    <!-- Stat Cards Grid -->
    <div class="traction-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;border:1px solid #1f1f1f;border-radius:14px;overflow:hidden;background:#1f1f1f;box-shadow:0 16px 40px rgba(0,0,0,0.5), 0 0 30px rgba(139,92,246,0.06);">

      <!-- Stat 1: CLI Installs (Plain bold number, running total) -->
      <div class="stat-card">
        <div style="height:90px;display:flex;align-items:center;justify-content:center;">
          <div class="stat-number" data-target="65" style="color:#fff;font-size:2.4rem;font-weight:800;">0</div>
        </div>
        <div style="font-size:0.72rem;color:#52525b;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;">CLI Installs</div>
      </div>

      <!-- Stat 2: Real Deployments (Plain bold number, running total) -->
      <div class="stat-card">
        <div style="height:90px;display:flex;align-items:center;justify-content:center;">
          <div class="stat-number" data-target="45" style="color:#a78bfa;font-size:2.4rem;font-weight:800;">0</div>
        </div>
        <div style="font-size:0.72rem;color:#52525b;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;">Real Deployments</div>
      </div>

      <!-- Stat 3: $0 Revenue (De-emphasized / greyed out) -->
      <div class="stat-card">
        <div style="height:90px;display:flex;align-items:center;justify-content:center;">
          <div style="color:#52525b;font-size:2.4rem;font-weight:800;letter-spacing:-0.04em;line-height:1;">$0</div>
        </div>
        <div style="font-size:0.72rem;color:#3f3f46;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;">Revenue · Pre-seed</div>
      </div>

      <!-- Stat 4: $450K SAFE Raise Target (Goal progress ring retained) -->
      <div class="stat-card">
        <div style="position:relative;width:90px;height:90px;display:grid;place-items:center;">
          <svg viewBox="0 0 100 100" width="90" height="90" style="position:absolute;inset:0;transform:rotate(-90deg);">
            <circle cx="50" cy="50" r="40" stroke="#1f1f1f" stroke-width="3" fill="none"/>
            <circle id="ring-450" cx="50" cy="50" r="40" stroke="url(#grad-purple3)"
              stroke-width="4" fill="none"
              stroke-dasharray="251.33" stroke-dashoffset="251.33"
              stroke-linecap="round"/>
            <defs>
              <linearGradient id="grad-purple3" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#52525b"/>
                <stop offset="100%" stop-color="#a78bfa"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="stat-number" data-target="450" data-prefix="$" data-suffix="K" data-ring="ring-450" data-max="500" style="color:#a78bfa;font-size:1.125rem;font-weight:700;letter-spacing:-0.05em;">$0K</div>
        </div>
        <div style="font-size:0.72rem;color:#52525b;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;">SAFE Raise Target</div>
      </div>

    </div>
  </div>
</section>

<style>
  .stat-card {
    background: #111;
    padding: 2.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    transition: background 0.25s ease;
  }

  .stat-card:hover {
    background: #151515;
  }
</style>

<script>
  const CIRCUMFERENCE = 2 * Math.PI * 40; // 251.33
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setStaticStat(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0', 10);
    const max    = parseInt(el.dataset.max    || '100', 10);
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const ringId = el.dataset.ring;
    const ring   = ringId ? document.getElementById(ringId) as SVGCircleElement | null : null;

    el.textContent = prefix + target + suffix;
    if (ring) {
      const fill   = (target / max) * CIRCUMFERENCE;
      const offset = CIRCUMFERENCE - fill;
      ring.style.strokeDashoffset = String(Math.max(offset, 0));
    }
  }

  function animateStat(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0', 10);
    const max    = parseInt(el.dataset.max    || '100', 10);
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const ringId = el.dataset.ring;
    const ring   = ringId ? document.getElementById(ringId) as SVGCircleElement | null : null;

    if (target === 0) return;

    const duration  = 1800;
    const startTime = performance.now();

    function update(now: number) {
      const elapsed  = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased    = 1 - Math.pow(1 - progress, 3); // ease-out cubic

      const current = Math.round(eased * target);
      el.textContent = prefix + current + suffix;

      if (ring) {
        const fill   = (current / max) * CIRCUMFERENCE;
        const offset = CIRCUMFERENCE - fill;
        ring.style.strokeDashoffset = String(Math.max(offset, 0));
      }

      if (progress < 1) requestAnimationFrame(update);
    }

    requestAnimationFrame(update);
  }

  const counters = document.querySelectorAll<HTMLElement>('.stat-number[data-target]');

  if (prefersReducedMotion) {
    counters.forEach(el => setStaticStat(el));
  } else {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateStat(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    counters.forEach(el => {
      const t = parseInt(el.dataset.target || '0', 10);
      if (t > 0) observer.observe(el);
    });
  }
</script>
