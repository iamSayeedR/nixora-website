
---
const modes = [
  {
    title: "Advice-only mode",
    icon: "message",
    status: "User-led assistance",
    description:
      "The Companion explains errors, identifies likely causes, recommends solutions, and warns about potentially risky actions. The user performs the actions.",
    points: ["Error explanations", "Recommended solutions", "Risk awareness"],
  },
  {
    title: "Guided mode",
    icon: "route",
    status: "Guided execution",
    description:
      "The Companion walks users through troubleshooting and deployment steps, helps them make decisions, and requests confirmation when appropriate.",
    points: [
      "Step-by-step guidance",
      "Troubleshooting support",
      "User confirmation",
    ],
  },
  {
    title: "Autonomous mode",
    icon: "bot",
    status: "Long-term goal",
    description:
      "The long-term goal is for the Companion to execute authorized tasks within user-defined permissions. For example, it could diagnose a deployment failure, apply an approved fix, redeploy the application, verify the result, and report what it changed.",
    points: ["Diagnose and resolve", "Approved changes", "Verify and report"],
  },
];
---

<section class="ai-companion">
  <div class="companion-container">

    <!-- Section introduction -->
    <div class="companion-intro" data-reveal>
      <h2>
        An AI companion for your
        <span> software.</span>
      </h2>

      <p>
        The AI Companion is intended to help users understand, troubleshoot,
        and eventually manage their applications and agents.
      </p>

      <div class="intro-label">
        <span>Three levels of assistance</span>
      </div>
    </div>

    <!-- Assistance modes -->
    <div class="modes-grid">
      {modes.map((mode, index) => (
        <article
          class="mode-card"
          data-reveal
          style={`--reveal-delay: ${index * 100}ms`}
        >
          <div class="card-top-line"></div>

          <!-- Icon and status -->
          <div class="card-header">
            <div class="mode-icon">
            {mode.icon === "message" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" />
    <path d="M7 11h10" />
    <path d="M7 15h6" />
    <path d="M7 7h8" />
  </svg>
)}

             
{mode.icon === "route" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="6" cy="19" r="3" />
    <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" />
    <circle cx="18" cy="5" r="3" />
  </svg>
)}


         {mode.icon === "bot" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 8V4H8" />
    <rect width="16" height="12" x="4" y="8" rx="2" />
    <path d="M2 14h2" />
    <path d="M20 14h2" />
    <path d="M15 13v2" />
    <path d="M9 13v2" />
  </svg>
)}
            </div>

            <span class="mode-status">{mode.status}</span>
          </div>

          <!-- Title -->
          <h3>{mode.title}</h3>

          <!-- Description -->
          <p class="mode-description">{mode.description}</p>

          <!-- Supporting details -->
          <div class="mode-details">
            <ul>
              {mode.points.map((point) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="m5 12 4 4L19 6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- Safeguards -->
    <div class="safeguards" data-reveal>
      <div class="safeguard-icon">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="m9 12 2 2 4-4"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>

      <div class="safeguard-content">
        <h3>Built around safeguards</h3>
        <p>
          Autonomous execution will require appropriate permissions,
          isolation, audit logs, and verification mechanisms.
        </p>
      </div>

      <span class="safeguard-label">Safety by design</span>
    </div>

  </div>
</section>

<style>
  .ai-companion {
    position: relative;
    overflow: hidden;
    color: #fff;
    padding: 96px 0;
  }

  .companion-container {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* Introduction */
  .companion-intro {
    max-width: 768px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .companion-intro h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .companion-intro h2 span {
    color: #a78bfa;
  }

  .companion-intro > p {
    max-width: 640px;
    margin: 20px auto 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 15px;
    line-height: 1.85;
  }

  .intro-label {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }

  .intro-label span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.025em;
  }

  /* Cards */
  .modes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .mode-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 28px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.025);
    transition:
      border-color 0.3s ease,
      background 0.3s ease,
      transform 0.3s ease;
  }

  .mode-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-3px);
  }

  .card-top-line {
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.15),
      transparent
    );
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 28px;
  }

  .mode-icon,
  .safeguard-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 13px;
    background: rgba(167, 139, 250, 0.08);
    color: #b8a4ff;
    transition: background 0.3s ease;
  }

  .mode-icon svg {
    width: 20px;
    height: 20px;
  }

  .mode-card:hover .mode-icon {
    background: rgba(167, 139, 250, 0.13);
  }

  .mode-status {
    max-width: 100%;
    padding: 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.025);
    color: rgba(255, 255, 255, 0.45);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.025em;
    text-align: center;
  }

  .mode-card h3 {
    margin: 0 0 14px;
    color: #fff;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .mode-description {
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
    line-height: 1.85;
  }

  .mode-details {
    flex: 1;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .mode-details ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mode-details li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    line-height: 1.6;
  }

  .mode-details li svg {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.35);
  }

  /* Safeguards */
  .safeguards {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
    padding: 28px 32px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.025);
  }

  .safeguard-icon {
    width: 48px;
    height: 48px;
  }

  .safeguard-icon svg {
    width: 22px;
    height: 22px;
  }

  .safeguard-content {
    flex: 1;
    min-width: 0;
  }

  .safeguard-content h3 {
    margin: 0;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
  }

  .safeguard-content p {
    max-width: 768px;
    margin: 8px 0 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    line-height: 1.85;
  }

  .safeguard-label {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.35);
    font-size: 12px;
    font-weight: 500;
  }

  /* Reveal animation */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Tablet */
  @media (max-width: 900px) {
    .ai-companion {
      padding: 80px 0;
    }

    .modes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mode-card:last-child {
      grid-column: 1 / -1;
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .ai-companion {
      padding: 68px 0;
    }

    .companion-container {
      padding: 0 20px;
    }

    .companion-intro {
      margin-bottom: 40px;
    }

    .companion-intro h2 {
      font-size: 32px;
    }

    .companion-intro > p {
      margin-top: 16px;
      font-size: 13px;
      line-height: 1.8;
    }

    .modes-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .mode-card:last-child {
      grid-column: auto;
    }

    .mode-card {
      padding: 24px;
    }

    .card-header {
      margin-bottom: 22px;
    }

    .mode-card h3 {
      font-size: 19px;
    }

    .safeguards {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      padding: 24px;
    }

    .safeguard-label {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .companion-container {
      padding: 0 16px;
    }

    .mode-card {
      padding: 21px;
    }

    .mode-status {
      font-size: 9px;
      padding: 6px 9px;
    }

    .safeguards {
      padding: 21px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .mode-card,
    .mode-icon {
      transition: none;
    }
  }
</style>

<script>
  const revealElements = document.querySelectorAll("[data-reveal]");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (prefersReducedMotion || !("IntersectionObserver" in window)) {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  } else {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -30px 0px",
      }
    );

    revealElements.forEach((element) => observer.observe(element));
  }
</script>
