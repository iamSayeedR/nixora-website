---
const faqs = [
  {
    q: "What is Nixora?",
    a: "Nixora is the control plane for AI-generated software. It is a developer platform designed to automate deployment, hosting, and HTTPS provisioning for applications created by AI coding agents, with additional lifecycle management capabilities on our roadmap."
  },
  {
    q: "What does Nixora do?",
    a: "Nixora bridges the gap between AI-generated code and live production. Today, CLI commands containerize your application, provision cloud compute, issue TLS/HTTPS certificates, and manage persistent hosting automatically. We're building toward an Infrastructure Intent Engine that understands what an application (or AI agent) actually needs and provisions it automatically, plus deployment diagnostics that explain failures instead of just pointing at logs."
  },
  {
    q: "Who is Nixora for?",
    a: "Nixora is built for software engineers, solo technical founders, AI developers, and engineering teams building applications using AI coding tools like Claude, Cursor, Codex, and Gemini."
  },
  {
    q: "How does Nixora deployment work?",
    a: "Nixora is currently in early access. We're onboarding a limited number of builders through our waitlist to test the deployment experience before opening it up more broadly. Once approved, you'll get CLI access: from there, deployment is a single guided step that auto-detects your app's runtime, containerizes it, provisions compute, attaches HTTPS, and gives you a live URL. Join the waitlist to get access."
  },
  {
    q: "Is Nixora a deployment platform?",
    a: "Yes. Nixora is a cloud deployment platform, currently CLI-based, built for the high-velocity lifecycle of AI-generated applications."
  },
  {
    q: "Does Nixora have a web dashboard?",
    a: "Not yet. Currently, Nixora's live deployment capability is CLI-based. A cloud web dashboard and management console are planned on our product roadmap."
  },
  {
    q: "Can I deploy with Nixora today?",
    a: "Yes. You can deploy applications today using the Nixora CLI command line tool with automated containerization, HTTPS, and persistent hosting."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq" style="padding:5.5rem 2rem;position:relative;overflow:hidden;">
  <!-- Purple radial background depth wash (matching hero layout) -->
  <div style="position:absolute;top:-40px;left:50%;transform:translateX(-50%);width:100%;max-width:800px;height:240px;background:radial-gradient(ellipse 70% 45% at 50% 0%, rgba(139,92,246,0.12), transparent 70%);pointer-events:none;z-index:0;"></div>

  <div style="max-width:850px;margin:0 auto;position:relative;z-index:1;display:flex;flex-direction:column;gap:3.5rem;">
    
    <!-- Section Header -->
    <div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:0.75rem;">
      <div style="font-size:0.72rem;color:#a78bfa;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;font-family:'Fira Code',monospace;">Frequently Asked Questions</div>
      <h2 class="section-headline">Everything you need to know about <span class="accent">Nixora</span></h2>
      <p class="section-para" style="max-width:540px;margin:0 auto;">
        Clear, factual answers regarding Nixora's current CLI capabilities, cloud infrastructure, and product roadmap.
      </p>
    </div>

    <!-- Accordion List -->
    <div style="display:flex;flex-direction:column;gap:1.125rem;">
      {faqs.map((faq, index) => (
        <details class="faq-card">
          <summary class="faq-summary">
            <div class="faq-summary-left">
              <span class="faq-index">{(index + 1).toString().padStart(2, '0')}</span>
              <span class="faq-question">{faq.q}</span>
            </div>
            <div class="faq-icon-wrapper">
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>

          <div class="faq-answer-container">
            <p class="faq-answer" set:html={faq.a.replace(/`([^`]+)`/g, '<code>$1</code>')}></p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  /* Remove default disclosure triangle markers in all browsers */
  details.faq-card summary::-webkit-details-marker,
  details.faq-card summary::marker {
    display: none !important;
    font-size: 0 !important;
    width: 0 !important;
    height: 0 !important;
    color: transparent !important;
  }

  .faq-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.35rem 1.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(139, 92, 246, 0.02);
    transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    cursor: pointer;
    display: block;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-card:hover {
    border-color: rgba(167, 139, 250, 0.35);
    background: rgba(167, 139, 250, 0.04);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(139, 92, 246, 0.08);
  }

  .faq-card[open] {
    border-color: rgba(167, 139, 250, 0.5);
    background: linear-gradient(180deg, rgba(167, 139, 250, 0.06) 0%, rgba(13, 13, 13, 0.95) 100%);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 30px rgba(139, 92, 246, 0.14);
  }

  .faq-summary {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #fff;
    list-style: none !important;
    list-style-type: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 1rem !important;
    user-select: none;
    line-height: 1.35;
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
  }

  .faq-summary-left {
    display: flex !important;
    align-items: center !important;
    gap: 1.25rem !important;
    flex: 1;
    min-width: 0;
  }

  .faq-summary:focus-visible {
    outline: 2px solid #a78bfa;
    outline-offset: 6px;
    border-radius: 6px;
  }

  .faq-index {
    font-family: 'Fira Code', 'Geist Mono', monospace;
    font-size: 0.825rem;
    font-weight: 600;
    color: #a78bfa;
    opacity: 0.85;
    flex-shrink: 0;
    margin-right: 0.85rem !important;
    display: inline-block;
  }

  .faq-question {
    color: #fff;
    word-break: break-word;
  }

  .faq-icon-wrapper {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a1a1aa;
    flex-shrink: 0;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }

  .faq-card:hover .faq-icon-wrapper {
    background: rgba(167, 139, 250, 0.12);
    border-color: rgba(167, 139, 250, 0.3);
    color: #a78bfa;
  }

  .faq-chevron {
    transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-card[open] .faq-chevron {
    transform: rotate(180deg);
    color: #a78bfa;
  }

  .faq-answer-container {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    animation: faqFadeIn 300ms ease forwards;
  }

  .faq-answer {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: #a1a1aa;
    margin: 0;
  }

  .faq-answer :global(code) {
    font-family: 'Fira Code', 'Geist Mono', monospace;
    color: #c4b5fd !important;
    background: rgba(167, 139, 250, 0.12) !important;
    border: none !important;
    padding: 0.15rem 0.35rem !important;
    border-radius: 4px !important;
    font-size: 0.875rem !important;
    display: inline !important;
    vertical-align: baseline !important;
    margin: 0 0.15rem !important;
  }

  @keyframes faqFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .faq-card {
      padding: 1.1rem 1.25rem;
    }
    .faq-summary {
      font-size: 0.975rem;
    }
    .faq-summary-left {
      gap: 0.85rem !important;
    }
    .faq-index {
      font-size: 0.75rem;
      margin-right: 0.65rem !important;
    }
  }
</style>
