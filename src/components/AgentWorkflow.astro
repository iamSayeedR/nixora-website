
---
const steps = [
  {
    actor: "AI CODING AGENT",
    title: "Generate",
    description:
      "An AI coding agent generates an application or AI agent from a user's requirements.",
    icon: "code",
  },
  {
    actor: "AI CODING AGENT",
    title: "Request deployment",
    description:
      "The agent requests deployment through Nixora using the planned MCP integration.",
    icon: "plug",
  },
  {
    actor: "NIXORA",
    title: "Deploy",
    description:
      "Nixora deploys the application or AI agent through a supported workflow.",
    icon: "upload",
  },
  {
    actor: "NIXORA",
    title: "Diagnose",
    description:
      "If deployment fails, Nixora identifies the issue and provides diagnostic information.",
    icon: "diagnose",
  },
  {
    actor: "AI CODING AGENT",
    title: "Correct",
    description:
      "The coding agent or AI Companion proposes or performs an authorized correction.",
    icon: "sparkles",
  },
  {
    actor: "NIXORA",
    title: "Verify",
    description:
      "Nixora verifies that the updated application or agent is running successfully.",
    icon: "shield",
  },
  {
    actor: "NIXORA",
    title: "Manage",
    description:
      "Nixora helps monitor and manage applications and AI agents over time.",
    icon: "activity",
  },
];
---

<section class="agent-workflow">
  <div class="workflow-background"></div>

  <div class="workflow-container">

    <!-- Section intro -->
    <div class="workflow-intro" data-reveal>
      <p class="workflow-eyebrow">Planned integration</p>

      <h2>
        How AI Coding Agents <br/> Will Use
        <span> Nixora</span>
      </h2>

      <p class="workflow-subtitle">
        Nixora aims to integrate with AI coding tools, allowing agents to
        interact with deployment workflows through a unified control plane.
      </p>
    </div>

    <!-- Deployment workflow -->
    <div class="workflow-panel" data-reveal>
      <div class="workflow-panel-header">
        <div>
          <h3>Deployment pipeline</h3>
          <p>From generated code to ongoing operations</p>
        </div>

       
      </div>

      <div class="workflow-grid" data-reveal>
        {steps.map((step, index) => (
          <div
            class="workflow-step"
            data-reveal
            style={`--step-delay: ${index * 110}ms`}
          >
            <div class="step-icon-wrap">
              <div class="step-icon">
                {step.icon === "code" && (
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 4l-4 16" />
                  </svg>
                )}

                {step.icon === "plug" && (
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 7V3M15 7V3M7 7h10v4a5 5 0 0 1-10 0V7ZM12 16v5" />
                  </svg>
                )}

                {step.icon === "upload" && (
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M7.5 18.5H17a4 4 0 0 0 .4-8A6 6 0 0 0 6 9.2a4.7 4.7 0 0 0 1.5 9.3Z" />
                    <path d="M12 16V10m-2.5 2.5L12 10l2.5 2.5" />
                  </svg>
                )}

                {step.icon === "diagnose" && (
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="m15.5 15.5 5 5M8 10.5h2l1.5-2.5 1.5 5 1-2.5h1" />
                  </svg>
                )}

                {step.icon === "sparkles" && (
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z" />
                    <path d="m19 14 .9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14ZM5 3l.7 1.8L7.5 5.5l-1.8.7L5 8l-.7-1.8-1.8-.7 1.8-.7L5 3Z" />
                  </svg>
                )}

                {step.icon === "shield" && (
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}

                {step.icon === "activity" && (
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 12h4l3-8 4 16 3-8h4" />
                  </svg>
                )}
              </div>
            </div>

            <p class="step-actor">{step.actor}</p>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-description">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Supporting capabilities -->
    <div class="workflow-capabilities">

      <article
        class="capability-card"
        data-reveal
        style="--card-delay: 100ms"
      >
        <div class="capability-icon">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 7V3M15 7V3M7 7h10v4a5 5 0 0 1-10 0V7ZM12 16v5" />
          </svg>
        </div>

        <h3>MCP Integration</h3>

        <p>
          A planned MCP server will allow compatible AI coding tools to
          interact with Nixora and request deployments.
        </p>
      </article>

      <article
        class="capability-card"
        data-reveal
        style="--card-delay: 200ms"
      >
        <div class="capability-icon">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="4" y="10" width="16" height="11" rx="2" />
            <path d="M8 10V7a4 4 0 1 1 8 0v3M12 14v3" />
          </svg>
        </div>

        <h3>Permissions &amp; Audit Trails</h3>

        <p>
          Nixora aims to give AI agents controlled access to infrastructure,
          with authorized actions and traceable operations.
        </p>
      </article>

    </div>

    <!-- Future scope note -->
    <p class="workflow-note" data-reveal>
      This workflow represents Nixora's intended direction. MCP integration,
      agent permissions, and the broader capabilities described here are
      planned and are not part of the current product.
    </p>

  </div>
</section>

<script>
  const workflowSections = document.querySelectorAll(".agent-workflow");

  workflowSections.forEach((section) => {
    const revealElements = section.querySelectorAll("[data-reveal]");

    if (
      !("IntersectionObserver" in window) ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      revealElements.forEach((element) => {
        element.classList.add("is-visible");
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -35px 0px",
      }
    );

    revealElements.forEach((element) => observer.observe(element));
  });
</script>

<style>
  .agent-workflow {
    --workflow-accent: #a78bfa;
    --workflow-muted: var(--muted-foreground, #99939f);
    --workflow-foreground: var(--foreground, #f5f3f7);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 64px 0;
    color: var(--workflow-foreground);
  }

 

  .workflow-container {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Intro */

  .workflow-intro {
    max-width: 760px;
    margin: 0 auto 56px;
    text-align: center;
  }

  .workflow-eyebrow {
    margin: 0 0 16px;
    color: var(--workflow-accent);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .workflow-intro h2 {
    margin: 0;
    font-size: clamp(29px, 4vw, 44px);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.045em;
  }

  .workflow-intro h2 span {
    color: var(--workflow-accent);
  }

  .workflow-subtitle {
    max-width: 650px;
    margin: 18px auto 0;
    color: var(--workflow-muted);
    font-size: 15px;
    line-height: 1.8;
  }

  /* Main panel */

  .workflow-panel {
    padding: 32px 36px 38px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.025);
  }

  .workflow-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 38px;
    padding-bottom: 23px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .workflow-panel-header h3 {
    margin: 0;
    color: var(--workflow-foreground);
    font-size: 14px;
    font-weight: 650;
  }

  .workflow-panel-header p {
    margin: 6px 0 0;
    color: var(--workflow-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .workflow-count {
    flex-shrink: 0;
    padding: 7px 12px;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 999px;
    background: rgba(167, 139, 250, 0.07);
    color: var(--workflow-accent);
    font-size: 10px;
    font-weight: 550;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Workflow grid */

  .workflow-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  /* Mobile vertical connecting line */

  .workflow-grid::before {
    position: absolute;
    top: 27px;
    bottom: 27px;
    left: 26px;
    z-index: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      rgba(167, 139, 250, 0.15),
      rgba(167, 139, 250, 0.65) 50%,
      rgba(167, 139, 250, 0.15)
    );
    content: "";
  }

  .workflow-grid::after {
    position: absolute;
    top: 26px;
    left: 7.14%;
    z-index: 3;
    display: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #c4b5fd;
    box-shadow: 0 0 12px 3px rgba(167, 139, 250, 0.55);
    content: "";
    opacity: 0;
  }

 

  .workflow-step {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    align-items: start;
    column-gap: 17px;
    min-width: 0;
    padding: 0 0 30px;
    text-align: left;
  }

  .workflow-step:last-child {
    padding-bottom: 0;
  }

  .step-icon-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    grid-column: 1;
    grid-row: 1 / span 3;
    width: 54px;
    height: 54px;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .step-icon {
    position: relative;
    z-index: 2;
    display: flex;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9px;
    background: #111014;
    color: var(--workflow-accent);
    transition:
      border-color 300ms ease,
      background-color 300ms ease;
  }

  .step-icon svg,
  .capability-icon svg {
    display: block;
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: none;
    animation: none;
    transition: none;
  }

  .workflow-step:hover .step-icon {
    border-color: rgba(167, 139, 250, 0.5);
    background: #17131f;
  }

  /* Icon ring animation */

  .step-icon::after {
    position: absolute;
    inset: -5px;
    z-index: -1;
    border: 1px solid rgba(167, 139, 250, 0.5);
    border-radius: 12px;
    content: "";
    opacity: 0;
    transform: scale(0.85);
  }

  .workflow-step.is-visible .step-icon::after {
    animation: icon-ring 0.9s calc(350ms + var(--step-delay)) ease-out 1;
  }

  .step-actor {
    grid-column: 2;
    margin: 2px 0 6px;
    color: rgba(255, 255, 255, 0.42);
    font-size: 9px;
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: 0.13em;
  }

  .step-title {
    grid-column: 2;
    margin: 0;
    color: var(--workflow-foreground);
    font-size: 14px;
    font-weight: 650;
    line-height: 1.5;
  }

  .step-description {
    grid-column: 2;
    width: 100%;
    margin: 7px 0 0;
    color: var(--workflow-muted);
    font-size: 12px;
    line-height: 1.75;
  }

  /* Supporting capability cards */

  .workflow-capabilities {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin-top: 20px;
  }

  .capability-card {
    min-width: 0;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.025);
    transition:
      border-color 300ms ease,
      background-color 300ms ease,
      transform 300ms ease;
  }

  .capability-card:hover {
    transform: translateY(-2px);
    border-color: rgba(167, 139, 250, 0.3);
    background: rgba(167, 139, 250, 0.025);
  }

  .capability-icon {
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 8px;
    background: rgba(167, 139, 250, 0.07);
    color: var(--workflow-accent);
    transition:
      border-color 300ms ease,
      background-color 300ms ease;
  }

  .capability-card:hover .capability-icon {
    border-color: rgba(167, 139, 250, 0.4);
    background: rgba(167, 139, 250, 0.12);
  }

  .capability-icon svg {
    width: 19px;
    height: 19px;
  }

  .capability-card h3 {
    margin: 0;
    color: var(--workflow-foreground);
    font-size: 15px;
    font-weight: 650;
    line-height: 1.5;
  }

  .capability-card p {
    margin: 10px 0 0;
    color: var(--workflow-muted);
    font-size: 13px;
    line-height: 1.8;
  }

  /* Future scope note */

  .workflow-note {
    max-width: 850px;
    margin: 22px auto 0;
    color: rgba(160, 154, 168, 0.65);
    font-size: 11px;
    line-height: 1.8;
    text-align: center;
  }

  /* Scroll reveal */

  [data-reveal]:not(.workflow-grid) {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--step-delay, var(--card-delay, 0ms));
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Animations */

  @keyframes workflow-signal {
    0% {
      left: 7.14%;
      opacity: 0;
    }

    12% {
      opacity: 1;
    }

    85% {
      opacity: 1;
    }

    100% {
      left: 92.86%;
      opacity: 0;
    }
  }

  @keyframes icon-ring {
    0% {
      opacity: 0;
      transform: scale(0.85);
    }

    35% {
      opacity: 0.65;
      transform: scale(1.25);
    }

    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  /* Larger phones */

  @media (min-width: 480px) {
    .agent-workflow {
      padding: 72px 0;
    }

    .workflow-container {
      padding: 0 24px;
    }

    .workflow-panel {
      padding: 28px 26px 32px;
    }

    .workflow-step {
      grid-template-columns: 58px minmax(0, 1fr);
      column-gap: 20px;
      padding-bottom: 34px;
    }

    .workflow-grid::before {
      left: 28px;
    }

    .step-icon-wrap {
      width: 58px;
      height: 58px;
    }

    .step-icon {
      width: 54px;
      height: 54px;
    }
  }

  /* Tablet */

  @media (min-width: 640px) {
    .agent-workflow {
      padding: 80px 0;
    }

    .workflow-container {
      padding: 0 32px;
    }

    .workflow-intro {
      margin-bottom: 48px;
    }

    .workflow-panel {
      padding: 32px 28px 36px;
    }

    .workflow-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 28px;
      row-gap: 36px;
    }

    .workflow-grid::before {
      display: none;
    }

    .workflow-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0;
      text-align: center;
    }

    .step-icon-wrap {
      width: 60px;
      height: 60px;
      margin-bottom: 16px;
    }

    .step-actor {
      min-height: 26px;
      margin: 0 0 7px;
      font-size: 9px;
    }

    .step-title {
      min-height: 42px;
      font-size: 15px;
    }

    .step-description {
      margin-top: 8px;
      font-size: 12px;
    }

    .workflow-capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .capability-card {
      padding: 24px;
    }
  }

  /* Wider tablets */

  @media (min-width: 900px) {
    .workflow-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 26px;
      row-gap: 40px;
    }

    .workflow-panel {
      padding: 36px 32px 40px;
    }

    .step-description {
      max-width: 245px;
    }
  }

  /* Desktop */

  @media (min-width: 1200px) {
    .agent-workflow {
      padding: 96px 0;
    }

    .workflow-container {
      padding: 0 40px;
    }

    .workflow-intro {
      max-width: 760px;
      margin-bottom: 64px;
    }

    .workflow-panel {
      padding: 36px 30px 40px;
    }

    .workflow-grid {
      grid-template-columns: repeat(7, minmax(0, 1fr));
      column-gap: 14px;
      row-gap: 0;
    }

    .workflow-grid::before {
      display: block;
      top: 30px;
      bottom: auto;
      left: 7.14%;
      right: 7.14%;
      width: auto;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgba(167, 139, 250, 0.2),
        rgba(167, 139, 250, 0.8),
        rgba(167, 139, 250, 0.2)
      );
    }

    .workflow-grid::after {
      display: block;
      top: 26px;
      left: 7.14%;
    }

    .step-icon-wrap {
      margin-bottom: 18px;
    }

    .step-title {
      font-size: 14px;
    }

    .step-description {
      max-width: none;
      font-size: 11px;
      line-height: 1.7;
    }

    .workflow-capabilities {
      gap: 20px;
      margin-top: 22px;
    }
  }

  /* Large desktop */

  @media (min-width: 1440px) {
    .workflow-container {
      max-width: 1320px;
    }

    .workflow-panel {
      padding-right: 38px;
      padding-left: 38px;
    }

    .workflow-grid {
      column-gap: 20px;
    }

    .step-description {
      font-size: 12px;
    }
  }

  /* Compact mobile screens */

  @media (max-width: 380px) {
    .agent-workflow {
      padding: 56px 0;
    }

    .workflow-container {
      padding: 0 14px;
    }

    .workflow-intro {
      margin-bottom: 34px;
    }

    .workflow-intro h2 {
      font-size: 27px;
    }

    .workflow-subtitle {
      font-size: 12px;
      line-height: 1.75;
    }

    .workflow-panel {
      padding: 21px 15px 25px;
      border-radius: 13px;
    }

    .workflow-panel-header {
      gap: 9px;
      margin-bottom: 28px;
      padding-bottom: 17px;
    }

    .workflow-panel-header h3 {
      font-size: 13px;
    }

    .workflow-panel-header p {
      font-size: 11px;
    }

    .workflow-count {
      padding: 6px 8px;
      font-size: 8px;
    }

    .workflow-step {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: 13px;
      padding-bottom: 28px;
    }

    .workflow-grid::before {
      left: 23px;
    }

    .step-icon-wrap {
      width: 48px;
      height: 48px;
    }

    .step-icon {
      width: 45px;
      height: 45px;
    }

    .step-icon svg {
      width: 19px;
      height: 19px;
    }

    .step-actor {
      font-size: 8px;
      letter-spacing: 0.1em;
    }

    .step-title {
      min-height: 0;
      font-size: 13px;
    }

    .step-description {
      font-size: 11px;
      line-height: 1.7;
    }

    .capability-card {
      padding: 20px;
    }

    .workflow-note {
      font-size: 10px;
    }
  }

  /* Reduced motion accessibility */

  @media (prefers-reduced-motion: reduce) {
    .agent-workflow *,
    .agent-workflow *::before,
    .agent-workflow *::after {
      scroll-behavior: auto !important;
      animation: none !important;
      transition: none !important;
    }

    .agent-workflow [data-reveal] {
      opacity: 1;
      transform: none;
    }

    .workflow-grid::after {
      display: none;
    }
  }
</style>
