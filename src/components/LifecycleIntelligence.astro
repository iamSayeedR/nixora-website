
---
---

<section class="lifecycle-section">
  <div class="section-tint" aria-hidden="true"></div>

  <div class="lifecycle-content" data-reveal>
    <h2 class="lifecycle-title">
      Lifecycle <span>Intelligence</span>
    </h2>

    <h3 class="lifecycle-subtitle">
      Understand what changes. Know what needs attention.
    </h3>

    <p class="lifecycle-description">
      Nixora aims to build on deployment history and application signals to
      track changes, understand their impact, and help identify potential
      issues before they affect application reliability.
    </p>
  </div>
</section>

<script>
  const sections = document.querySelectorAll("[data-reveal]");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -80px 0px",
      }
    );

    sections.forEach((section) => observer.observe(section));
  } else {
    sections.forEach((section) => section.classList.add("is-visible"));
  }
</script>

<style>
  .lifecycle-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 5rem 1.25rem;
   
  }


  .lifecycle-content {
    position: relative;
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;

    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 550ms ease-out,
      transform 550ms ease-out;
  }

  .lifecycle-content.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Heading */
  .lifecycle-title {
    margin-top: 1.25rem;
    color: #fff;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  /* Purple highlight */
  .lifecycle-title span {
    color: #a78bfa;
  }

  /* Subtitle */
  .lifecycle-subtitle {
    max-width: 42rem;
    margin: 1.5rem auto 0;
    color: rgb(255 255 255 / 85%);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.625;
    letter-spacing: -0.025em;
  }

  /* Description */
  .lifecycle-description {
    max-width: 42rem;
    margin: 1rem auto 0;
    color: rgb(255 255 255 / 55%);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  /* Small tablets */
  @media (min-width: 640px) {
    .lifecycle-section {
      padding: 6rem 2rem;
    }

    .lifecycle-title {
      margin-top: 1.5rem;
      font-size: 2.25rem;
    }

    .lifecycle-subtitle {
      margin-top: 1.75rem;
      font-size: 1.25rem;
    }

    .lifecycle-description {
      margin-top: 1.25rem;
      font-size: 1rem;
      line-height: 2;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .lifecycle-section {
      padding: 7rem 3rem;
    }

    .lifecycle-title {
      font-size: 3rem;
    }

    .lifecycle-subtitle {
      font-size: 1.5rem;
    }
  }

  /* Reduced motion accessibility */
  @media (prefers-reduced-motion: reduce) {
    .lifecycle-content {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
