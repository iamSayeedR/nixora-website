
---
---

<section class="lifecycle-section">
  <div class="section-tint" aria-hidden="true"></div>

  <div class="lifecycle-content">

    <!-- Heading -->
    <h2
      class="lifecycle-title"
      data-reveal
      style="--reveal-delay: 0ms"
    >
      Lifecycle <span>Intelligence</span>
    </h2>

    <!-- Subtitle -->
    <h3
      class="lifecycle-subtitle"
      data-reveal
      style="--reveal-delay: 40ms"
    >
      Understand what changes. Know what needs attention.
    </h3>

    <!-- Description -->
    <p
      class="lifecycle-description"
      data-reveal
      style="--reveal-delay: 80ms"
    >
      Nixora aims to build on deployment history and application signals to
      track changes, understand their impact, and help identify potential
      issues before they affect application reliability.
    </p>

  </div>
</section>

<script>
  const initLifecycleReveal = () => {
    const elements = document.querySelectorAll(
      ".lifecycle-section [data-reveal]:not(.is-visible)"
    );

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (
      prefersReducedMotion ||
      !("IntersectionObserver" in window)
    ) {
      elements.forEach((element) => {
        element.classList.add("is-visible");
      });

      return;
    }

    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.05,
        rootMargin: "0px 0px 60px 0px",
      }
    );

    elements.forEach((element) => {
      observer.observe(element);
    });
  };

  initLifecycleReveal();

  document.addEventListener("astro:page-load", initLifecycleReveal);
</script>

<style>
  .lifecycle-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 4rem 1.25rem 2rem;
  }

  .lifecycle-content {
    position: relative;
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
  }

  /* Scroll reveal */

  .lifecycle-content [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 16px, 0);

    transition:
      opacity 450ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 450ms cubic-bezier(0.16, 1, 0.3, 1);

    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  .lifecycle-content [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    will-change: auto;
  }

  /* Heading */

  .lifecycle-title {
    margin-top: 1.25rem;
    color: #fff;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  /* Purple highlight */

  .lifecycle-title span {
    color: #a78bfa;
  }

  /* Subtitle */

  .lifecycle-subtitle {
    max-width: 42rem;
    margin: 1.5rem auto 0;
    color: rgb(255 255 255 / 85%);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.625;
    letter-spacing: -0.025em;
  }

  /* Description */

  .lifecycle-description {
    max-width: 42rem;
    margin: 1rem auto 0;
    color: rgb(255 255 255 / 55%);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  /* Small tablets */

  @media (min-width: 640px) {
    .lifecycle-section {
      padding: 4.5rem 2rem 2.25rem;
    }

    .lifecycle-title {
      margin-top: 1.5rem;
      font-size: 2.25rem;
    }

    .lifecycle-subtitle {
      margin-top: 1.75rem;
      font-size: 1.25rem;
    }

    .lifecycle-description {
      margin-top: 1.25rem;
      font-size: 1rem;
      line-height: 2;
    }
  }

  /* Desktop */

  @media (min-width: 1024px) {
    .lifecycle-section {
      padding: 5rem 3rem 2.5rem;
    }

    .lifecycle-title {
      font-size: 3rem;
    }

    .lifecycle-subtitle {
      font-size: 1.5rem;
    }
  }

  /* Reduced motion accessibility */

  @media (prefers-reduced-motion: reduce) {
    .lifecycle-content [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
</style>
