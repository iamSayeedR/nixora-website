
---
const today = {
  group: "GROUP 01",
  title: "Deploy & Diagnose",
  description:
    "Go from AI-generated code to a live, running application in seconds. Diagnose why an AI-generated deployment failed and what to change.",
  tags: [
    "CLI",
    "Automated deployment",
    "Diagnose failed deploys",
    "Hosting",
    "HTTPS",
    "Shareable URLs",
  ],
};

const next = {
  group: "GROUP 02",
  title: "Agent Access & MCP",
  description:
    "Agent-native deployment target via MCP server, multi-agent access with per-agent permissions and audit trail, web dashboard, and Fargate infrastructure.",
  tags: [
    "MCP server for agents",
    "Multi-agent access",
    "Per-agent permissions",
    "Audit trail",
    "Web dashboard",
    "Fargate infrastructure",
  ],
};

const later = [
  {
    group: "GROUP 03",
    title: "Monitoring & Observability",
    description:
      "Deep application understanding, continuous monitoring, and real-time observability for agent-built software.",
    tags: [
      "Deep app understanding",
      "Continuous monitoring",
      "Cost insights",
      "Telemetry analytics",
    ],
  },
  {
    group: "GROUP 04",
    title: "Scaling & Optimization",
    description:
      "Autonomous scaling, auto-sleep, auto-retirement, and resource optimization as workloads grow.",
    tags: [
      "Autonomous scaling",
      "Resource optimization",
      "Auto sleep",
      "Auto retirement",
      "Cost controls",
    ],
  },
  {
    group: "GROUP 05",
    title: "Governance & Systems",
    description:
      "Multi-agent system deployment, AI agent lifecycle management, security policies, and governance.",
    tags: [
      "Multi-agent systems",
      "Agent lifecycle",
      "Security & governance",
      "Policy enforcement",
      "Fleet retirement",
    ],
  },
  {
    group: "GROUP 06",
    title: "Platform & Ecosystem",
    description:
      "Extensible platform integrations, marketplace, REST APIs, and no-code tools.",
    tags: [
      "Marketplace",
      "REST APIs & SDKs",
      "No-code web interface",
      "Plugin ecosystem",
    ],
  },
];

const sectionLabel = "roadmap-label";
const cardStyle = "roadmap-card";
const tagStyle = "roadmap-tag";
---

<section class="roadmap-section">
  <div class="roadmap-tint" aria-hidden="true"></div>

  <div class="roadmap-container">
    <!-- Heading -->
   <div class="roadmap-heading" data-reveal>
  <h2>Where Nixora is <span>going</span></h2>

      <p>
        Today, Nixora deploys AI-generated apps and diagnoses why they fail.
        Next, it becomes a deployment target your AI agents call directly
        through an MCP server, so multiple agents can work with your
        infrastructure at once, each with its own permissions and a clear
        record of what it did. Longer term, we're building toward
        infrastructure that understands your application, monitors it, and
        adapts as it grows, including multi-agent systems deployed and
        governed as one workload.
      </p>
    </div>

    <!-- TODAY -->
    <div class="roadmap-stage" data-reveal>
      <div class="roadmap-stage-heading">
        <p class={sectionLabel}>
          <span></span>
          Today
        </p>
      </div>

      <div class={`${cardStyle} today-card`} data-reveal>
        <span class="card-status" aria-hidden="true"></span>

        <div class="today-grid">
          <!-- Copy -->
          <div class="roadmap-copy">
            <p class="roadmap-group">{today.group}</p>

            <h3>{today.title}</h3>

            <p class="roadmap-description">
              {today.description}
            </p>

            <div class="roadmap-tags">
              {today.tags.map((tag) => (
                <span class={`${tagStyle} active-tag`} data-reveal>
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Deployment terminal -->
          <div class="terminal-panel">
            <div class="terminal-window">
              <div class="terminal-header">
                <div class="terminal-dots">
                  <span class="terminal-dot red"></span>
                  <span class="terminal-dot yellow"></span>
                  <span class="terminal-dot green"></span>
                </div>

                <span class="terminal-title">nixora — bash</span>
                <span class="terminal-header-space" aria-hidden="true"></span>
              </div>

              <div class="terminal-content">
                <p class="terminal-command">
                  <span class="terminal-purple">$</span>
                  nixora deploy
                </p>

                <div class="terminal-output">
                  <p class="terminal-line line-one">
                    <span class="terminal-purple">✓</span>
                    Container built
                  </p>

                  <p class="terminal-line line-two">
                    <span class="terminal-purple">✓</span>
                    HTTPS SSL issued
                  </p>

                  <p class="terminal-line line-three">
                    <span class="terminal-purple">✓</span>
                    <span class="terminal-live">Live: </span>
                    <span class="terminal-url">
                      https://my-app.nixora.co.in
                    </span>
                  </p>
                </div>

                <div class="terminal-footer">
                  <span>nixora-cli</span>

                  <span class="terminal-ready">
                    <span class="ready-dot"></span>
                    ready
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- NEXT -->
    <div class="roadmap-stage next-stage" data-reveal>
      <div class="roadmap-stage-heading">
        <p class={sectionLabel}>
          <span></span>
          Next
        </p>
      </div>

      <div class={`${cardStyle} next-card`} data-reveal>
        <span class="card-status" aria-hidden="true"></span>

        <div class="next-grid">
          <!-- Copy -->
          <div class="roadmap-copy">
            <p class="roadmap-group">{next.group}</p>

            <h3>{next.title}</h3>

            <p class="roadmap-description">
              {next.description}
            </p>

            <div class="roadmap-tags">
              {next.tags.map((tag) => (
                <span class={`${tagStyle} active-tag`} data-reveal>
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Agent flow -->
          <div class="agent-flow-panel">
            <div class="agent-flow">
              <div class="agent-flow-item" data-reveal>
                <p>MCP Agent</p>
              </div>

              <span class="flow-arrow" aria-hidden="true">
                <span class="arrow-right">→</span>
                <span class="arrow-down">↓</span>
              </span>

              <div class="agent-flow-item" data-reveal>
                <p>Permissions</p>
              </div>

              <span class="flow-arrow" aria-hidden="true">
                <span class="arrow-right">→</span>
                <span class="arrow-down">↓</span>
              </span>

              <div class="agent-flow-item" data-reveal>
                <p>Audit Log</p>
              </div>
            </div>

            <p class="agent-flow-caption">
              Agent → Nixora → Infrastructure
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- LATER -->
    <div class="roadmap-stage later-stage" data-reveal>
      <div class="roadmap-stage-heading">
        <p class={sectionLabel}>
          <span></span>
          Later
        </p>
      </div>

      <div class="later-cards">
        {later.map((item) => (
          <div class={`${cardStyle} later-card`} data-reveal>
            <span class="later-status" aria-hidden="true"></span>

            <div class="later-grid">
              <!-- Title and description -->
              <div class="later-copy">
                <p class="roadmap-group">{item.group}</p>

                <h3>{item.title}</h3>

                <p class="roadmap-description">
                  {item.description}
                </p>
              </div>

              <!-- Tags and special visuals -->
              <div class="later-features">
                <div class="roadmap-tags">
                  {item.tags.map((tag) => (
                    <span class={`${tagStyle} later-tag`} data-reveal>
                      {tag}
                    </span>
                  ))}
                </div>

                <!-- Scaling & Optimization -->
                {item.group === "GROUP 04" && (
                  <div class="feature-mini-grid">
                    {[
                      ["⚡", "Auto-scale"],
                      ["🌙", "Auto-sleep"],
                      ["🧹", "Auto-retire"],
                      ["💡", "Cost Opt"],
                    ].map(([icon, label]) => (
                      <div class="feature-mini" data-reveal>
                        <span>{icon}</span>
                        <p>{label}</p>
                      </div>
                    ))}
                  </div>
                )}

                <!-- Governance & Systems -->
                {item.group === "GROUP 05" && (
                  <div class="governance-flow">
                    <span class="governance-agent" data-reveal>
                      Agent 1
                    </span>

                    <span class="governance-agent" data-reveal>
                      Agent 2
                    </span>

                    <span class="governance-arrow" aria-hidden="true">
                      →
                    </span>

                    <span class="governance-system" data-reveal>
                      System Governance
                    </span>
                  </div>
                )}

                <!-- Platform & Ecosystem -->
                {item.group === "GROUP 06" && (
                  <div class="platform-mini-grid">
                    {["SDKs", "APIs", "Plugins", "Marketplace"].map(
                      (label) => (
                        <div class="platform-mini" data-reveal>
                          {label}
                        </div>
                      ),
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const revealElements = document.querySelectorAll("[data-reveal]");

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion) {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  } else {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.2,
        rootMargin: "0px 0px -40px 0px",
      },
    );

    revealElements.forEach((element) => {
      observer.observe(element);
    });
  }
</script>

<style>
