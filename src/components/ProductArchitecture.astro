
---
const ACCENT = "#a78bfa";

const today = {
  group: "GROUP 01",
  title: "Deploy & Diagnose",
  description:
    "Use Nixora’s CLI to deploy applications and diagnose deployment failures to understand what went wrong and identify what needs to be fixed.",
  tags: [
    "CLI",
    "Automated deployment",
    "Diagnose failed deploys",
    "Hosting",
    "HTTPS",
    "Shareable URLs",
  ],
};

const next = {
  group: "GROUP 02",
  title: "Agent Access & MCP",
  description:
    "Planned MCP integration will let compatible AI coding agents request deployments directly through Nixora, with per-agent permissions, audit trails, and structured access controls. The goal is to make Nixora a deployment target for AI-powered development workflows while keeping agent actions governed and traceable. A web dashboard is also a planned platform capability to support broader operational visibility.",
  tags: [
    "MCP-based deployment workflows",
    "AI coding-agent deployment requests",
    "Per-agent permissions",
    "Audit trail",
    "Compatible AI coding agents",
    "MCP server for agents",
    "Web dashboard",
    "Governed agent access",
  ],
};

const later = [
  {
    group: "GROUP 03",
    title: "Monitoring & Observability",
    description:
      "Planned monitoring and observability for applications and AI agents, including evaluation of task completion, tool usage, policy compliance, failure handling, latency, and execution costs to help teams understand reliability and operational health.",
    tags: [
      "Comprehensive monitoring & observability",
      "Continuous monitoring",
      "Agent testing & evaluation",
      "Task completion & success",
      "Tool usage & correctness",
      "Policy compliance evaluation",
      "Failure handling & reliability",
      "Latency & execution costs",
      "Cost controls",
      "Telemetry analytics",
    ],
  },
  {
    group: "GROUP 04",
    title: "Scaling & Optimization",
    description:
      "Planned automated scaling, resource optimization, load balancing, and infrastructure adaptation as workloads grow, helping teams manage demand while controlling cost and operational complexity.",
    tags: [
      "Automated scaling & load balancing",
      "Autonomous scaling",
      "Resource optimization",
      "Cost controls",
      "Workload management",
      "Infrastructure adaptation",
    ],
  },
  {
    group: "GROUP 05",
    title: "Governance & Lifecycle Operations",
    description:
      "Planned governance for AI agent operations, full lifecycle management, permissions, policy enforcement, and unified control across multi-agent systems and supported workloads.",
    tags: [
      "Multi-agent systems",
      "Full lifecycle management",
      "Agent lifecycle",
      "Governance across supported workloads",
      "Security & governance",
      "Policy enforcement",
      "Fleet management",
      "Permissions & control",
    ],
  },
  {
    group: "GROUP 06",
    title: "Platform & Infrastructure Integrations",
    description:
      "Planned platform growth across multiple infrastructure providers, CI/CD and release workflows, REST APIs, SDKs, and no-code tooling, with a broader focus on deployment, operations, and lifecycle management across supported environments.",
    tags: [
      "Multiple infrastructure providers",
      "CI/CD workflows",
      "Release management",
      "REST APIs & SDKs",
      "No-code web interface",
      "Multi-cloud support",
      "Infrastructure integrations",
    ],
  },
];

const scalingVisuals = [
  { icon: "⚡", label: "Auto-scale" },
  { icon: "⇄", label: "Load balancing" },
  { icon: "◫", label: "Resource opt." },
  { icon: "💡", label: "Cost controls" },
];

const integrationVisuals = [
  "CI/CD",
  "Release mgmt.",
  "APIs & SDKs",
  "Multi-cloud",
];
---

<section class="roadmap-section">
  <div class="roadmap-background" aria-hidden="true"></div>

  <div class="roadmap-container">
    <div class="roadmap-intro" data-reveal>
      <h2>Where Nixora is going</h2>
      <p>
        Nixora’s current product focus is CLI-based deployment for
        applications and deployment failure diagnosis. The roadmap extends
        beyond today’s deployment workflow toward MCP-based AI coding-agent
        access, monitoring and observability, scaling and resource
        optimization, lifecycle management, governance, multi-cloud and
        infrastructure integrations, and the broader operational control of
        AI-generated software and agents.
      </p>
    </div>

    <ol class="roadmap-list">
      <!-- TODAY -->
      <li class="roadmap-item">
        <div class="roadmap-period" data-reveal>
          <p class="period-label">
            <span class="period-line"></span>
            Today
          </p>
        </div>

        <article class="roadmap-card today-card" data-reveal>
          <span class="roadmap-status roadmap-status-active" aria-hidden="true"></span>

          <div class="today-grid">
            <div class="today-content">
              <p class="group-label">{today.group}</p>
              <h3>{today.title}</h3>
              <p class="group-description">{today.description}</p>

              <div class="tags-list">
                {today.tags.map((tag, index) => (
                  <span
                    class="roadmap-tag roadmap-tag-active"
                    data-reveal
                    style={`--reveal-delay: ${400 + index * 80}ms`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="terminal-area">
              <div class="terminal-window">
                <div class="terminal-header">
                  <div class="terminal-dots">
                    <span class="terminal-dot red"></span>
                    <span class="terminal-dot yellow"></span>
                    <span class="terminal-dot green"></span>
                  </div>

                  <span class="terminal-title">nixora — bash</span>
                  <span class="terminal-spacer" aria-hidden="true"></span>
                </div>

                <div class="terminal-content">
                  <p class="terminal-command">
                    <span class="terminal-prompt">$</span>
                    nixora deploy
                  </p>

                  <div class="terminal-output">
                    <p class="terminal-line terminal-line-one">
                      <span class="terminal-check">✓</span>
                      Container built
                    </p>

                    <p class="terminal-line terminal-line-two">
                      <span class="terminal-check">✓</span>
                      HTTPS SSL issued
                    </p>

                    <p class="terminal-line terminal-line-three">
                      <span class="terminal-check">✓</span>
                      <span class="terminal-live">Live: </span>
                      <span class="terminal-url">https://my-app.nixora.co.in</span>
                    </p>
                  </div>

                  <div class="terminal-footer">
                    <span>nixora-cli</span>
                    <span class="terminal-ready">
                      <span class="ready-indicator"></span>
                      ready
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      </li>

      <!-- ROADMAP AVAILABILITY NOTE -->
      <li class="roadmap-note-item">
        <div class="roadmap-availability-note" data-reveal>
          <p class="availability-title">Planned roadmap capabilities</p>
          <p class="availability-description">
            The capabilities in the Next and Later sections are part of the
            broader roadmap and should not be assumed to be available today.
          </p>
        </div>
      </li>

      <!-- NEXT -->
      <li class="roadmap-item">
        <div class="roadmap-period" data-reveal>
          <p class="period-label">
            <span class="period-line"></span>
            Next
          </p>
        </div>

        <article class="roadmap-card next-card" data-reveal>
          <span class="roadmap-status roadmap-status-active" aria-hidden="true"></span>

          <div class="roadmap-content-grid">
            <div class="roadmap-copy">
              <p class="group-label">{next.group}</p>
              <h3>{next.title}</h3>
              <p class="group-description">{next.description}</p>
            </div>

            <div class="roadmap-visual-content">
              <div class="tags-list">
                {next.tags.map((tag, index) => (
                  <span
                    class="roadmap-tag roadmap-tag-active"
                    data-reveal
                    style={`--reveal-delay: ${400 + index * 80}ms`}
                  >
                    {tag}
                  </span>
                ))}
              </div>

              <div class="agent-flow">
                <div class="agent-flow-grid">
                  <div class="agent-flow-node" data-reveal>
                    <p>MCP Agent</p>
                  </div>

                  <span class="agent-flow-arrow" aria-hidden="true">→</span>

                  <div class="agent-flow-node" data-reveal>
                    <p>Permissions</p>
                  </div>

                  <span class="agent-flow-arrow" aria-hidden="true">→</span>

                  <div class="agent-flow-node" data-reveal>
                    <p>Audit Log</p>
                  </div>
                </div>

                <p class="agent-flow-caption">
                  Agent → Nixora → Infrastructure
                </p>
              </div>
            </div>
          </div>
        </article>
      </li>

      <!-- LATER -->
      <li class="roadmap-item">
        <div class="roadmap-period" data-reveal>
          <p class="period-label">
            <span class="period-line"></span>
            Later
          </p>
        </div>

        <div class="later-groups">
          {later.map((item) => (
            <article class="roadmap-card later-card" data-reveal>
              <span class="roadmap-status roadmap-status-later" aria-hidden="true"></span>

              <div class="roadmap-content-grid">
                <div class="roadmap-copy">
                  <p class="group-label">{item.group}</p>
                  <h3>{item.title}</h3>
                  <p class="group-description">{item.description}</p>
                </div>

                <div class="roadmap-visual-content">
                  <div class="tags-list">
                    {item.tags.map((tag, index) => (
                      <span
                        class="roadmap-tag roadmap-tag-later"
                        data-reveal
                        style={`--reveal-delay: ${400 + index * 60}ms`}
                      >
                        {tag}
                      </span>
                    ))}
                  </div>

                  {item.group === "GROUP 04" && (
                    <div class="scaling-visuals">
                      {scalingVisuals.map((visual, index) => (
                        <div
                          class="scaling-visual-card"
                          data-reveal
                          style={`--reveal-delay: ${400 + index * 80}ms`}
                        >
                          <span class="scaling-icon">{visual.icon}</span>
                          <p>{visual.label}</p>
                        </div>
                      ))}
                    </div>
                  )}

                  {item.group === "GROUP 05" && (
                    <div class="governance-visual">
                      <span class="governance-node" data-reveal>Agent 1</span>
                      <span class="governance-node" data-reveal>Agent 2</span>
                      <span class="governance-arrow" aria-hidden="true" data-reveal>→</span>
                      <span class="governance-system" data-reveal>
                        System Governance
                      </span>
                    </div>
                  )}

                  {item.group === "GROUP 06" && (
                    <div class="integration-visuals">
                      {integrationVisuals.map((label, index) => (
                        <div
                          class="integration-visual-card"
                          data-reveal
                          style={`--reveal-delay: ${400 + index * 80}ms`}
                        >
                          {label}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </li>
    </ol>

    <p class="roadmap-closing" data-reveal>
      The product will expand as capabilities are implemented, validated,
      and tested with users.
    </p>
  </div>
</section>

<style>
  .roadmap-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 96px 0;
    color: #fff;

  }



  .roadmap-container {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    box-sizing: border-box;
  }

  /* Heading */
  .roadmap-intro {
    width: 100%;
    max-width: 768px;
    margin: 0 auto;
    text-align: center;
  }

  .roadmap-intro h2 {
    margin: 0;
    color: #fff;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .roadmap-intro > p {
    max-width: 672px;
    margin: 20px auto 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 16px;
    line-height: 1.9;
  }

  /* Roadmap list */
  .roadmap-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-item {
    margin-top: 48px;
  }

  .roadmap-period {
    margin-bottom: 16px;
  }

  .period-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
     color: #a78bfa;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .period-line {
    width: 24px;
    height: 1px;
    flex-shrink: 0;
  color: #a78bfa;
  }

  /* Shared cards */
  .roadmap-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 16px;
    background: #0d0d0f;
    transition:
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  .roadmap-card:hover {
    border-color: rgba(167, 139, 250, 0.4);
  }

  .today-card {
    box-shadow: 0 20px 70px rgba(167, 139, 250, 0.08);
  }

 .roadmap-status {
  position: absolute;
  top: 24px;
  right: 24px;
  z-index: 2;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #a78bfa;
  box-shadow: 0 0 8px rgba(167, 139, 250, 0.5);
}


.roadmap-status-later {
  background: rgba(255, 255, 255, 0.3);
  box-shadow: none;
  transition:
    background 0.3s ease,
    box-shadow 0.3s ease;
}


.later-card:hover .roadmap-status-later {
  background: #a78bfa;
  box-shadow: 0 0 8px rgba(167, 139, 250, 0.5);
}

  /* Group content */
  .group-label {
    margin: 0;
     color: #a78bfa;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .roadmap-card h3 {
    margin: 12px 0 0;
    color: #fff;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .group-description {
    max-width: 640px;
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 14px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  /* Tags */
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 8px;
  }

  .roadmap-tag {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 6px 12px;
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 8px;
    background: rgba(167, 139, 250, 0.075);
    font-size: 12px;
    line-height: 20px;
    overflow-wrap: anywhere;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .roadmap-tag-active {
    color: #fff;
  }

  .roadmap-tag-later {
    color: rgba(255, 255, 255, 0.72);
  }

.roadmap-card:hover .roadmap-tag {
  border-color: rgba(167, 139, 250, 0.38);
  background: rgba(167, 139, 250, 0.085);
}

  /* Today */
  .today-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
  }

  .today-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 40px;
  }

  .today-content .tags-list {
    margin-top: 24px;
  }

  /* Terminal */
  .terminal-area {
    display: flex;
    min-width: 0;
    align-items: center;
    padding: 32px;
    border-top: 1px solid rgba(167, 139, 250, 0.15);
    background: #0d0d0f;
  }

  .terminal-window {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 8px;
    background: #09090b;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 12px 20px;
    border-bottom: 1px solid rgba(167, 139, 250, 0.18);
    background: rgba(167, 139, 250, 0.025);
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .terminal-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .terminal-dot.red {
    background: #ff5f57;
  }

  .terminal-dot.yellow {
    background: #febc2e;
  }

  .terminal-dot.green {
    background: #28c840;
  }

  .terminal-title {
    margin-left: auto;
    margin-right: -40px;
    color: rgba(255, 255, 255, 0.45);
    font-family: monospace;
    font-size: 11px;
  }

  .terminal-spacer {
    width: 40px;
    flex-shrink: 0;
  }

  .terminal-content {
    padding: 24px;
    font-family: monospace;
    font-size: 12px;
  }

  .terminal-command {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    overflow-wrap: anywhere;
  }

  .terminal-prompt {
    margin-right: 8px;
   color: #a78bfa;
  }

  .terminal-output {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.6);
  }

  .terminal-line {
    margin: 0;
    overflow-wrap: anywhere;
    opacity: 0;
    animation: terminal-line-show 3.6s ease-in-out infinite;
  }

  .terminal-line-one {
    animation-delay: 0.3s;
  }

  .terminal-line-two {
    animation-delay: 1.1s;
  }

  .terminal-line-three {
    animation-delay: 1.9s;
  }

  .terminal-check {
    margin-right: 8px;
     color: #a78bfa;
  }

  .terminal-live {
    color: rgba(255, 255, 255, 0.8);
  }

  .terminal-url {
    color: #a78bfa;
    overflow-wrap: anywhere;
  }

  @keyframes terminal-line-show {
    0% {
      opacity: 0;
      transform: translateY(5px);
    }

    15%, 75% {
      opacity: 1;
      transform: translateY(0);
    }

    100% {
      opacity: 0;
      transform: translateY(-3px);
    }
  }

  .terminal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 24px -24px 0;
    padding: 12px 24px 0;
    border-top: 1px solid rgba(167, 139, 250, 0.18);
    color: rgba(255, 255, 255, 0.35);
    font-size: 10px;
  }

  .terminal-ready {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ready-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #28c840;
    box-shadow: 0 0 7px rgba(40, 200, 64, 0.5);
    animation: ready-pulse 2.5s ease-in-out infinite;
  }

  @keyframes ready-pulse {
    0%, 100% {
      box-shadow: 0 0 3px rgba(40, 200, 64, 0.2);
    }

    50% {
      box-shadow: 0 0 9px rgba(40, 200, 64, 0.65);
    }
  }

  /* Availability note */
  .roadmap-note-item {
    margin-top: 40px;
  }

  .roadmap-availability-note {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 16px;
    border-left: 2px solid rgba(167, 139, 250, 0.55);
  }

  .availability-title {
    margin: 0;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
  }

  .availability-description {
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 14px;
    line-height: 1.7;
  }

  /* Next and Later shared layout */
  .roadmap-content-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: 40px;
    padding: 32px;
  }

  .roadmap-copy {
    min-width: 0;
  }

  .roadmap-visual-content {
    min-width: 0;
    padding-left: 32px;
    border-left: 1px solid rgba(167, 139, 250, 0.15);
  }

  .roadmap-visual-content > .tags-list {
    align-items: flex-start;
  }

  /* Agent flow */
  .agent-flow {
    margin-top: 20px;
    padding: 20px;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 8px;
    background: rgba(167, 139, 250, 0.055);
  }

  .agent-flow-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 8px;
  }

  .agent-flow-node {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 12px 8px;
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 8px;
    background: rgba(167, 139, 250, 0.09);
    text-align: center;
  }

  .agent-flow-node p {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .agent-flow-arrow {
   color: #a78bfa;
    font-size: 16px;
    text-align: center;
  }

  .agent-flow-caption {
    margin: 20px 0 0;
    color: rgba(255, 255, 255, 0.45);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Later groups */
  .later-groups {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

 .later-card {
  padding: 0;
}

  /* Scaling visual */
  .scaling-visuals {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 20px;
  }

  .scaling-visual-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 6px;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 8px;

    text-align: center;
   
  }
  

 .scaling-visual-card:hover,
.integration-visual-card:hover {

}

  .scaling-icon {
    color: var(--roadmap-accent);
    font-size: 14px;
  }

  .scaling-visual-card p {
    margin: 4px 0 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  /* Governance visual */
  .governance-visual {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
  }

  .governance-node,
  .governance-system {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 8px;
    background: rgba(167, 139, 250, 0.08);
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
  }

  .governance-arrow {
     color: #a78bfa;
    font-size: 16px;
    animation: governance-arrow-move 1.8s ease-in-out infinite;
  }

  @keyframes governance-arrow-move {
    0%, 100% {
      transform: translateX(0);
    }

    50% {
      transform: translateX(4px);
    }
  }

  .governance-system {
  border: 1px solid rgba(167, 139, 250, 0.2);
    background: rgba(167, 139, 250, 0.14);
    color: rgba(255, 255, 255, 0.9);
  }

  /* Integrations visual */
  .integration-visuals {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 20px;
  }

  .integration-visual-card {
