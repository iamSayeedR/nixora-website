  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .terminal-line {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .ready-indicator,
    .governance-arrow {
