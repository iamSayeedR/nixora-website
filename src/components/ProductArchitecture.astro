    0%,
    100% {
      opacity: 0.5;
      box-shadow: 0 0 3px rgb(40 200 64 / 25%);
    }

    50% {
      opacity: 1;
      box-shadow: 0 0 8px rgb(40 200 64 / 65%);
    }
  }

  @keyframes governance-arrow {
    0%,
    100% {
      transform: translateX(0);
    }

    50% {
      transform: translateX(4px);
    }
  }

  @media (min-width: 640px) {
