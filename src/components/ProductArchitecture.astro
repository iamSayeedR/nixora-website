  /* Scroll reveal */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Staggered tag reveal */
.roadmap-tags > [data-reveal] {
  transition-delay: 0s;
}

.roadmap-tags > [data-reveal]:nth-child(1) {
  transition-delay: 0.1s;
}

.roadmap-tags > [data-reveal]:nth-child(2) {
  transition-delay: 0.2s;
}

.roadmap-tags > [data-reveal]:nth-child(3) {
  transition-delay: 0.3s;
}

.roadmap-tags > [data-reveal]:nth-child(4) {
  transition-delay: 0.4s;
}

.roadmap-tags > [data-reveal]:nth-child(5) {
  transition-delay: 0.5s;
}

.roadmap-tags > [data-reveal]:nth-child(6) {
  transition-delay: 0.6s;
}

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes terminal-line {
    0% {
      opacity: 0;
      transform: translateY(5px);
    }

    12%,
    65% {
      opacity: 1;
      transform: translateY(0);
    }

    85%,
    100% {
      opacity: 0;
