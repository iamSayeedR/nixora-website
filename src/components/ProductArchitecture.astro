
---
const ACCENT = "#a78bfa";

const today = {
  group: "GROUP 01",
  title: "Deploy & Diagnose",
  description:
    "Use Nixora’s CLI to deploy applications and diagnose deployment failures to understand what went wrong and identify what needs to be fixed.",
  tags: [
    "CLI",
    "Automated deployment",
    "Diagnose failed deploys",
    "Hosting",
    "HTTPS",
    "Shareable URLs",
  ],
};

const next = {
  group: "GROUP 02",
  title: "Agent Access & MCP",
  description:
    "Planned MCP integration will let compatible AI coding agents request deployments directly through Nixora, with per-agent permissions, audit trails, and structured access controls. The goal is to make Nixora a deployment target for AI-powered development workflows while keeping agent actions governed and traceable.",
  tags: [
    "MCP-based deployment workflows",
    "AI coding-agent deployment requests",
    "Per-agent permissions",
    "Audit trail",
    "Compatible AI coding agents",
    "MCP server for agents",
    "Governed agent access",
  ],
};

const later = [
  {
  group: "GROUP 03",
  title: "Monitoring & Observability",
  description:
    "Planned monitoring and observability for applications and AI agents, including monitoring application health, identifying operational problems, inspecting logs and diagnostic information, explaining failures and their likely causes, and recommending corrective actions. Agent testing and evaluation will cover task completion and success rates, tool usage and tool-call correctness, policy compliance, failure handling and reliability, latency and execution costs, and resistance to prompt injection and unsafe behavior. Longer term, Nixora aims to execute authorized remediation and verify the results.",
  tags: [
    "Monitoring application health",
    "Operational problem detection",
    "Logs & diagnostic information",
    "Failure explanations & likely causes",
    "Recommended corrective actions",
    "Agent testing & evaluation",
    "Task completion & success rates",
    "Tool usage & correctness",
    "Policy compliance",
    "Failure handling & reliability",
    "Latency & execution costs",
    "Prompt-injection & unsafe-behavior resistance",
    "Authorized remediation",
    "Remediation verification",
  ],
},
  {
  group: "GROUP 04",
  title: "Scaling & Optimization",
  description:
    "Planned continuous optimization, workload scaling, health checks, resource management, load balancing, controlled recovery from failures, and infrastructure cost visibility. The broader optimization direction includes improving infrastructure cost, application performance, agent execution cost, resource utilization, reliability, and deployment efficiency while balancing cost with performance and security. Supporting these capabilities will require appropriate infrastructure integrations and orchestration.",
  tags: [
    "Continuous optimization",
    "Workload scaling",
    "Health checks",
    "Resource management",
    "Load balancing",
    "Controlled failure recovery",
    "Infrastructure cost visibility",
    "Application performance",
    "Agent execution cost",
    "Resource utilization",
    "Reliability",
    "Deployment efficiency",
    "Cost, performance & security balance",
  ],
},
  {
    group: "GROUP 05",
    title: "Governance & Lifecycle Operations",
    description:
      "Planned deployment and lifecycle management of AI agents as production workloads, alongside governance, permissions, policy enforcement, and unified control across multi-agent systems and supported workloads.",
    tags: [
      "Multi-agent systems",
      "Full lifecycle management",
      "Agent lifecycle",
      "Governance across supported workloads",
      "Security & governance",
      "Policy enforcement",
      "Fleet management",
      "Permissions & control",
    ],
  },
  {
  group: "GROUP 06",
  title: "Platform & Infrastructure Integrations",
  description:
    "Planned expansion of platform and infrastructure integrations, including future support for infrastructure providers, CI/CD and release workflows, REST APIs, SDKs, and no-code tooling. These integrations are intended to extend deployment, operations, and lifecycle management across supported environments.",
  tags: [
    "Planned infrastructure integrations",
    "Planned CI/CD workflows",
    "Release management",
    "REST APIs & SDKs",
    "No-code web interface",
    "Infrastructure provider integrations",
    "Multi-cloud support",
    "Platform integrations",
  ],
},
  {
    group: "GROUP 07",
    title: "Agent Intelligence & Orchestration",
    description:
      "Understand how AI agents interact with each other, use tools, access services, and depend on shared infrastructure. Coordinate agent relationships, dependencies, permissions, and interactions across multi-agent systems.",
    tags: [
      "Agent intelligence",
      "Multi-agent orchestration",
      "Agent dependency mapping",
      "MCP tool awareness",
      "Tool & API dependencies",
      "Agent interaction mapping",
      "Permission awareness",
      "Dependency monitoring",
    ],
  },
  {
    group: "GROUP 08",
    title: "Autonomous Operations & Nixora Autopilot",
    description:
      "Nixora Autopilot is designed to understand application and agent environments, detect operational issues, identify likely root causes, predict infrastructure risks, recommend actions, and execute authorized remediation with continuous verification.",
    tags: [
      "Nixora Autopilot",
      "Autonomous operations",
      "Cross-layer intelligence",
      "Autonomous self-healing",
      "Predictive infrastructure intelligence",
      "Root cause analysis",
      "Automated remediation",
      "Continuous verification",
      "Operational Intelligence Profiles",
      "Human approval controls",
    ],
  },
];

const scalingVisuals = [
  { icon: "⚡", label: "Auto-scale" },
  { icon: "⇄", label: "Load balancing" },
  { icon: "◫", label: "Resources" },
  { icon: "💡", label: "Cost visibility" },
];

const releaseVisuals = [
  "Application updates",
  "Release verification",
  "Rollback",
  "Retirement",
];

const integrationVisuals = [
  "CI/CD workflows",
  "Release mgmt.",
  "APIs & SDKs",
  "Infrastructure",
];

const intelligenceVisuals = [
  "Agents",
  "Tools & MCP",
  "Dependencies",
  "Permissions",
];

const autopilotSteps = [
  "Detect",
  "Diagnose",
  "Recommend",
  "Verify",
];

const companionModes = [
  {
    icon: "message",
    title: "Advice-only",
    description:
      "Provides recommendations and guidance while the user remains in control of every action.",
  },
  {
    icon: "route",
    title: "Guided",
    description:
      "Helps users work through operational tasks with guidance and approval before actions are taken.",
  },
  {
    icon: "loop",
    title: "Autonomous",
    description:
      "Can carry out authorized actions within defined permissions and operational boundaries.",
  },
];

const companionTags = [
  "Advice Mode",
  "Guided Mode",
  "Autonomous Mode",
  "AI-powered troubleshooting",
  "Recommended actions",
  "Controlled execution",
 
];

const companionDescription =
  "An intelligent operational assistant that helps developers understand issues, make informed decisions, and manage applications and agents. Supports advisory guidance, step-by-step execution, and policy-controlled autonomous actions.";
---

<section class="roadmap-section">
  <div class="roadmap-background" aria-hidden="true"></div>

  <div class="roadmap-container">
    <div class="roadmap-intro" data-reveal>
      <h2>Where Nixora is going</h2>
      <p>
        Nixora’s current product focus is CLI-based deployment for
        applications and deployment failure diagnosis. The roadmap extends
        beyond today’s deployment workflow toward MCP-based AI coding-agent
        access, monitoring and observability, scaling and reliability,
        lifecycle management, infrastructure governance, agent intelligence,
        and autonomous operations.
      </p>
    </div>

    <ol class="roadmap-list">
      <!-- TODAY -->
      <li class="roadmap-item">
        <div class="roadmap-period" data-reveal>
          <p class="period-label">
            <span class="period-line"></span>
            Today
          </p>
        </div>

        <article class="roadmap-card today-card" data-reveal>
          <span class="roadmap-status roadmap-status-active" aria-hidden="true"></span>

          <div class="today-grid">
            <div class="today-content">
              <p class="group-label">{today.group}</p>
              <h3>{today.title}</h3>
              <p class="group-description">{today.description}</p>

              <div class="tags-list">
                {today.tags.map((tag, index) => (
                  <span
                    class="roadmap-tag roadmap-tag-active"
                    data-reveal
                    style={`--reveal-delay: ${400 + index * 80}ms`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="terminal-area">
              <div class="terminal-window">
                <div class="terminal-header">
                  <div class="terminal-dots">
                    <span class="terminal-dot red"></span>
                    <span class="terminal-dot yellow"></span>
                    <span class="terminal-dot green"></span>
                  </div>

                  <span class="terminal-title">nixora - bash</span>
                  <span class="terminal-spacer" aria-hidden="true"></span>
                </div>

                <div class="terminal-content">
                  <p class="terminal-command">
                    <span class="terminal-prompt">$</span>
                    nixora deploy
                  </p>

                  <div class="terminal-output">
                    <p class="terminal-line terminal-line-one">
                      <span class="terminal-check">✓</span>
                      Container built
                    </p>

                    <p class="terminal-line terminal-line-two">
                      <span class="terminal-check">✓</span>
                      HTTPS SSL issued
                    </p>

                    <p class="terminal-line terminal-line-three">
                      <span class="terminal-check">✓</span>
                      <span class="terminal-live">Live: </span>
                      <span class="terminal-url">https://my-app.nixora.co.in</span>
                    </p>
                  </div>

                  <div class="terminal-footer">
                    <span>nixora-cli</span>
                    <span class="terminal-ready">
                      <span class="ready-indicator"></span>
                      ready
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      </li>

      <!-- ROADMAP AVAILABILITY NOTE -->
      <li class="roadmap-note-item">
        <div class="roadmap-availability-note" data-reveal>
          <p class="availability-title">Planned roadmap capabilities</p>
          <p class="availability-description">
            The capabilities in the Next and Later sections are part of the
            broader roadmap and should not be assumed to be available today.
          </p>
        </div>
      </li>

      <!-- NEXT -->
      <li class="roadmap-item">
        <div class="roadmap-period" data-reveal>
          <p class="period-label">
            <span class="period-line"></span>
            Next
          </p>
        </div>

        <article class="roadmap-card next-card" data-reveal>
          <span class="roadmap-status roadmap-status-active" aria-hidden="true"></span>

          <div class="roadmap-content-grid">
            <div class="roadmap-copy">
              <p class="group-label">{next.group}</p>
              <h3>{next.title}</h3>
              <p class="group-description">{next.description}</p>
            </div>

            <div class="roadmap-visual-content">
              <div class="tags-list">
                {next.tags.map((tag, index) => (
                  <span
                    class="roadmap-tag roadmap-tag-active"
                    data-reveal
                    style={`--reveal-delay: ${400 + index * 80}ms`}
                  >
                    {tag}
                  </span>
                ))}
              </div>

              <div class="agent-flow">
                <div class="agent-flow-grid">
                  <div class="agent-flow-node" data-reveal>
                    <p>MCP Agent</p>
                  </div>

                  <span class="agent-flow-arrow" aria-hidden="true">→</span>

                  <div class="agent-flow-node" data-reveal>
                    <p>Permissions</p>
                  </div>

                  <span class="agent-flow-arrow" aria-hidden="true">→</span>

                  <div class="agent-flow-node" data-reveal>
                    <p>Audit Log</p>
                  </div>
                </div>

                <p class="agent-flow-caption">
                  Agent → Nixora → Infrastructure
                </p>
              </div>
            </div>
          </div>
        </article>
      </li>

      <!-- LATER -->
      <li class="roadmap-item">
        <div class="roadmap-period" data-reveal>
          <p class="period-label">
            <span class="period-line"></span>
            Later
          </p>
        </div>

        <div class="later-groups">
          {later.map((item) => (
            <article
              class={`roadmap-card later-card ${item.group === "GROUP 08" ? "autopilot-card" : ""}`}
              data-reveal
            >
              <span class="roadmap-status roadmap-status-later" aria-hidden="true"></span>

              <div class="roadmap-content-grid">
                <div class="roadmap-copy">
                  <p class="group-label">{item.group}</p>
                  <h3>{item.title}</h3>
                  <p class="group-description">{item.description}</p>

                  {/* Group 08: Autopilot tags and workflow on the left */}
                  {item.group === "GROUP 08" && (
                    <>
                      <div class="tags-list autopilot-tags">
                        {item.tags.map((tag, index) => (
                          <span
                            class="roadmap-tag roadmap-tag-later"
                            data-reveal
                            style={`--reveal-delay: ${400 + index * 60}ms`}
                          >
                            {tag}
                          </span>
                        ))}
                      </div>

                      <div class="autopilot-visual">
                        <p class="autopilot-flow-heading" data-reveal>
                          Autonomous Operations Workflow
                        </p>

                        <div class="autopilot-flow">
                          {autopilotSteps.map((step, index) => (
                            <>
                              <div
                                class="autopilot-step"
                                data-reveal
                                style={`--reveal-delay: ${400 + index * 80}ms`}
                              >
                              
                                <span>{step}</span>
                              </div>

                              {index !== autopilotSteps.length - 1 && (
                                <span class="autopilot-arrow" aria-hidden="true">
                                  →
                                </span>
                              )}
                            </>
                          ))}
                        </div>
                      </div>
                    </>
                  )}
                </div>

                <div class="roadmap-visual-content">
                  {/* Other groups keep their tags on the right */}
                  {item.group !== "GROUP 08" && (
                    <div class="tags-list">
                      {item.tags.map((tag, index) => (
                        <span
                          class="roadmap-tag roadmap-tag-later"
                          data-reveal
                          style={`--reveal-delay: ${400 + index * 60}ms`}
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  {item.group === "GROUP 04" && (
                    <div class="scaling-visuals">
                      {scalingVisuals.map((visual, index) => (
                        <div
                          class="scaling-visual-card"
                          data-reveal
                          style={`--reveal-delay: ${400 + index * 80}ms`}
                        >
                          <span class="scaling-icon">{visual.icon}</span>
                          <p>{visual.label}</p>
                        </div>
                      ))}
                    </div>
                  )}

                  {item.group === "GROUP 05" && (
                    <div class="governance-visual">
                      <span class="governance-node" data-reveal>Agent 1</span>
                      <span class="governance-node" data-reveal>Agent 2</span>
                      <span class="governance-arrow" aria-hidden="true" data-reveal>→</span>
                      <span class="governance-system" data-reveal>
                        System Governance
                      </span>
                    </div>
                  )}

                  {item.group === "GROUP 06" && (
                    <div class="integration-visuals">
                      {integrationVisuals.map((label, index) => (
                        <div
                          class="integration-visual-card"
                          data-reveal
                          style={`--reveal-delay: ${400 + index * 80}ms`}
                        >
                          {label}
                        </div>
                      ))}
                    </div>
                  )}

                  {item.group === "GROUP 07" && (
                    <div class="intelligence-visual">
                      {intelligenceVisuals.map((label, index) => (
                        <div
                          class="intelligence-visual-card"
                          data-reveal
                          style={`--reveal-delay: ${400 + index * 80}ms`}
                        >
                          <span class="intelligence-dot"></span>
                          {label}
                        </div>
                      ))}
                    </div>
                  )}

                  {/* Group 08: AI Companion stays separately on the right */}
                  {item.group === "GROUP 08" && (
                    <div class="companion-panel">
                      <div class="companion-heading" data-reveal>
                        <p class="companion-eyebrow">AI COMPANION</p>
                        <h4>Choose how Nixora assists</h4>
                      </div>

                      <p class="companion-description" data-reveal>
                        {companionDescription}
                      </p>

                      <div class="tags-list companion-tags">
                        {companionTags.map((tag, index) => (
                          <span
                            class="roadmap-tag roadmap-tag-later"
                            data-reveal
                            style={`--reveal-delay: ${400 + index * 60}ms`}
                          >
                            {tag}
                          </span>
                        ))}
                      </div>

                      <div class="companion-modes">
                        {companionModes.map((mode, index) => (
                          <div
                            class="companion-mode"
                            data-reveal
                            style={`--reveal-delay: ${400 + index * 80}ms`}
                          >
                            <span class="companion-icon">
                              {mode.icon === "message" && (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  width="24"
                                  height="24"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  aria-hidden="true"
                                >
                                  <path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" />
                                  <path d="M7 11h10" />
                                  <path d="M7 15h6" />
                                  <path d="M7 7h8" />
                                </svg>
                              )}

                              {mode.icon === "route" && (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  width="24"
                                  height="24"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  aria-hidden="true"
                                >
                                  <circle cx="6" cy="19" r="3" />
                                  <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" />
                                  <circle cx="18" cy="5" r="3" />
                                </svg>
                              )}

                              {mode.icon === "loop" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 12a8 8 0 0 1-13.66 5.66" />
                  <path d="M4 12a8 8 0 0 1 13.66-5.66" />
                  <path d="M18 3v4h-4" />
                  <path d="M6 21v-4h4" />
                  <path d="m9.5 12 2 2 3.5-4" />
                </svg>
              )}
                            </span>

                            <div class="companion-mode-content">
                              <h5>{mode.title}</h5>
                              <p>{mode.description}</p>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </li>
    </ol>

    <p class="roadmap-closing" data-reveal>
      The product will expand as capabilities are implemented, validated,
      and tested with users.
    </p>
  </div>
</section>

<style>
  .roadmap-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 96px 0;
    color: #fff;
  }

  .roadmap-container {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    box-sizing: border-box;
  }

  /* Heading */
  .roadmap-intro {
    width: 100%;
    max-width: 768px;
    margin: 0 auto;
    text-align: center;
  }

  /* Roadmap intro - slow and smooth reveal */
.roadmap-intro[data-reveal] {
  opacity: 0;
  transform: translate3d(0, 24px, 0);
  transition:
    opacity 1.5s cubic-bezier(0.22, 1, 0.36, 1),
    transform 1.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.roadmap-intro[data-reveal].is-visible {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}

  .roadmap-intro h2 {
    margin: 0;
    color: #fff;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .autopilot-flow-heading {
    margin: 0 0 16px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-align: center;
  }

  .roadmap-intro > p {
    max-width: 672px;
    margin: 20px auto 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 16px;
    line-height: 1.9;
  }

  /* Roadmap list */
  .roadmap-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-item {
    margin-top: 48px;
  }

  .roadmap-period {
    margin-bottom: 16px;
  }

 .period-label {
  color: #fff;
}



  /* Governance visual */
  .governance-visual {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
  }

  .governance-node,
  .governance-system {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 8px;
    background: rgba(167, 139, 250, 0.08);
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
  }

  .governance-arrow {
    color: #a78bfa;
    font-size: 16px;
    animation: governance-arrow-move 1.8s ease-in-out infinite;
  }

  @keyframes governance-arrow-move {
    0%, 100% {
      transform: translateX(0);
    }

    50% {
      transform: translateX(4px);
    }
  }

  .governance-system {
    border: 1px solid rgba(167, 139, 250, 0.2);
    background: rgba(167, 139, 250, 0.14);
    color: rgba(255, 255, 255, 0.9);
  }

  /* Shared cards */
  .roadmap-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 16px;
    background: #0d0d0f;
    transition:
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  .roadmap-card:hover {
    border-color: rgba(167, 139, 250, 0.4);
  }

  .today-card {
    box-shadow: 0 20px 70px rgba(167, 139, 250, 0.08);
  }

  .roadmap-status {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #a78bfa;
    box-shadow: 0 0 8px rgba(167, 139, 250, 0.5);
  }

  .roadmap-status-later {
    background: rgba(255, 255, 255, 0.3);
    box-shadow: none;
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .later-card:hover .roadmap-status-later {
    background: #a78bfa;
    box-shadow: 0 0 8px rgba(167, 139, 250, 0.5);
  }

  /* Group content */
  .group-label {
    margin: 0;
    color: #a78bfa;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .roadmap-card h3 {
    margin: 12px 0 0;
    color: #fff;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .group-description {
    max-width: 640px;
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 14px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  /* Tags */
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 8px;
  }

  .roadmap-tag {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 6px 12px;
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 8px;
    background: rgba(167, 139, 250, 0.075);
    font-size: 12px;
    line-height: 20px;
    overflow-wrap: anywhere;
    transition:
      background 0.3s ease,
      color 0.3s ease,
