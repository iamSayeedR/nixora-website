
---
const withoutSteps = [
  { title: "AI generates code", subtitle: "agent outputs" },
  { title: "Write Dockerfile", subtitle: "manual" },
  { title: "Debug ports", subtitle: "manual" },
  { title: "Deploy", subtitle: "manual" },
  { title: "App crashes", subtitle: "babysit" },
];

const withChecks = [
  "Container built automatically",
  "Compute provisioned",
  "HTTPS certificate issued",
  "Hosting provisioned",
];

const applicationTypes = [
  "Frontend applications",
  "Backend services",
  "APIs & web services",
  "Different languages & frameworks",
];
---

<section class="product-why-infra">
  <div class="background-tint"></div>

  <div class="infra-container">

    <!-- Intro -->
    <div class="section-intro" data-reveal>
      <h2>Why traditional infra fails AI code</h2>

      <p>
        AI generates apps faster than any team can manually configure,
        containerize, and maintain. Nixora automates the entire operations
        layer.
      </p>
    </div>

    <!-- Comparison -->
    <div class="comparison-wrapper" data-reveal>

      <!-- WITHOUT NIXORA -->
      <div class="comparison-section without-section">

        <div class="section-label" data-reveal>
          <span class="label-cross">×</span>

          <p>Without Nixora: manual, fragile</p>
        </div>

        <!-- Traditional flow -->
        <ul class="traditional-flow" aria-label="Without Nixora: manual, fragile">
          {withoutSteps.map((step, index) => (
            <li
              class="traditional-step"
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <div class:list={[
                "traditional-step-card",
                index === 0 ? "first-step" : "",
              ]}>
                <p class="step-title">{step.title}</p>
                <p class="step-subtitle">{step.subtitle}</p>
              </div>

              {index < withoutSteps.length - 1 && (
                <span class="traditional-arrow">→</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <div class="comparison-divider"></div>

      <!-- WITH NIXORA -->
      <div class="comparison-section with-section">

        <div class="with-background"></div>

        <div class="section-label with-label" data-reveal>
          <span class="label-check">✓</span>

          <p>With Nixora: automated deploy, hosting &amp; HTTPS</p>
        </div>

        <!-- Nixora flow -->
        <ol class="nixora-flow" aria-label="With Nixora: automated deploy, hosting and HTTPS">

          <!-- Input -->
          <li class="flow-input" data-reveal>
            <p class="input-label">AI-generated application</p>

            <p class="input-title">AI generates code</p>

            <p class="input-subtitle">agent outputs</p>
          </li>

          <!-- Arrow -->
          <li class="flow-arrow" aria-hidden="true">→</li>

          <!-- Command -->
          <li class="flow-command" data-reveal>
            <span>nixora deploy</span>
          </li>

          <!-- Arrow -->
          <li class="flow-arrow" aria-hidden="true">→</li>

          <!-- Result -->
          <li class="flow-result" data-reveal>
            <div class="result-heading">
              <span class="status-dot"></span>

              <p>Live &amp; running</p>
            </div>

            <div class="result-checks">
              {withChecks.map((item, index) => (
                <div
                  class="result-check"
                  data-reveal
                  style={`--reveal-delay: ${index * 70}ms`}
                >
                  <span>✓</span>
                  <p>{item}</p>
                </div>
              ))}
            </div>
          </li>

        </ol>
      </div>
    </div>

    <!-- Application scope -->
    <div class="application-scope" data-reveal>

      <div class="scope-intro">
        <p class="scope-label">Broader product direction</p>

        <h3>
          One operational layer for different kinds of software
        </h3>

        <p class="scope-description">
          Nixora&apos;s longer-term direction is to support applications and
          services built with different languages and frameworks, while
          reducing the manual work involved in deploying and operating them.
        </p>
      </div>

      <div class="application-types">
        {applicationTypes.map((type, index) => (
          <span
            class="application-type"
            data-reveal
            style={`--reveal-delay: ${index * 70}ms`}
          >
            {type}
          </span>
        ))}
      </div>
    </div>

    <!-- Diagnose context -->
    <p class="diagnose-context" data-reveal>
      Deployment is only one part of the workflow. When a deployment fails,
      Nixora&apos;s Diagnose capability is intended to help developers
      understand what went wrong and identify what needs attention.
    </p>

  </div>
</section>

<style>
  /* Main section */

  .product-why-infra {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 4rem 0;
   

  }

 

  .infra-container {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Intro */

  .section-intro {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .section-intro h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .section-intro > p {
    max-width: 42rem;
    margin: 1.25rem auto 0;
    color: rgb(255 255 255 / 65%);
    font-size: 1rem;
    line-height: 1.75;
  }

  /* Comparison wrapper */

  .comparison-wrapper {
    margin-top: 3rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 1rem;
    background: #0d0d0f;
    box-shadow: 0 24px 80px rgb(0 0 0 / 25%);
  }

  .comparison-section {
    position: relative;
    padding: 2rem 2.5rem;
  }

  .without-section {
    background: #0d0d0f;
  }

  .comparison-divider {
    height: 1px;
    background: rgb(255 255 255 / 10%);
  }

  /* Section labels */

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-label p {
    margin: 0;
    color: rgb(255 255 255 / 60%);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .label-cross {
    color: rgb(255 255 255 / 45%);
    font-size: 1.125rem;
    line-height: 1;
  }

  .label-check {
    color: #a78bfa;
    font-size: 1rem;
    line-height: 1;
  }

  /* Traditional flow */

  .traditional-flow,
  .nixora-flow {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .traditional-flow {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-top: 1.75rem;
  }

  .traditional-step {
    display: flex;
    flex: 1;
    align-items: stretch;
    min-width: 0;
  }

  .traditional-step-card {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    min-height: 5rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 0.75rem;
    background: #0d0d0f;
  }

  .traditional-step-card.first-step {
    border-color: rgb(255 255 255 / 15%);
  }

  .step-title {
    margin: 0;
    color: rgb(255 255 255 / 65%);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .first-step .step-title {
    color: rgb(255 255 255 / 80%);
  }

  .step-subtitle {
    margin: 0.25rem 0 0;
    color: rgb(255 255 255 / 40%);
    font-size: 0.75rem;
  }

  .traditional-arrow {
    display: none;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    color: rgb(255 255 255 / 25%);
    font-size: 1.125rem;
  }

  /* With Nixora */

  .with-section {
    isolation: isolate;
  }

  .with-background {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: rgb(125 87 239 / 4.5%);
  }

  .with-label {
    position: relative;
  }

  .with-label p {
    color: #a78bfa;
  }

  /* Nixora flow */

  .nixora-flow {
    position: relative;
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .flow-input,
  .flow-command,
  .flow-result {
    min-width: 0;
    padding: 1rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 8px;
    background: #0d0d0f;
  }

  .input-label {
    margin: 0;
    color: rgb(255 255 255 / 40%);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .input-title {
    margin: 0.375rem 0 0;
    color: rgb(255 255 255 / 80%);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .input-subtitle {
    margin: 0.25rem 0 0;
    color: rgb(255 255 255 / 40%);
    font-size: 0.75rem;
  }

  .flow-arrow {
    display: none;
    color: #a78bfa;
    font-size: 1.25rem;
  }

  .flow-command {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flow-command span {
    color: #a78bfa;
    font-size: 1rem;
    font-weight: 500;
  }

  /* Result */

  .result-heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .result-heading p {
    margin: 0;
    color: #fff;
    font-size: 1rem;
    font-weight: 500;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: #a78bfa;
    box-shadow: 0 0 10px rgb(125 87 239 / 65%);
  }

  .result-checks {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .result-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .result-check > span {
    color: #a78bfa;
    font-size: 0.875rem;
  }

  .result-check p {
    margin: 0;
    color: rgb(255 255 255 / 65%);
    font-size: 0.8125rem;
  }

  /* Application scope */

  .application-scope {
    max-width: 64rem;
    margin: 3rem auto 0;
  }

  .scope-intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
  }

  .scope-label {
    margin: 0;
    color: #a78bfa;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .scope-intro h3 {
    margin: 0;
    color: #fff;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .scope-description {
    max-width: 42rem;
    margin: 0 auto;
    color: rgb(255 255 255 / 55%);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .application-types {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .application-type {
    padding: 0.625rem 1rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 999px;
    background: rgb(255 255 255 / 2.5%);
    color: rgb(255 255 255 / 65%);
    font-size: 0.75rem;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .application-type:hover {
    border-color: rgb(167 139 250 / 50%);
    color: #fff;
  }

  /* Diagnose context */

  .diagnose-context {
    max-width: 42rem;
    margin: 2rem auto 0;
    color: rgb(255 255 255 / 50%);
    font-size: 0.875rem;
    line-height: 1.75;
    text-align: center;
  }

  /* Scroll reveal */

  [data-reveal] {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Tablet and desktop */

  @media (min-width: 640px) {
    .product-why-infra {
      padding: 5rem 0;
    }

    .infra-container {
      padding: 0 2rem;
    }

    .comparison-section {
      padding: 2rem;
    }

    .traditional-step-card {
      min-height: 5rem;
      padding: 0.75rem 1rem;
    }

    .traditional-arrow {
      display: flex;
    }

    .result-checks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.25rem;
      row-gap: 0.5rem;
    }

    .scope-intro h3 {
      font-size: 1.5rem;
    }

    .scope-description {
      font-size: 1rem;
    }

    .application-type {
      font-size: 0.875rem;
    }

    .diagnose-context {
      margin-top: 2.5rem;
      font-size: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .product-why-infra {
      padding: 6rem 0;
    }

    .infra-container {
      padding: 0 3rem;
    }

    .comparison-section {
      padding: 2.25rem 2.5rem;
    }

    .nixora-flow {
      grid-template-columns:
        0.8fr auto 0.8fr auto 1.6fr;
      align-items: center;
      gap: 1rem;
    }

    .flow-arrow {
      display: block;
    }

    .flow-command {
      padding: 1rem 1.25rem;
    }

    .flow-result {
      padding: 1rem 1.25rem;
    }
  }

  /* Smaller screens */

  @media (max-width: 639px) {
    .product-why-infra {
      padding: 4rem 0;
    }

    .infra-container {
      padding: 0 1.25rem;
    }

    .comparison-wrapper {
      margin-top: 2.5rem;
    }

    .comparison-section {
      padding: 1.75rem 1.25rem;
    }

    .section-label {
      gap: 0.625rem;
    }

    .section-label p {
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
    }

    .traditional-flow {
      flex-direction: column;
      gap: 0.5rem;
    }

    .traditional-step {
      flex-direction: column;
    }

    .traditional-step-card {
      min-height: 4.5rem;
      padding: 0.75rem 1rem;
    }

    .traditional-arrow {
      display: none;
    }

    .nixora-flow {
      gap: 0.875rem;
    }

    .flow-command {
      justify-self: center;
      width: fit-content;
      padding: 0.875rem 1.5rem;
    }

    .flow-result {
      padding: 1rem;
    }

    .result-checks {
      grid-template-columns: 1fr;
    }

    .application-scope {
      margin-top: 2.5rem;
    }

    .scope-intro h3 {
      font-size: 1.25rem;
    }

    .application-types {
      gap: 0.5rem;
    }

    .application-type {
      padding: 0.625rem 0.875rem;
      font-size: 0.75rem;
    }
  }

  /* Reduced motion */

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const revealElements = document.querySelectorAll(
    ".product-why-infra [data-reveal]"
  );

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (
    prefersReducedMotion ||
    !("IntersectionObserver" in window)
  ) {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  } else {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -30px 0px",
      }
    );

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });
  }
</script>
