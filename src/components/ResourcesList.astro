                    <div class="flex items-center justify-between border-b border-white/8 px-3 py-2.5 sm:px-4">
                      <span class="text-[10px] text-white/55">nixora - bash</span>
                      <span class="text-[9px] text-white/30">CLI</span>
                    </div>
                    <div class="space-y-3 px-3 py-4 font-mono text-[9px] min-[375px]:text-[10px] sm:px-4 sm:text-[11px]">
                      <div class="text-white/75"><span class="text-[#a78bfa]">$</span> nixora deploy</div>
                      <div class="text-white/45">Detecting application...</div>
