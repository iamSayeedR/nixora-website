                        <span class="text-[#c4b5fd]">Live</span>
                      </div>
                    </div>
                  </div>
                )}

                <!-- Infrastructure -->
                {resource.visual === "infrastructure" && (
                  <div class="mx-auto w-full max-w-97.5">
                    <div class="mb-3 text-[10px] font-medium tracking-wide text-white/45">THE INFRASTRUCTURE LAYER</div>
                    <div class="space-y-2">
                      {[
                        { label: "APPLICATIONS", detail: "Frontend · Backend · APIs", width: "w-full" },
                        { label: "RUNTIME & SERVICES", detail: "Containers · Networking · Storage", width: "w-[88%]" },
                        { label: "CLOUD COMPUTE", detail: "Infrastructure · Resources", width: "w-[76%]" },
                      ].map((layer) => (
                        <div class={`${layer.width} rounded-md border border-white/10 bg-[#19191F] px-2.5 py-2 sm:px-3`}>
                          <div class="flex items-center justify-between gap-2">
                            <span class="shrink-0 text-[8px] font-medium text-white/75 min-[375px]:text-[9px]">{layer.label}</span>
                            <span class="min-w-0 truncate text-right text-[7px] text-white/40 min-[375px]:text-[8px]">{layer.detail}</span>
                          </div>
                        </div>
                      ))}
