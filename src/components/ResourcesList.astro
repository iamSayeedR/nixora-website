
---
const resources = [

   {
  type: "article",
  category: "AI Infrastructure",
  date: "November 2026",
  readTime: "7 min read",
  title: "AI Agent Deploy Access: How to Keep Control (2026)",
  description:
    "Learn how to control AI agent deployment access with scoped permissions, approval gates, environment separation, and audit trails.",
  href: "/resources/ai-agent-deploy-access",
  visual: "deploy-access",
},

{
  type: "article",
  category: "Deployment",
  date: "November 2026",
  readTime: "10 min read",
  title: "Where to Deploy AI-Built Apps: An Honest Comparison",
  description:
    "Compare Render, Railway, Fly.io, Vercel, and Nixora to find the right deployment platform for your AI-built app.",
  href: "/resources/where-to-deploy-ai-built-apps",
  visual: "platform-comparison",
},
  {
    type: "article",
    category: "AI Infrastructure",
    date: "October 2026",
    readTime: "8 min read",
    title: "AI Agent Control Plane: Ultimate Guide for 2026",
    description:
      "Learn how an AI agent control plane helps teams govern AI-generated code, manage deployments, enforce policies, and maintain control as agents become more autonomous.",
    href: "/resources/ai-agent-control-plane",
    visual: "control-plane",
  },
  

  {
    type: "article",
    category: "AI Infrastructure",
    date: "October 2026",
    readTime: "8 min read",
    title: "MCP Servers: The Field-Tested Guide for 2026",
    description:
      "Understand how MCP servers connect AI models to tools and systems, and how to build, secure, deploy, and govern them in production.",
    href: "/resources/mcp-servers-guide",
    visual: "mcp",
  },
  {
    type: "article",
    title:
      "How to Deploy Gemini CLI, Codex & Open-Source AI Agent Apps to Production",
   category: "Deployment",
    date: "September 2026",
    readTime: "5 min read",
    description:
      "Complete guide for containerizing and deploying applications built with Gemini CLI, Codex, Devstral, and open-source AI coding agents using Nixora.",
    href: "/resources/deploy-gemini-codex-open-source-ai-apps/",
    visual: "gemini-deployment",
  },
  {
    type: "article",
    title:
      "Model Context Protocol (MCP) for Cloud Infrastructure & AI Agent Deployment",
    category: "Architecture Guide",
    date: "September 2026",
    readTime: "6 min read",
    description:
      "An architectural deep dive into how Model Context Protocol (MCP) servers allow AI coding agents to interact directly with cloud control planes, manage application lifecycles, and enforce granular permissions.",
    href: "/resources/mcp-server-cloud-infrastructure-guide/",
    visual: "mcp-cloud",
  },
  {
    type: "article",
    category: "Deployment",
    date: "September 2026",
    readTime: "5 min read",
    title: "How to Deploy a Cursor or Claude Code-Generated App to Production",
    description:
      "A practical guide to taking an app built by an AI coding agent (Cursor, Claude Code, or Codex) from your local machine to a live, running production deployment.",
    href: "/resources/deploy-cursor-claude-code-app-to-production",
    visual: "deployment",
  },
  {
    type: "article",
    category: "Developer Infrastructure",
    date: "September 2026",
    readTime: "5 min read",
    title: "Why Your AI Coding Agent's Output Won't Run in Production",
    description:
      "Cursor, Claude Code, and Codex generate working applications: but 'working' and 'production-ready' aren't the same thing. Here's the specific gap and how to close it.",
    href: "/resources/why-ai-agent-output-wont-run-in-production",
    visual: "production",
  },
  {
    type: "article",
   category: "Deployment",
    date: "August 2026",
    readTime: "4 min read",
    title: "Zero-Config CLI Deployment for AI-Generated Applications",
    description:
      "Learn how Nixora automates application containerization, TLS certificate issuance, and persistent hosting straight from your terminal.",
    href: "/resources/cli-deployment-guide",
    visual: "terminal",
  },
  {
    type: "article",
    category: "Developer Infrastructure",
    date: "August 2026",
    readTime: "5 min read",
    title: "Why Traditional Cloud Infrastructure Fails AI-Generated Code",
    description:
      "An architectural analysis of why high-velocity AI code generation breaks manual cloud operations and how control planes automate the lifecycle.",
    href: "/resources/why-traditional-infra-fails-ai-code",
    visual: "infrastructure",
  },
];

const contentTypes = [
  { label: "All resources", value: "all" },
  { label: "Articles", value: "article" },
  { label: "Videos", value: "video" },
  { label: "Images", value: "image" },
  { label: "Documentation", value: "documentation" },
  { label: "Tutorials", value: "tutorial" },
];

const topicFilters = [
  "All topics",
  "AI Infrastructure",
  "Deployment",
  "Developer Infrastructure",
  "Architecture Guide",
];

function getFilterCategory(category: string) {
  if (category === "Deployment Guide" || category === "CLI Deployment") {
    return "Deployment";
  }

  return category;
}
---

<section
  id="resources-list"
  class="relative isolate overflow-x-clip bg-background pb-16 text-white sm:pb-20 lg:pb-28"
>
  <div class="relative mx-auto w-full max-w-[1360px] px-0 sm:px-6 md:px-8 lg:px-10">

    <!-- Heading -->
    <div class="mb-8 flex flex-col gap-4 sm:mb-10 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <p class="text-[10px] font-medium uppercase tracking-[0.16em] text-[#a78bfa] sm:text-[11px]">
          THE NIXORA LIBRARY
        </p>

        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
          Ideas, guides &amp; insights
        </h2>

        <p class="mt-2 max-w-xl text-[13px] leading-6 text-white/50 sm:text-sm">
          Practical thinking on AI infrastructure, deployment, and building
          software with autonomous agents.
        </p>
      </div>
    </div>

    <!-- Search -->
    <div class="mb-6 sm:mb-7">
      <div class="relative w-full max-w-md">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-white/35"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5" />
          <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>

        <input
          type="search"
          id="resource-search"
          placeholder="Search resources and topics..."
          aria-label="Search resources"
          class="h-11 w-full rounded-[10px] border border-white/10 bg-[#101014] pl-11 pr-4 text-[13px] text-white outline-none transition-colors placeholder:text-white/35 focus:border-[#a78bfa]/50 sm:text-sm"
        />
      </div>
    </div>

    <!-- Content Type Filters -->
    <div class="mb-4">
      <p class="mb-3 text-[10px] font-medium uppercase tracking-[0.13em] text-white/35">
        CONTENT TYPE
      </p>

      <div
        id="resource-type-filters"
        class="flex flex-wrap items-center gap-2"
        aria-label="Filter by content type"
      >
        {contentTypes.map((type, index) => (
          <button
            type="button"
            data-type-filter={type.value}
            aria-pressed={index === 0 ? "true" : "false"}
            class:list={[
              "shrink-0 rounded-full border px-3 py-2 text-[11px] font-medium transition-colors duration-200 sm:px-4 sm:py-2.5 sm:text-xs",
              index === 0
                ? "border-[#a78bfa]/40 bg-[#7D57EF]/13 text-[#c4b5fd]"
                : "border-transparent text-white/50 hover:border-white/10 hover:text-white",
            ]}
          >
            {type.label}
          </button>
        ))}
      </div>
    </div>

   <!-- Topic Filters -->
<div
  id="resource-topic-filters"
  class="mb-7 border-b border-white/8 pb-4 sm:mb-9 sm:pb-5"
  aria-label="Filter by topic"
>
  <p class="mb-3 text-[10px] font-medium uppercase tracking-[0.13em] text-white/35">
    TOPICS
  </p>

  <div class="flex flex-wrap items-center gap-2">
    {topicFilters.map((filter, index) => (
      <button
        type="button"
        data-topic-filter={filter}
        aria-pressed={index === 0 ? "true" : "false"}
        class:list={[
          "shrink-0 rounded-full border px-3 py-2 text-[11px] font-medium transition-colors duration-200 sm:px-4 sm:py-2.5 sm:text-xs",
          index === 0
            ? "border-[#a78bfa]/40 bg-[#7D57EF]/13 text-[#c4b5fd]"
            : "border-transparent text-white/50 hover:border-white/10 hover:text-white",
        ]}
      >
        {filter}
      </button>
    ))}
  </div>
</div>

    <!-- Resources -->
    <div
      id="resource-grid"
      class="grid grid-cols-1 items-stretch gap-x-5 gap-y-6 md:grid-cols-2 md:gap-y-7 lg:grid-cols-3 lg:gap-x-5 lg:gap-y-8"
    >
      {resources.map((resource, index) => (
        <article
          data-resource-card
          data-type={resource.type}
          data-category={getFilterCategory(resource.category)}
          data-search={`${resource.title} ${resource.description} ${resource.category} ${resource.type}`.toLowerCase()}
          style={`--card-index: ${index}`}
          class="min-w-0"
        >
          <a
            href={resource.href}
            class="group flex h-full min-w-0 flex-col overflow-hidden rounded-[8px] border border-white/9 bg-[#0D0D11] outline-none transition-colors duration-300 hover:border-[#a78bfa]/40 focus-visible:ring-2 focus-visible:ring-[#a78bfa] focus-visible:ring-offset-4 focus-visible:ring-offset-black"
          >

            <!-- Artwork -->
            <div
              class="resource-artwork relative flex h-[180px] items-center justify-center overflow-hidden bg-[#111116] min-[375px]:h-[190px] sm:h-[205px] md:h-[195px] lg:h-[205px]"
              data-artwork={resource.visual}
            >
              <div class="absolute inset-0 bg-linear-to-br from-[#7D57EF]/9 via-transparent to-transparent"></div>

              <div class="resource-artwork-inner relative z-10 w-full min-w-0 px-4 sm:px-5 md:px-6 lg:px-7">


              
                {/* Agent Deploy Access */}
                {resource.visual === "deploy-access" && (
                  <div class="mx-auto w-full max-w-97.5">
                    <div class="mb-4 flex items-center justify-between gap-2">
                      <span class="text-[10px] font-medium tracking-wide text-white/45">
                        AGENT DEPLOY ACCESS
                      </span>
                      <span class="text-[9px] text-white/30">NIXORA</span>
                    </div>

                    {/* Architecture flow */}
                    <div class="grid grid-cols-[1fr_18px_1fr_18px_1fr] items-center gap-1">
                      
                      {/* AI Agent */}
                      <div class="flex min-w-0 flex-col items-center justify-center rounded-lg border border-white/10 bg-[#19191F] px-1 py-3.5">
                        <svg viewBox="0 0 32 32" class="h-7 w-7 text-white/65" fill="none">
                          <rect x="5" y="7" width="22" height="18" rx="5" stroke="currentColor" stroke-width="1.4"/>
                          <path d="M11 14h.01M21 14h.01M12 19h8M16 3v4M16 25v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <span class="mt-2 text-[9px] font-medium text-white/75">
                          AI Agent
                        </span>
                        <span class="mt-1 text-[7px] text-white/35">
                          Identity
                        </span>
                      </div>

                      {/* Connector */}
                      <div class="flex items-center justify-center">
                        <svg viewBox="0 0 20 12" class="w-full text-[#a78bfa]/65" fill="none">
                          <path d="M1 6h17m-5-4 5 4-5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </div>

                      {/* Nixora */}
                      <div class="flex min-w-0 flex-col items-center justify-center rounded-lg border border-[#a78bfa]/35 bg-[#7D57EF]/12 px-1 py-3.5">
                        <svg viewBox="0 0 32 32" class="h-7 w-7 text-[#c4b5fd]" fill="none">
                          <path d="M16 3 27 9v14l-11 6L5 23V9l11-6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                          <path d="m11 16 3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="mt-2 text-[9px] font-semibold text-[#d6caff]">
                          Nixora
                        </span>
                        <span class="mt-1 text-[7px] text-white/45">
                          Control layer
                        </span>
                      </div>

                      {/* Connector */}
                      <div class="flex items-center justify-center">
                        <svg viewBox="0 0 20 12" class="w-full text-[#a78bfa]/65" fill="none">
                          <path d="M1 6h17m-5-4 5 4-5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </div>

                      {/* Production */}
                      <div class="flex min-w-0 flex-col items-center justify-center rounded-lg border border-white/10 bg-[#19191F] px-1 py-3.5">
                        <svg viewBox="0 0 32 32" class="h-7 w-7 text-white/65" fill="none">
                          <rect x="5" y="5" width="22" height="22" rx="4" stroke="currentColor" stroke-width="1.4"/>
                          <path d="M10 12h12M10 17h12M10 22h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                        </svg>
                        <span class="mt-2 text-[9px] font-medium text-white/75">
                          Production
                        </span>
                        <span class="mt-1 text-[7px] text-white/35">
                          Environment
                        </span>
                      </div>
                    </div>

                    {/* Access controls */}
                    <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5">
                      {["Scoped access", "Approval gates", "Audit trail"].map((item) => (
                        <span class="rounded-full border border-white/10 bg-white/[0.035] px-2 py-1 text-[8px] text-white/50">
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
                


{/* Platform Comparison */}
{resource.visual === "platform-comparison" && (
  <div class="mx-auto w-full max-w-97.5">
    <div class="mb-4 flex items-center justify-between gap-2">
      <span class="text-[10px] font-medium tracking-wide text-white/45">
        DEPLOYMENT PLATFORMS
      </span>
      <span class="text-[9px] text-white/35">5 OPTIONS</span>
    </div>

    <div class="grid grid-cols-5 gap-2">
      {[
        { initials: "Re", name: "Render" },
        { initials: "Ra", name: "Railway" },
        { initials: "F", name: "Fly.io" },
        { initials: "V", name: "Vercel" },
        { initials: "N", name: "Nixora", featured: true },
      ].map((platform) => (
        <div
          class:list={[
            "flex min-w-0 flex-col items-center justify-center rounded-lg border px-1 py-4",
            platform.featured
              ? "border-[#a78bfa]/35 bg-[#7D57EF]/12"
              : "border-white/10 bg-[#19191F]",
          ]}
        >
          <div
            class:list={[
              "flex h-8 w-8 items-center justify-center rounded-lg text-xs font-semibold",
              platform.featured
                ? "bg-[#7D57EF]/25 text-[#c4b5fd]"
                : "bg-white/[0.06] text-white/65",
            ]}
          >
            {platform.initials}
          </div>

          <span
            class:list={[
              "mt-2 text-[9px] font-medium",
              platform.featured ? "text-[#c4b5fd]" : "text-white/65",
            ]}
          >
            {platform.name}
          </span>
        </div>
      ))}
    </div>

    <div class="mt-4 flex items-center justify-center gap-2">
      <span class="h-px w-8 bg-white/10"></span>
      <span class="text-[9px] tracking-wide text-white/40">
        COMPARE · CHOOSE · DEPLOY
      </span>
      <span class="h-px w-8 bg-white/10"></span>
    </div>
  </div>
)}


                <!-- Control Plane -->
                {resource.visual === "control-plane" && (
                  <div class="mx-auto w-full max-w-97.5">
                    <div class="mb-3 flex items-center justify-between">
                      <span class="text-[10px] font-medium tracking-wide text-white/45">AGENT CONTROL</span>
                      <span class="text-[10px] text-white/35">NIXORA</span>
                    </div>

                    <div class="flex min-h-28 overflow-hidden rounded-lg border border-white/10 bg-[#18181E]">
                      <div class="w-[31%] shrink-0 border-r border-white/8 p-3">
                        <div class="mb-4 h-2 w-14 rounded-sm bg-white/20"></div>
                        <div class="space-y-3">
                          <div class="h-1.5 w-full rounded-sm bg-[#a78bfa]/65"></div>
                          <div class="h-1.5 w-4/5 rounded-sm bg-white/15"></div>
                          <div class="h-1.5 w-3/5 rounded-sm bg-white/15"></div>
                        </div>
                      </div>

                      <div class="min-w-0 flex-1 p-3">
                        <div class="mb-3 text-[9px] font-medium text-white/55">Deployment policies</div>
                        {["Access permissions", "Deployment rules", "Activity logs"].map((item, index) => (
                          <div class="flex items-center justify-between gap-1 border-t border-white/[0.07] py-2">
                            <span class="min-w-0 truncate text-[9px] text-white/65">{item}</span>
                            <span class:list={["shrink-0 text-[8px]", index === 0 ? "text-[#c4b5fd]" : "text-white/35"]}>
                              {index === 0 ? "Enabled" : "Managed"}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                <!-- MCP -->
                {resource.visual === "mcp" && (
                  <div class="mx-auto w-full max-w-97.5">
                    <div class="mb-3 text-[10px] font-medium tracking-wide text-white/45">MODEL CONTEXT PROTOCOL</div>
                    <div class="flex items-center gap-2 min-[375px]:gap-3">
                      <div class="flex h-22 w-[28%] shrink-0 flex-col items-center justify-center rounded-lg border border-white/10 bg-[#1A1920]">
                        <svg viewBox="0 0 32 32" class="mb-2 h-7 w-7 text-[#c4b5fd]" fill="none">
                          <path d="M16 3 27 9v14l-11 6L5 23V9l11-6Z" stroke="currentColor" stroke-width="1.5"/>
                          <path d="m5 9 11 6 11-6M16 15v14" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                        <span class="text-[9px] text-white/70">AI Model</span>
                      </div>

                      <div class="flex min-w-0 flex-1 flex-col items-center gap-2">
                        <div class="h-px w-full bg-[#a78bfa]/50"></div>
                        <div class="rounded-md border border-[#a78bfa]/35 bg-[#7D57EF]/15 px-2 py-2 text-center min-[375px]:px-3">
                          <span class="text-[9px] font-medium text-[#d6caff] min-[375px]:text-[10px]">MCP Server</span>
                        </div>
                        <div class="h-px w-full bg-[#a78bfa]/50"></div>
                      </div>

                      <div class="flex w-[28%] shrink-0 flex-col gap-2">
                        {["Tools", "Resources"].map((item) => (
                          <div class="rounded-md border border-white/10 bg-[#1A1920] px-1 py-2.5 text-center text-[9px] text-white/70 min-[375px]:px-2">{item}</div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                <!-- Gemini Deployment -->
                {resource.visual === "gemini-deployment" && (
                  <div class="mx-auto w-full max-w-97.5">
                    <div class="mb-3 flex items-center justify-between gap-2">
                      <span class="text-[10px] font-medium tracking-wide text-white/45">AI AGENT DEPLOYMENT</span>
                      <span class="text-[9px] text-white/30">NIXORA CLI</span>
                    </div>

                    <div class="flex min-w-0 items-center gap-1.5 min-[375px]:gap-2.5">
                      <div class="flex w-[31%] shrink-0 flex-col gap-2">
                        {["Gemini CLI", "Codex", "Devstral"].map((agent, index) => (
                          <div class:list={["rounded-md border px-1 py-2 text-center min-[375px]:px-2", index === 0 ? "border-[#a78bfa]/30 bg-[#7D57EF]/10" : "border-white/10 bg-[#19191F]"]}>
                            <span class:list={["text-[8px] min-[375px]:text-[9px]", index === 0 ? "text-[#c4b5fd]" : "text-white/65"]}>{agent}</span>
                          </div>
                        ))}
                      </div>

                      <svg viewBox="0 0 24 16" class="h-3 w-3 shrink-0 text-[#a78bfa]/70 min-[375px]:h-4 min-[375px]:w-4" fill="none">
                        <path d="M1 8h20m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>

                      <div class="flex min-w-0 flex-1 flex-col items-center justify-center rounded-lg border border-white/10 bg-[#19191F] px-1 py-4 min-[375px]:px-2">
                        <svg viewBox="0 0 32 32" class="h-6 w-6 text-[#c4b5fd] min-[375px]:h-7 min-[375px]:w-7" fill="none">
                          <path d="M4 10 16 4l12 6v13l-12 6-12-6V10Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                          <path d="m4 10 12 6 12-6M16 16v13" stroke="currentColor" stroke-width="1.4"/>
                        </svg>
                        <span class="mt-2 text-[9px] font-medium text-white/75">Container</span>
                        <span class="mt-1 text-center text-[7px] text-white/35 min-[375px]:text-[8px]">Build &amp; provision</span>
                      </div>

                      <svg viewBox="0 0 24 16" class="h-3 w-3 shrink-0 text-[#a78bfa]/70 min-[375px]:h-4 min-[375px]:w-4" fill="none">
                        <path d="M1 8h20m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>

                      <div class="flex w-[23%] shrink-0 flex-col items-center justify-center rounded-lg border border-[#a78bfa]/30 bg-[#7D57EF]/10 px-1 py-4">
                        <svg viewBox="0 0 28 28" class="h-5 w-5 text-[#c4b5fd] min-[375px]:h-6 min-[375px]:w-6" fill="none">
                          <circle cx="14" cy="14" r="10" stroke="currentColor" stroke-width="1.4"/>
                          <path d="m9 14 3.2 3.2L19 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="mt-2 text-[9px] font-medium text-[#c4b5fd]">Live</span>
                        <span class="mt-1 text-[8px] text-white/35">HTTPS</span>
                      </div>
                    </div>
                  </div>
                )}

                <!-- MCP Cloud -->
                {resource.visual === "mcp-cloud" && (
                  <div class="mx-auto w-full max-w-97.5">
                    <div class="mb-3 flex items-center justify-between gap-2">
                      <span class="text-[10px] font-medium tracking-wide text-white/45">MCP CLOUD CONTROL</span>
                      <span class="text-[9px] text-white/30">ARCHITECTURE</span>
                    </div>

                    <div class="flex min-w-0 items-center gap-1 min-[375px]:gap-1.5 sm:gap-2">
                      <div class="flex w-[22%] shrink-0 flex-col items-center justify-center rounded-lg border border-white/10 bg-[#19191F] px-1 py-4">
                        <svg viewBox="0 0 28 28" class="h-5 w-5 text-[#c4b5fd] min-[375px]:h-6 min-[375px]:w-6" fill="none">
                          <path d="M14 3 24 9v10l-10 6L4 19V9l10-6Z" stroke="currentColor" stroke-width="1.4"/>
                          <path d="m9 14 3 3 7-7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="mt-2 text-[8px] text-white/70 min-[375px]:text-[9px]">AI Agent</span>
                      </div>

