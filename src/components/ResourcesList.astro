  </div>
</section>

<style>
  /* Base layout protection */
  #resources-list {
    width: 100%;
    min-width: 0;
    overflow-x: clip;
  }

  #resources-list *,
  #resources-list *::before,
  #resources-list *::after {
    box-sizing: border-box;
  }

  #resources-list [data-resource-card] {
    width: 100%;
    min-width: 0;
    height: 100%;
  }

  #resources-list [data-resource-card] > a {
    width: 100%;
    min-width: 0;
    height: 100%;
  }

  #resources-list .resource-artwork {
    width: 100%;
    min-width: 0;
  }

  #resources-list .resource-artwork-inner {
    min-width: 0;
  }

  #resources-list svg {
    flex-shrink: 0;
  }

  #resources-list [hidden] {
    display: none !important;
  }

  /* Card entrance animation */
  @keyframes resourceFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #resources-list .animate-resource-in {
    animation: resourceFadeIn 0.4s ease-out both;
    animation-delay: min(calc(var(--card-index) * 40ms), 160ms);
  }

  /* Small mobile: 320px - 374px */
  @media (max-width: 374px) {
    #resources-list .resource-artwork-inner {
      padding-left: 12px;
      padding-right: 12px;
    }

    #resources-list [data-artwork="mcp-cloud"] .resource-artwork-inner,
    #resources-list [data-artwork="gemini-deployment"] .resource-artwork-inner {
      font-size: 90%;
    }

    #resources-list [data-resource-card] h3 {
      font-size: 15px;
    }

    #resources-list [data-resource-card] p {
      font-size: 12px;
    }

    #resources-list [data-resource-card] .resource-artwork {
      height: 176px;
    }
  }

  /* Standard mobile: 375px - 639px */
  @media (min-width: 375px) and (max-width: 639px) {
    #resources-list [data-resource-card] {
      min-height: 0;
    }
  }

  /* Medium tablet: 768px - 1023px */
  @media (min-width: 768px) and (max-width: 1023px) {
    #resources-list .resource-artwork {
      height: 195px;
    }

    #resources-list .resource-artwork-inner {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  /* Desktop: 1024px - 1279px */
  @media (min-width: 1024px) and (max-width: 1279px) {
    #resources-list .resource-artwork {
      height: 200px;
    }
  }

  /* Large desktop: 1280px+ */
  @media (min-width: 1280px) {
    #resources-list .resource-artwork {
      height: 205px;
    }
  }

  /* Reduced motion accessibility */
  @media (prefers-reduced-motion: reduce) {
    #resources-list *,
    #resources-list *::before,
    #resources-list *::after {
      animation: none !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>("#resource-search");

  const typeFilterContainer =
    document.querySelector<HTMLElement>("#resource-type-filters");

  const topicFilterContainer =
    document.querySelector<HTMLElement>("#resource-topic-filters");

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-resource-card]"),
  );

  const emptyState =
    document.querySelector<HTMLElement>("#resource-empty");

  const emptyTitle =
    document.querySelector<HTMLElement>("#resource-empty-title");

  const emptyDescription =
    document.querySelector<HTMLElement>("#resource-empty-description");

  const clearButton =
    document.querySelector<HTMLButtonElement>("#resource-clear");

  const typeFilterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-type-filter]"),
  );

  const topicFilterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-topic-filter]"),
  );

  let activeType = "all";
  let activeTopic = "All topics";

  function updateResources() {
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    let visibleCount = 0;

    cards.forEach((card) => {
      const type = card.dataset.type ?? "";
      const category = card.dataset.category ?? "";
      const searchText = card.dataset.search ?? "";

      const matchesType =
        activeType === "all" || type === activeType;

      const matchesTopic =
        activeTopic === "All topics" || category === activeTopic;

      const matchesSearch = searchText.includes(query);

      const isVisible = matchesType && matchesTopic && matchesSearch;

      card.hidden = !isVisible;

      if (isVisible) {
        visibleCount++;
      }
    });

    const hasResults = visibleCount > 0;

    emptyState?.classList.toggle("hidden", hasResults);

    if (!hasResults) {
      if (activeType !== "all" && !cards.some((card) => card.dataset.type === activeType)) {
        const selectedType =
          typeFilterButtons.find((button) => button.dataset.typeFilter === activeType)?.textContent?.trim() ?? "resources";

        if (emptyTitle) {
          emptyTitle.textContent = `No ${selectedType.toLowerCase()} available yet`;
        }

        if (emptyDescription) {
          emptyDescription.textContent =
            "We're working on adding more resources. Check back soon.";
        }
      } else {
        if (emptyTitle) {
          emptyTitle.textContent = "No resources found";
        }

        if (emptyDescription) {
          emptyDescription.textContent =
            "Try a different search term or filter.";
        }
      }
    }
  }

  function updateButtonStyles(
    buttons: HTMLButtonElement[],
    activeValue: string,
    dataAttribute: "typeFilter" | "topicFilter",
  ) {
    buttons.forEach((button) => {
      const value =
        dataAttribute === "typeFilter"
          ? button.dataset.typeFilter
          : button.dataset.topicFilter;

      const isActive = value === activeValue;

      button.setAttribute("aria-pressed", String(isActive));

      button.className = isActive
        ? "shrink-0 rounded-full border border-[#a78bfa]/40 bg-[#7D57EF]/13 px-3 py-2 text-[11px] font-medium text-[#c4b5fd] transition-colors duration-200 sm:px-4 sm:py-2.5 sm:text-xs"
        : "shrink-0 rounded-full border border-transparent px-3 py-2 text-[11px] font-medium text-white/50 transition-colors duration-200 hover:border-white/10 hover:text-white sm:px-4 sm:py-2.5 sm:text-xs";
    });
  }

  typeFilterContainer?.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-type-filter]");

    if (!button) return;

    activeType = button.dataset.typeFilter ?? "all";

    updateButtonStyles(typeFilterButtons, activeType, "typeFilter");
    updateResources();
  });

  topicFilterContainer?.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-topic-filter]");

    if (!button) return;

    activeTopic = button.dataset.topicFilter ?? "All topics";

    updateButtonStyles(topicFilterButtons, activeTopic, "topicFilter");
    updateResources();
  });

  searchInput?.addEventListener("input", updateResources);

  clearButton?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
    }

    activeType = "all";
    activeTopic = "All topics";

    updateButtonStyles(typeFilterButtons, activeType, "typeFilter");
    updateButtonStyles(topicFilterButtons, activeTopic, "topicFilter");

    updateResources();
    searchInput?.focus();
  });

  updateResources();
</script>
