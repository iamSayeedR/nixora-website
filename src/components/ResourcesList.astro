                  </div>
                )}

              </div>
            </div>

            <!-- Card Content -->
            <div class="flex min-w-0 flex-1 flex-col px-4 pb-5 pt-4 sm:px-5 sm:pb-5 sm:pt-5 lg:px-6 lg:pb-6">
              <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
                <span class="text-[11px] font-medium text-[#b9a5ff]">{resource.category}</span>
                <span class="text-[11px] text-white/35">{resource.date}</span>
              </div>

              <h3 class="mt-4 text-base font-semibold leading-[1.45] tracking-tight text-white transition-colors duration-200 group-hover:text-[#d1c4ff] sm:text-[17px]">
                {resource.title}
              </h3>

              <p class="mt-3 flex-1 text-[12px] leading-[1.8] text-white/50 sm:text-[13px]">
                {resource.description}
              </p>

              <div class="mt-6 flex items-center justify-between gap-2 border-t border-white/8 pt-4">
                <span class="text-[11px] text-white/40">{resource.readTime}</span>

                <span class="inline-flex items-center gap-2 text-xs font-medium text-white/65 transition-colors group-hover:text-[#c4b5fd]">
                  Read article
                  <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                    <path d="M3.5 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div
      id="resource-empty"
      class="hidden border-y border-white/8 py-16 text-center sm:py-20"
      aria-live="polite"
    >
      <p id="resource-empty-title" class="text-lg font-medium text-white">
        No resources found
      </p>

      <p id="resource-empty-description" class="mt-2 text-sm text-white/45">
        Try a different search term or filter.
      </p>

      <button
        type="button"
        id="resource-clear"
        class="mt-5 text-sm font-medium text-[#a78bfa] transition-colors hover:text-[#c4b5fd]"
      >
        Clear filters
      </button>
