
---
const segments = [
  {
    name: "Individual developers",
    description:
      "Developers building applications with AI coding tools who want a simpler deployment experience.",
  },
  {
    name: "AI-native builders and startups",
    description:
      "Small teams creating multiple applications and agents without wanting to manage every infrastructure component themselves.",
  },
  {
    name: "Engineering teams",
    description:
      "Teams that need consistent deployment and operational workflows across different applications and environments.",
  },
  {
    name: "Enterprises",
    description:
      "Organizations that want to integrate deployment and operational management with their existing infrastructure, security controls, and CI/CD processes.",
  },
  {
    name: "AI agent developers",
    description:
      "Teams that need to deploy, test, and eventually manage agents as reliable production workloads.",
  },
];
---

<section class="target-customers">
  <div class="target-inner">

    <!-- Heading -->
    <header class="target-header" data-reveal>
      <p class="target-eyebrow">Target customers</p>

      <h2>
        Who Nixora is <span>built for.</span>
      </h2>

      <p class="target-description">
        Nixora is intended to serve several customer groups, from individual
        developers to enterprise teams.
      </p>
    </header>

    <!-- Customer Segments -->
    <div class="segments-list">
      {segments.map((segment) => (
        <article class="segment-row" data-reveal>
          <div class="segment-heading">
            <h3>{segment.name}</h3>
          </div>

          <p class="segment-description">
            {segment.description}
          </p>
        </article>
      ))}
    </div>

    <!-- Disclaimer and Product Link -->
    <div class="target-footer" data-reveal>
      <p class="target-note">
        These are target customer segments. Supporting each segment's
        complete requirements will require product development and customer
        validation.
      </p>

      <a href="/product" class="product-link">
        <span>See what's live today</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  const revealElements =
    document.querySelectorAll<HTMLElement>(".target-customers [data-reveal]");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (!prefersReducedMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -40px 0px",
      }
    );

    revealElements.forEach((element) => observer.observe(element));
  } else {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  }
</script>

<style>
  /* Main Section */
  .target-customers {
    position: relative;
    overflow: hidden;

    padding: 6rem 1.5rem;
    color: #fff;
  }

  .target-inner {
    max-width: 1152px;
    margin: 0 auto;
  }

  /* Heading */
  .target-header {
    max-width: 672px;
    margin: 0 auto;
    text-align: center;
  }

  .target-eyebrow {
    margin: 0;
    color: #a78bfa;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .target-header h2 {
    margin: 1rem 0 0;
    color: #fff;
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .target-header h2 span {
    color: #a78bfa;
  }

  .target-description {
    margin: 1.25rem auto 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  /* Customer Segments */
  .segments-list {
    overflow: hidden;
    margin-top: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .segment-row {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem 1.75rem;
    transition: background 0.3s ease;
  }

  .segment-row:not(:last-child) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .segment-row::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: #a78bfa;
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .segment-row:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .segment-row:hover::before {
    transform: scaleY(1);
  }

  .segment-heading h3 {
    margin: 0;
    color: #fff;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.02em;
    transition: color 0.3s ease;
  }

  .segment-row:hover h3 {
    color: #a78bfa;
  }

  .segment-description {
    margin: 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  /* Footer */
  .target-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .target-note {
    max-width: 672px;
    margin: 0;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.8rem;
    line-height: 1.8;
  }

  .product-link {
    display: inline-flex;
    width: fit-content;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .product-link svg {
    transition: transform 0.3s ease;
  }

  .product-link:hover {
    color: #a78bfa;
  }

  .product-link:hover svg {
    transform: translateX(4px);
  }

  /* Scroll Reveal */
  @media (prefers-reduced-motion: no-preference) {
    .target-customers [data-reveal] {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 550ms ease-out,
        transform 550ms ease-out;
    }

    .target-customers [data-reveal].is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (min-width: 1024px) {
    .segment-row {
      grid-template-columns: 18rem 1fr;
      align-items: baseline;
      gap: 1.5rem;
      padding: 1.75rem 2.25rem;
    }

    .segment-description {
      font-size: 1rem;
      line-height: 2;
    }

    .target-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      margin-top: 2rem;
    }
  }

 @media (max-width: 768px) {
  .target-customers {
    padding: 4rem 1.35rem;
  }

  .segments-list {
    margin-top: 2.5rem;
  }

  .segment-row {
    padding: 1.5rem 1.25rem;
  }

  .segment-heading h3 {
    font-size: 1.05rem;
  }

  .segment-description {
    font-size: 0.875rem;
    line-height: 1.8;
  }

  .target-footer {
    width: 100%;
    align-items: center;
    text-align: center;
  }

  .target-note {
    width: 100%;
    max-width: 100%;
    text-align: center;
  }

  .product-link {
    align-self: center;
    justify-content: center;
  }
}

  @media (prefers-reduced-motion: reduce) {
    .segment-row,
    .segment-row::before,
    .segment-heading h3,
    .product-link,
    .product-link svg {
      transition: none;
    }

    .target-customers [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
