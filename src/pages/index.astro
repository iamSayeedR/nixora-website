---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import DeployIntro from '../components/DeployIntro.astro';
import Traction from '../components/Traction.astro';
import AssistantSection from '../components/AssistantSection.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Architecture from '../components/Architecture.astro';
import Vision from '../components/Vision.astro';
import FAQ from '../components/FAQ.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import Founder from '../components/Founder.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Nixora: The Control Plane for AI-generated software" description="Nixora is being built as the control plane for AI-generated software and AI agents: understand, deploy, operate, and evolve the infrastructure around them.">
  <Header />
  <main>
    <!-- 1. Hero: headline + announcement pill + CTA + terminal visual -->
    <Hero />
    <!-- 2. Control plane vision section ("It's not just deployment") -->
    <AssistantSection />
    <!-- 3. Features & Roadmap: Today, Next, Later -->
    <Features />
    <!-- 4. Feature proof-of-concept: "It all starts with nixora deploy" -->
    <DeployIntro />
    <!-- 5. How It Works: 3-step workflow -->
    <HowItWorks />
    <!-- 6. Architecture: traditional infra vs Nixora comparison -->
    <Architecture />
    <!-- 7. Traction: stats counters -->
    <Traction />
    <!-- 8. Vision closer -->
    <Vision />
    <!-- 9. FAQ Section for AI Search Crawlers & User Intent -->
    <FAQ />
    <!-- 10. Early Access: Name + Email capture form -->
    <EarlyAccess />
    <!-- 11. Founder: bio + LinkedIn -->
    <Founder />
  </main>
  <Footer />
</Layout>
