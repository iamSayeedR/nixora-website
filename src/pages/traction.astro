---
import InnerLayout from '../layouts/InnerLayout.astro';
import Traction from '../components/Traction.astro';
import EarlyAccess from '../components/EarlyAccess.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nixora.co.in" },
    { "@type": "ListItem", "position": 2, "name": "Traction", "item": "https://nixora.co.in/traction" }
  ]
};
---

<InnerLayout title="Developer Adoption Metrics & Milestones | Nixora Traction" description="Factual metrics detailing Nixora CLI installs, real application deployments, core engine milestones, and pre-seed SAFE funding status." jsonLd={breadcrumbSchema}>

  <!-- Page Header -->
  <div style="padding:4rem 2rem 2rem;max-width:900px;margin:0 auto;">
    <div style="font-size:0.72rem;color:#a78bfa;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin-bottom:0.75rem;font-family:'Fira Code',monospace;">Traction & Milestones</div>
    <h1 class="section-headline" style="max-width:600px;">Blunt honesty over <span class="accent">marketing polish.</span></h1>
    <p style="font-size:1.0625rem;line-height:1.75;color:#a1a1aa;max-width:580px;display:block;margin:1.25rem 0 0;">
      Our MVP has been live since July 2026. Here are the exact, unrounded numbers backing Nixora's early developer adoption and pre-seed round as of August 2026.
    </p>
  </div>
  
  <Traction />

  <!-- Detailed Traction Breakdown -->
  <section style="padding:5rem 2rem;max-width:900px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;" class="arch-grid">
      
      <!-- Key Milestones -->
      <div style="background:#0a0a0a;border:1px solid #1f1f1f;border-radius:12px;padding:2rem;display:flex;flex-direction:column;gap:1rem;">
        <h2 style="font-size:1.125rem;font-weight:700;color:#fff;margin:0;">Key Milestones</h2>
        <div style="display:flex;flex-direction:column;gap:1rem;border-top:1px solid #1a1a1a;padding-top:1rem;">
          <div>
            <div style="font-size:0.75rem;color:#a78bfa;font-family:'Fira Code',monospace;">JULY 2026</div>
            <div style="font-size:0.9375rem;color:#fff;font-weight:600;margin-top:0.2rem;">Core Engine Built</div>
            <div style="font-size:0.85rem;color:#71717a;margin-top:0.15rem;">Automated containerization, SSL generation, and lifecycle management engine constructed.</div>
          </div>
          <div style="border-top:1px solid #1a1a1a;padding-top:1rem;">
            <div style="font-size:0.75rem;color:#a78bfa;font-family:'Fira Code',monospace;">AUGUST 2026</div>
            <div style="font-size:0.9375rem;color:#fff;font-weight:600;margin-top:0.2rem;">Public CLI Launch</div>
            <div style="font-size:0.85rem;color:#71717a;margin-top:0.15rem;">Nixora CLI released for testing, reaching 65 developer installs, 47 real deployments, and 100+ waitlist signups.</div>
          </div>
        </div>
      </div>

      <!-- Pre-Seed Ask -->
      <div style="background:#0a0a0a;border:1px solid #1f1f1f;border-radius:12px;padding:2rem;display:flex;flex-direction:column;gap:1rem;">
        <h2 style="font-size:1.125rem;font-weight:700;color:#fff;margin:0;">Pre-Seed Round Details</h2>
        <div style="display:flex;flex-direction:column;gap:0.8rem;border-top:1px solid #1a1a1a;padding-top:1rem;font-size:0.9rem;color:#a1a1aa;">
          <div style="display:flex;justify-content:space-between;border-bottom:1px solid #151515;padding-bottom:0.5rem;">
            <span>Target Raise:</span>
            <span style="color:#fff;font-weight:600;">$450,000</span>
          </div>
          <div style="display:flex;justify-content:space-between;border-bottom:1px solid #151515;padding-bottom:0.5rem;">
            <span>Instrument:</span>
            <span style="color:#fff;font-weight:600;">SAFE</span>
          </div>
          <div style="display:flex;justify-content:space-between;border-bottom:1px solid #151515;padding-bottom:0.5rem;">
            <span>Target Runway:</span>
            <span style="color:#fff;font-weight:600;">12 – 14 Months</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span>Use of Funds:</span>
            <span style="color:#a78bfa;font-weight:600;">Phase 2 & 3 Fleet Control</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <EarlyAccess />

</InnerLayout>
