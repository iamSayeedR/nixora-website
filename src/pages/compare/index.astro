---
import InnerLayout from '../../layouts/InnerLayout.astro';

const comparisons = [
  {
    title: "Nixora vs Traditional Cloud Deployment",
    slug: "/compare/nixora-vs-traditional-cloud",
    description: "Compare manual Dockerfile setup, cloud compute configuration, and ingress routing against Nixora's zero-config CLI deployment.",
    focus: "Cloud Infrastructure"
  },
  {
    title: "Nixora vs Vercel",
    slug: "/compare/nixora-vs-vercel",
    description: "Compare Vercel's Git-centric frontend platform with Nixora's control plane built specifically for AI-generated applications.",
    focus: "Developer Platforms"
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nixora.co.in" },
    { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://nixora.co.in/compare" }
  ]
};
---

<InnerLayout title="Platform Comparisons | Nixora" description="Factual architectural comparisons between Nixora's deployment control plane and traditional cloud hosting platforms." jsonLd={breadcrumbSchema}>

  <div style="padding:4rem 2rem 5rem;max-width:950px;margin:0 auto;display:flex;flex-direction:column;gap:3.5rem;">
    
    <!-- Page Header -->
    <div style="display:flex;flex-direction:column;gap:1rem;">
      <div style="font-size:0.72rem;color:#a78bfa;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;font-family:'Fira Code',monospace;">Platform Architecture</div>
      <h1 class="section-headline">Platform <span class="accent">Comparisons</span></h1>
      <p class="section-para" style="max-width:640px;">
        Factual architectural comparisons between Nixora's deployment model for AI software and existing hosting platforms.
      </p>
    </div>

    <!-- Comparisons Grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(360px, 1fr));gap:1.5rem;">
      {comparisons.map(comp => (
        <div style="background:#0a0a0a;border:1px solid #1f1f1f;border-radius:12px;padding:2rem;display:flex;flex-direction:column;gap:1rem;transition:border-color 0.25s;" class="compare-card">
          <div style="font-size:0.72rem;color:#a78bfa;font-family:'Fira Code',monospace;padding:0.25rem 0.65rem;border-radius:9999px;border:1px solid rgba(167,139,250,0.3);background:rgba(167,139,250,0.08);align-self:flex-start;">{comp.focus}</div>

          <h2 style="font-size:1.25rem;font-weight:700;margin:0;">
            <a href={comp.slug} style="color:#fff;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#a78bfa'" onmouseout="this.style.color='#fff'">
              {comp.title}
            </a>
          </h2>

          <p style="font-size:0.9rem;line-height:1.7;color:#a1a1aa;margin:0;">
            {comp.description}
          </p>

          <div style="margin-top:auto;padding-top:0.5rem;">
            <a href={comp.slug} style="color:#a78bfa;font-size:0.875rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;" onmouseover="this.style.color='#c4b5fd'" onmouseout="this.style.color='#a78bfa'">
              View comparison →
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>

</InnerLayout>

<style>
  .compare-card:hover {
    border-color: rgba(167, 139, 250, 0.4);
  }
</style>
