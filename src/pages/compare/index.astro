
---
import InnerLayout from '../../layouts/InnerLayout.astro';

const comparisons = [
  {
    title: "Nixora vs Traditional Cloud Deployment",
    slug: "/compare/nixora-vs-traditional-cloud/",
    description: "Compare manual Dockerfile setup, cloud compute configuration, and ingress routing against Nixora's zero-config CLI deployment.",
    focus: "Cloud Infrastructure"
  },
  {
    title: "Nixora vs Vercel",
    slug: "/compare/nixora-vs-vercel/",
    description: "Compare Vercel's Git-centric frontend platform with Nixora's control plane built specifically for AI-generated applications.",
    focus: "Developer Platforms"
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nixora.co.in/" },
    { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://nixora.co.in/compare/" }
  ]
};
---

<InnerLayout
  title="Platform Comparisons | Nixora"
  description="Factual architectural comparisons between Nixora's deployment control plane and traditional cloud hosting platforms."
  jsonLd={breadcrumbSchema}
>
  <main class="compare-page">

    <!-- Page Header -->
    <header class="compare-header">
      <div class="compare-eyebrow">Platform Architecture</div>

      <h1 class="section-headline">
        Platform <span class="accent">Comparisons</span>
      </h1>

      <p class="section-para">
        Factual architectural comparisons between Nixora's deployment model for AI software and existing hosting platforms.
      </p>
    </header>

    <!-- Comparisons Grid -->
    <div class="comparisons-grid">
      {comparisons.map((comp) => (
        <article class="compare-card">

          <div class="compare-focus">
            {comp.focus}
          </div>

          <h2>
            <a href={comp.slug}>
              {comp.title}
            </a>
          </h2>

          <p class="compare-description">
            {comp.description}
          </p>

          <div class="compare-link-wrap">
            <a href={comp.slug} class="compare-link">
              View comparison <span aria-hidden="true">→</span>
            </a>
          </div>

        </article>
      ))}
    </div>

  </main>
</InnerLayout>

<style>
  .compare-page {
    width: 100%;
    max-width: 1150px;
    margin: 0 auto;
    padding: 4rem 2rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .compare-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .compare-eyebrow {
    font-size: 0.72rem;
    color: #a78bfa;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    font-family: 'Fira Code', monospace;
  }

  .compare-header .section-headline {
    margin: 0;
  }

  .compare-header .section-para {
    max-width: 640px;
    margin: 0;
  }

  .comparisons-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .compare-card {
    min-width: 0;
    background: #0a0a0a;
    border: 1px solid #1f1f1f;
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.25s ease;
  }

  .compare-card:hover {
    border-color: rgba(167, 139, 250, 0.4);
  }

  .compare-focus {
    width: fit-content;
    font-size: 0.72rem;
    color: #a78bfa;
    font-family: 'Fira Code', monospace;
    letter-spacing: 0.02em;
  }

  .compare-card h2 {
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 700;
    margin: 0;
  }

  .compare-card h2 a {
    color: #fff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .compare-card h2 a:hover {
    color: #a78bfa;
  }

  .compare-description {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #a1a1aa;
    margin: 0;
  }

  .compare-link-wrap {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .compare-link {
    color: #a78bfa;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease;
  }

  .compare-link:hover {
    color: #c4b5fd;
  }

  @media (max-width: 768px) {
    .compare-page {
      padding: 3.5rem 1.5rem 4rem;
      gap: 2.75rem;
    }

    .comparisons-grid {
      grid-template-columns: 1fr;
    }

    .compare-card {
      padding: 1.75rem;
    }
  }

  @media (max-width: 480px) {
    .compare-page {
      padding: 3rem 1rem 3.5rem;
    }

    .compare-card {
      padding: 1.5rem;
    }

    .compare-card h2 {
      font-size: 1.15rem;
    }
  }
</style>
