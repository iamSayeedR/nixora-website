    width: 100%;
    border: 1px solid #1f1f1f;
    border-radius: 12px;
    background: #0a0a0a;
    overflow: hidden;
  }

  .comparison-table {
    width: 100%;
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.15rem 1.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #a1a1aa;
    border-bottom: 1px solid #1f1f1f;
  }

  .comparison-table-header {
    background: #111;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    font-family: 'Fira Code', monospace;
    letter-spacing: 0.02em;
  }

  .comparison-row .feature-name {
    color: #fff;
    font-weight: 500;
  }

  .comparison-row .nixora-heading,
  .comparison-row .nixora-value {
    color: #a78bfa;
  }

  .comparison-row .nixora-code {
    font-family: 'Fira Code', monospace;
  }

  .comparison-row .roadmap-value {
    color: #71717a;
    font-size: 0.8125rem;
  }

  .comparison-last-row {
    border-bottom: none;
  }

  /* Explanatory Content */
  .comparison-explanation {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    color: #a1a1aa;
    font-size: 0.95rem;
    line-height: 1.85;
    border-top: 1px solid #1f1f1f;
    padding-top: 3rem;
  }

  .comparison-explanation h2 {
    font-size: 1.35rem;
    color: #fff;
    font-weight: 700;
    margin: 1.25rem 0 0;
    letter-spacing: -0.02em;
  }

  .comparison-explanation p {
    margin: 0;
  }

  .comparison-explanation ul {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .comparison-explanation li {
    color: #a1a1aa;
    line-height: 1.8;
  }

  .comparison-explanation strong {
    color: #fff;
  }

  .inline-link {
    color: #a78bfa;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .inline-link:hover {
    color: #c4b5fd;
  }

  code {
    font-family: 'Fira Code', monospace;
    font-size: 0.825rem;
    color: #a78bfa;
    background: rgba(167, 139, 250, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid rgba(167, 139, 250, 0.2);
  }

  @media (max-width: 768px) {
    .comparison-page {
      padding: 3.5rem 1.5rem 4rem;
      gap: 2.5rem;
    }

    .comparison-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1.25rem 1rem;
