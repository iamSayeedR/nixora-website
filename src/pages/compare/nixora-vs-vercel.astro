    .comparison-table-header {
      display: none;
    }

    .comparison-row .feature-name {
      font-size: 0.95rem;
      margin-bottom: 0.25rem;
      color: #fff;
      font-weight: 700;
    }

    .comparison-row span[data-label]::before {
