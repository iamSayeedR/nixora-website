    max-width: 1000px;
    margin: 0 auto;
    padding: 4rem 2rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .comparison-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .comparison-eyebrow {
    font-size: 0.72rem;
    color: #a78bfa;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    font-family: 'Fira Code', monospace;
  }

  .comparison-header .section-headline {
    max-width: 850px;
    margin: 0;
    color: #fff;
  }

  .comparison-intro {
    max-width: 680px;
    font-size: 1.0625rem;
    color: #a1a1aa;
    line-height: 1.7;
    margin: 0;
  }

  /* Comparison Table */
