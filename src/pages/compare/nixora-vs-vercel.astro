---
import InnerLayout from '../../layouts/InnerLayout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nixora.co.in" },
    { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://nixora.co.in/compare" },
    { "@type": "ListItem", "position": 3, "name": "Nixora vs Vercel", "item": "https://nixora.co.in/compare/nixora-vs-vercel" }
  ]
};
---

<InnerLayout title="Nixora vs Vercel | Developer Platform Comparison" description="Factual comparison between Vercel's Git-first web platform and Nixora's CLI-first deployment control plane for AI-generated applications." jsonLd={breadcrumbSchema}>

  <article style="padding:4rem 2rem 5rem;max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:3rem;">
    
    <!-- Header -->
    <div style="display:flex;flex-direction:column;gap:1rem;">
      <div style="font-size:0.72rem;color:#a78bfa;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;font-family:'Fira Code',monospace;">Platform Comparison</div>
      <h1 class="section-headline">Nixora vs <span class="accent">Vercel</span></h1>
      <p style="font-size:1.0625rem;color:#a1a1aa;line-height:1.7;margin:0;">
        Comparing Vercel's Git-centric web hosting platform with Nixora's CLI-first control plane for AI-generated software.
      </p>
    </div>

    <!-- Factual Comparison Table -->
    <div style="border:1px solid #1f1f1f;border-radius:12px;overflow:hidden;background:#0a0a0a;">
      <div style="display:grid;grid-template-columns:1.5fr 1fr 1fr;background:#111;padding:1rem 1.5rem;font-size:0.8rem;font-weight:700;color:#fff;border-bottom:1px solid #1f1f1f;font-family:'Fira Code',monospace;">
        <span>FEATURE / CAPABILITY</span>
        <span>VERCEL</span>
        <span style="color:#a78bfa;">NIXORA (LIVE TODAY)</span>
      </div>

      <div style="display:grid;grid-template-columns:1.5fr 1fr 1fr;padding:1rem 1.5rem;font-size:0.875rem;color:#a1a1aa;border-bottom:1px solid #1f1f1f;">
        <span style="color:#fff;font-weight:500;">Core Paradigm</span>
        <span>Git repository push & CI/CD</span>
        <span style="color:#a78bfa;font-family:'Fira Code',monospace;">Direct CLI deploy (nixora deploy)</span>
      </div>

      <div style="display:grid;grid-template-columns:1.5fr 1fr 1fr;padding:1rem 1.5rem;font-size:0.875rem;color:#a1a1aa;border-bottom:1px solid #1f1f1f;">
        <span style="color:#fff;font-weight:500;">Primary Target</span>
        <span>Frontend & Next.js web applications</span>
        <span style="color:#a78bfa;">AI-generated software & prototypes</span>
      </div>

      <div style="display:grid;grid-template-columns:1.5fr 1fr 1fr;padding:1rem 1.5rem;font-size:0.875rem;color:#a1a1aa;border-bottom:1px solid #1f1f1f;">
        <span style="color:#fff;font-weight:500;">Web Dashboard</span>
        <span>Comprehensive dashboard UI</span>
        <span style="color:#71717a;">Roadmap (CLI-based today)</span>
      </div>

      <div style="display:grid;grid-template-columns:1.5fr 1fr 1fr;padding:1rem 1.5rem;font-size:0.875rem;color:#a1a1aa;">
        <span style="color:#fff;font-weight:500;">HTTPS & SSL</span>
        <span>Automatic SSL</span>
        <span style="color:#a78bfa;">Issued by default</span>
      </div>
    </div>

    <!-- Explanatory Prose -->
    <div style="display:flex;flex-direction:column;gap:1.5rem;color:#a1a1aa;font-size:0.95rem;line-height:1.8;">
      <h2 style="font-size:1.3rem;color:#fff;font-weight:700;margin:0;">Core Differences</h2>
      <p style="margin:0;">
        Vercel is an established, feature-rich web deployment platform built primarily around Git repository workflows and Next.js/frontend frameworks.
      </p>
      <p style="margin:0;">
        Nixora focuses specifically on the developer experience of shipping code created by AI agents. Nixora provides a lightweight CLI workflow so developers can containerize and deploy generated applications instantly straight from their terminal environment.
      </p>
    </div>

  </article>

</InnerLayout>
