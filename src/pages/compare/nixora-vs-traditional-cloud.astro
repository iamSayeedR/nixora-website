    border-bottom: none;
  }

  /* Explanatory Content */
  .comparison-explanation {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    color: #a1a1aa;
    font-size: 0.95rem;
    line-height: 1.85;
    border-top: 1px solid #1f1f1f;
    padding-top: 3rem;
  }

