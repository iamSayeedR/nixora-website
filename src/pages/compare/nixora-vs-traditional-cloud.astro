    max-width: 680px;
    font-size: 1.0625rem;
    color: #a1a1aa;
    line-height: 1.7;
    margin: 0;
  }

  /* Comparison Table */
  .comparison-table-wrapper {
    width: 100%;
    border: 1px solid #1f1f1f;
    border-radius: 12px;
    background: #0a0a0a;
    overflow: hidden;
  }

  .comparison-table {
    width: 100%;
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.15rem 1.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #a1a1aa;
    border-bottom: 1px solid #1f1f1f;
  }

  .comparison-table-header {
    background: #111;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    font-family: 'Fira Code', monospace;
    letter-spacing: 0.02em;
  }

  .comparison-row .feature-name {
    color: #fff;
    font-weight: 500;
  }

  .comparison-row .nixora-heading,
  .comparison-row .nixora-value {
    color: #a78bfa;
  }

  .comparison-row .nixora-code {
    font-family: 'Fira Code', monospace;
  }

