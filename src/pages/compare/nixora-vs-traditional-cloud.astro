    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .comparison-eyebrow {
    font-size: 0.72rem;
    color: #a78bfa;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
