---
import InnerLayout from '../layouts/InnerLayout.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Architecture from '../components/Architecture.astro';
import DeployIntro from '../components/DeployIntro.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nixora.co.in" },
    { "@type": "ListItem", "position": 2, "name": "Product", "item": "https://nixora.co.in/product" }
  ]
};
---
<InnerLayout title="Nixora Product Architecture & Capabilities | Control Plane for AI Software & Agents" description="Nixora's product architecture: deployment and diagnosis live today, agent-native MCP access next, and a roadmap toward monitoring, scaling, governance, and multi-agent systems." jsonLd={breadcrumbSchema}>

  <!-- Page hero -->
  <div style="padding:4rem 2rem 2rem;max-width:900px;margin:0 auto;">
    <div style="font-size:0.72rem;color:#a78bfa;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin-bottom:0.75rem;font-family:'Fira Code',monospace;">Product Architecture</div>
    <h1 class="section-headline" style="max-width:640px;">One control plane. <span class="accent">Every AI app and agent you build.</span></h1>
    <p style="font-size:1.0625rem;line-height:1.75;color:#a1a1aa;max-width:620px;display:block;margin:1.25rem 0 0;">
      Deployment and diagnosis are live today. Next: MCP access for AI agents, multi-agent access with per-agent permissions, and a web dashboard. Later: monitoring, autonomous scaling, governance, and multi-agent system deployment.
    </p>

    <div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:1.5rem;font-size:0.875rem;">
      <a href="/resources" style="color:#a78bfa;text-decoration:none;font-weight:500;">View Technical Guides & Resources →</a>
      <a href="/compare" style="color:#a78bfa;text-decoration:none;font-weight:500;">Compare Nixora Architecture →</a>
    </div>
  </div>

  <Features />
  <DeployIntro />
  <HowItWorks />
  <Architecture />

</InnerLayout>
