 .article-paragraph {
  color: rgb(255 255 255 / 65%);
  font-size: 15px;
  line-height: 1.9;
}

  .article-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
    scroll-margin-top: 112px;
  }

