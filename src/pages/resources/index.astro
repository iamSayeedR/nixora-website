
---
import InnerLayout from '../../layouts/InnerLayout.astro';
import ResourcesList from '../../components/ResourcesList.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://nixora.co.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Resources",
      "item": "https://nixora.co.in/resources/"
    }
  ]
};
---

<InnerLayout
  title="Developer Resources & Technical Guides | Nixora"
  description="Technical guides, cloud deployment architecture, and CLI deployment tutorials for developers building with AI coding agents."
  jsonLd={breadcrumbSchema}
>
  <main class="resources-page">
    <header class="resources-header">
      <span class="resources-eyebrow">
        ENGINEERING & ARCHITECTURE
      </span>

      <h1 class="section-headline">
        Nixora <span class="accent">Resources</span>
      </h1>

      <p class="section-para">
        Technical guides, developer infrastructure concepts, and tutorials
        on automating deployment for AI-generated applications and AI agents.
      </p>
    </header>

    <ResourcesList />
  </main>
</InnerLayout>

<style>
 
.resources-page {
  width: 100%;
  max-width: 1350px;
  margin: 0 auto;
  padding: 4rem 2rem 5rem;
  display: flex;
  flex-direction: column;
  gap: 3rem;
}

.resources-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1rem;
}

.resources-eyebrow {
  color: #a78bfa;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  font-family: 'Fira Code', monospace;
  text-transform: uppercase;
}

.resources-header .section-para {
  max-width: 640px;
  margin: 0;
}

/* Tablet */
@media (max-width: 1024px) {
  .resources-page {
    padding: 3.5rem 1.75rem 4.5rem;
    gap: 2.75rem;
  }
}

/* Mobile */
@media (max-width: 640px) {
   .resources-page {
    padding: 3rem 0 4rem;
    gap: 2.5rem;
  }


  .resources-header {
    gap: 0.85rem;
  }

  .resources-eyebrow {
    font-size: 0.65rem;
  }

  .resources-header .section-para {
    max-width: 100%;
  }
}

/* Small mobile */
@media (max-width: 380px) {
  .resources-page {
    padding: 2.5rem 1rem 3.5rem;
  }
}

</style>
