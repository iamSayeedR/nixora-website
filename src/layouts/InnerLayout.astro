---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}
const { title, description, image, canonicalURL, jsonLd } = Astro.props;
---
<Layout title={title} description={description} image={image} canonicalURL={canonicalURL} jsonLd={jsonLd}>
  <Header />
  <main style="min-height:80vh;">
    <slot />
  </main>
  <Footer />
</Layout>
