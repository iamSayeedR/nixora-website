---
import '../styles/global.css';
import CursorGlow from '../components/CursorGlow.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  googleVerification?: string;
}

const {
  title,
  description = "Nixora is being built as the control plane for AI-generated software and AI agents: understand, deploy, operate, and evolve the infrastructure around them.",
  image = "/logo-full.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://nixora.co.in").href,
  jsonLd,
  googleVerification
} = Astro.props;

const siteUrl = "https://nixora.co.in/";
const imageUrl = new URL(image, siteUrl).href;
const logoUrl = new URL("/logo-full.jpg", siteUrl).href;

// Enhanced Nixora Entity Schema (@graph) per claude-seo E-E-A-T & Schema guidelines
const nixoraSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://nixora.co.in/#organization",
      "name": "Nixora",
      "alternateName": "Nixora: control plane for AI-generated software and AI agents",
      "url": siteUrl,
      "logo": logoUrl,
      "email": "ceo@nixora.co.in",
      "foundingDate": "2026-07-01",
      "description": "Nixora is the control plane for AI-generated software and AI agents.",
      "founder": {
        "@type": "Person",
        "name": "Sayeed Rizwan",
        "jobTitle": "Founder",
        "sameAs": "https://www.linkedin.com/in/sayeedrizwan/"
      },
      "knowsAbout": [
        "AI-generated software",
        "AI coding agents",
        "Cloud deployment",
        "Developer infrastructure",
        "Model Context Protocol"
      ],
      "sameAs": [
        "https://github.com/nixora-hq",
        "https://www.linkedin.com/company/nixora-hq/",
        "https://www.producthunt.com/products/nixora",
        "https://x.com/wearenixora"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://nixora.co.in/#software",
      "name": "Nixora",
      "alternateName": [
        "Nixora: control plane for AI-generated software and AI agents",
        "Nixora CLI"
      ],
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux, macOS, Windows",
      "softwareVersion": "0.1.0",
      "description": "Nixora is the control plane for AI-generated software. Deploy an app built by any AI coding agent (Claude Code, Cursor, Codex, Gemini CLI) with a single command, featuring automated containerization, HTTPS, and deployment diagnostics.",
      "featureList": [
        "CLI deployment",
        "Automated containerization",
        "HTTPS TLS certificate issuance",
        "Deployment diagnostics",
        "Persistent cloud hosting"
      ],
      "url": siteUrl,
      "downloadUrl": "https://nixora.co.in/#early-access",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "publisher": { "@id": "https://nixora.co.in/#organization" }
    },
    {
      "@type": "WebSite",
      "@id": "https://nixora.co.in/#website",
      "url": siteUrl,
      "name": "Nixora",
      "inLanguage": "en-US",
      "publisher": { "@id": "https://nixora.co.in/#organization" }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo-mark.svg" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" type="text/markdown" title="LLM Context Summary" href="/llms.txt" />
  <link rel="alternate" type="text/markdown" title="LLM Full Documentation" href="/llms-full.txt" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Nixora, control plane for AI software, AI agent deployment, Claude Code deploy, Cursor app hosting, zero config CLI deployment, developer infrastructure" />
  <meta name="theme-color" content="#111" />
  {googleVerification && <meta name="google-site-verification" content={googleVerification} />}

  <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Nixora" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@wearenixora" />
  <meta name="twitter:creator" content="@wearenixora" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Core Entity Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(nixoraSchema)} />
  
  <!-- Page Specific JSON-LD -->
  {jsonLd && (
    Array.isArray(jsonLd) ? (
      jsonLd.map(schema => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )
  )}
</head>
<body>
  <CursorGlow />
  <slot />
</body>
</html>
