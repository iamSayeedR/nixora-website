---
import '../styles/global.css';
import CursorGlow from '../components/CursorGlow.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  googleVerification?: string;
}

const {
  title,
  description = "The control plane for AI-generated software. Nixora deploys, hosts, and manages your AI-built app's entire lifecycle, including updates, monitoring, security, and scaling, automatically.",
  image = "/logo-full.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://nixora.co.in").href,
  jsonLd,
  googleVerification
} = Astro.props;

const siteUrl = "https://nixora.co.in/";
const imageUrl = new URL(image, siteUrl).href;
const logoUrl = new URL("/logo-full.jpg", siteUrl).href;

// Unified Nixora Entity Schema (@graph)
const nixoraSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://nixora.co.in/#organization",
      "name": "Nixora",
      "alternateName": "Nixora: control plane for AI-generated software",
      "url": siteUrl,
      "logo": logoUrl,
      "sameAs": [
        "https://github.com/nixora-hq",
        "https://www.linkedin.com/company/nixora-hq/",
        "https://www.producthunt.com/products/nixora",
        "https://x.com/wearenixora"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://nixora.co.in/#software",
      "name": "Nixora",
      "alternateName": "Nixora: control plane for AI-generated software",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux, macOS, Windows",
      "description": "Nixora is the control plane for AI-generated software. Deploy an app built by any AI coding agent (Claude Code, Cursor, Codex, Gemini CLI) with a single command, and Nixora automatically provisions hosting, authentication, and HTTPS, returning a live, shareable URL.",
      "url": siteUrl,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "publisher": { "@id": "https://nixora.co.in/#organization" }
    },
    {
      "@type": "WebSite",
      "@id": "https://nixora.co.in/#website",
      "url": siteUrl,
      "name": "Nixora",
      "publisher": { "@id": "https://nixora.co.in/#organization" }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
  <link rel="alternate icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo-mark.svg" />
  <link rel="canonical" href={canonicalURL} />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#111" />
  {googleVerification && <meta name="google-site-verification" content={googleVerification} />}

  <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1024" />
  <meta property="og:image:height" content="335" />
  <meta property="og:site_name" content="Nixora" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@wearenixora" />
  <meta name="twitter:creator" content="@wearenixora" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Core Entity Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(nixoraSchema)} />
  
  <!-- Page Specific JSON-LD -->
  {jsonLd && (
    Array.isArray(jsonLd) ? (
      jsonLd.map(schema => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )
  )}
</head>
<body>
  <CursorGlow />
  <slot />
</body>
</html>
